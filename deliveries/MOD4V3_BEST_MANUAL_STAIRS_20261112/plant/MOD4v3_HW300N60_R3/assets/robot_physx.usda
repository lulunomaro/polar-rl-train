#usda 1.0
(
    defaultPrim = "Robot"
    metersPerUnit = 1
    subLayers = [
        @robot.usd@
    ]
    upAxis = "Z"
)

over "Robot" (
    customData = {
        dictionary mod4v3 = {
            bool PhysXFiniteAngleEncoding = 1
            bool PhysXNativeDynamicsVerified = 0
        }
    }
)
{
    over "joints"
    {
        over "left_front1_joint"
        {
            float physics:lowerLimit = -1e20
            float physics:upperLimit = 1e20
        }

