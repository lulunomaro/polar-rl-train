+# --------------------------------------------------------------------------------------
+# 2026-09-28 SCUT parity (reason + evidence: docs/MOD4_REWARD_FIX_SCUT_PARITY_20260928.md)
+# --------------------------------------------------------------------------------------
+def _mod4_stand_mask(env, command_name: str = "twist"):
+    """True for envs whose velocity command is zero (explicit standing env or |cmd| ~ 0).
+
+    Same rule as SCUT's `skills_isaac._stand_mask`: the command term's `is_standing_env` flag
+    (Isaac Lab sets it for `rel_standing_envs`) plus a numerical near-zero test.
+    """
+    try:
+        term = env.command_manager.get_term(command_name)
+    except Exception:
+        return torch.zeros(env.num_envs, dtype=torch.bool, device=env.device)
+    norm = torch.linalg.vector_norm(term.command, dim=1)
+    flag = getattr(term, "is_standing_env", None)
+    if flag is not None:
+        return flag.bool() | (norm < 1.0e-6)
+    return norm < 1.0e-6
+
+
+def run_velocity_error_l2(env, command_name: str = "twist"):
+    """Dense planar velocity error (m/s)^2 on MOVING flat-run samples only.
+
+    Ported from the SCUT MOD4 port (`skills_isaac.run_velocity_error_l2`).  Their docstring
+    records the mirror image of our failure: "the exponential tracking reward has almost no
+    gradient after a warm-start policy gets far outside its kernel", which let their flat
+    policy sprint at 2.1 m/s against a 0.3-1.2 m/s command.  In our run the same missing
+    gradient let the policy stop moving altogether (probe 2026-09-28: commands 0.30 / 0.60 /
+    1.00 m/s -> actual -0.002 / -0.002 / +0.002 m/s while collecting 1.38 of the 2.0
+    tracking reward).  Weight -1.0 in SCUT's flat walk launcher.
+    """
+    mode = getattr(env, "_mod4_mode_bit", None)
+    if mode is None:
+        if os.environ.get("RM_MOD4_TERRAIN", "flat").strip().lower() != "flat":
+            return torch.zeros(env.num_envs, device=env.device)
+        moving = ~_mod4_stand_mask(env, command_name)
+    else:
+        moving = (mode == 0) & (~_mod4_stand_mask(env, command_name))
+    command = env.command_manager.get_term(command_name).command
+    error = env.scene["robot"].data.root_lin_vel_b[:, :2] - command[:, :2]
+    return moving.float() * error.square().sum(dim=1)
