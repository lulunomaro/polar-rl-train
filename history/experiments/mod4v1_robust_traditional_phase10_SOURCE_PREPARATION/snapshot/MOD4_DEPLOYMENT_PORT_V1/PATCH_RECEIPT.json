      "reverse_operations_restore_original_raw_bytes": true,
      "operations": [
        {
          "old": "#include \"chassis_balance.h\"",
          "new": "#include \"chassis_balance.h\"\r\n#include \"mod4_port_bridge.h\""
        },
        {
          "old": "void ChassisConsole(void)\r\n{\r\n",
          "new": "void ChassisConsole(void)\r\n{\r\n    mdp1_mode port_mode = MDP1_UNSUPPORTED;\r\n    switch (CHASSIS.mode) {\r\n        case CHASSIS_STAND_UP: port_mode = MDP1_STANDUP; break;\r\n        case CHASSIS_FOLLOW_GIMBAL_YAW:\r\n        case CHASSIS_FREE:\r\n        case CHASSIS_SPIN: port_mode = MDP1_NORMAL; break;\r\n        case CHASSIS_OFF:\r\n        case CHASSIS_SAFE: port_mode = MDP1_STOP_MODE; break;\r\n        default: break;\r\n    }\r\n    if (!mdp1_bridge_begin(port_mode)) return;\r\n"
        },
        {
          "old": "    double joint_pos_l[2], joint_pos_r[2];\r\n    // LegController(joint_pos_l, joint_pos_r);\r\n\r\n    // 当解算出的角度正常时，设置目标角度\r\n    if (!(isnan(joint_pos_l[0]) || isnan(joint_pos_l[1]) || isnan(joint_pos_r[0]) ||\r\n          isnan(joint_pos_r[1]))) {\r\n        CHASSIS.joint_motor[0].set.pos =\r\n            theta_transform(joint_pos_l[1], -J0_ANGLE_OFFSET, J0_DIRECTION, 1);\r\n        CHASSIS.joint_motor[1].set.pos =\r\n            theta_transform(joint_pos_l[0], -J1_ANGLE_OFFSET, J1_DIRECTION, 1);\r\n        CHASSIS.joint_motor[2].set.pos =\r\n            theta_transform(joint_pos_r[1], -J2_ANGLE_OFFSET, J2_DIRECTION, 1);\r\n        CHASSIS.joint_motor[3].set.pos =\r\n            theta_transform(joint_pos_r[0], -J3_ANGLE_OFFSET, J3_DIRECTION, 1);\r\n    }\r\n",
          "new": "    float port_qref[4];\r\n    if (!mdp1_bridge_copy_standup_qref(port_qref)) return;\r\n    /* Raw motor-coordinate ref; no implicit zero pose or model->motor guess. */\r\n    if (port_qref[0] < MIN_J0_ANGLE || port_qref[0] > MAX_J0_ANGLE ||\r\n        port_qref[1] < MIN_J1_ANGLE || port_qref[1] > MAX_J1_ANGLE ||\r\n        port_qref[2] < MIN_J2_ANGLE || port_qref[2] > MAX_J2_ANGLE ||\r\n        port_qref[3] < MIN_J3_ANGLE || port_qref[3] > MAX_J3_ANGLE) {\r\n        (void)mdp1_bridge_stop(MDP1_DISABLE);\r\n        return;\r\n    }\r\n    CHASSIS.joint_motor[0].set.pos = port_qref[0];\r\n    CHASSIS.joint_motor[1].set.pos = port_qref[1];\r\n    CHASSIS.joint_motor[2].set.pos = port_qref[2];\r\n    CHASSIS.joint_motor[3].set.pos = port_qref[3];\r\n"
        },
        {
          "old": "void ChassisSendCmd(void)\r\n{\r\n",
          "new": "void ChassisSendCmd(void)\r\n{\r\n    /* No provider/arm = no legacy motor emission. This is not a HW stop proof. */\r\n    if (!mdp1_bridge_emit_legacy()) return;\r\n"
        },
        {
          "old": "    uint8_t cnt;",
          "new": "    static uint8_t cnt = 0; /* Persistent, defined pacing state. */"
        },
        {
          "old": "if (CHASSIS.joint_motor[i].fdb.state == DM_STATE_DISABLE) {",
          "new": "if (CHASSIS.joint_motor[i].fdb.state == DM_STATE_DISABLE &&\r\n                mdp1_bridge_legacy_enable_allowed(i)) {"
        }
      ]
    },
