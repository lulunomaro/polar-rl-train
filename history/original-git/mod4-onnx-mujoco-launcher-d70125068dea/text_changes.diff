diff --git a/policy_runtime.py b/policy_runtime.py
new file mode 100644
index 0000000..cb9d9a3
--- /dev/null
+++ b/policy_runtime.py
@@ -0,0 +1,24 @@
+"""Small ONNX runtime wrapper shared by the viewer and robustness runner."""
+from __future__ import annotations
+
+from pathlib import Path
+
+import numpy as np
+import onnxruntime as ort
+
+
+class OnnxPolicy:
+    def __init__(self, path: str | Path):
+        self.path = Path(path).resolve()
+        self.session = ort.InferenceSession(str(self.path), providers=["CPUExecutionProvider"])
+        inp = self.session.get_inputs()[0]
+        out = self.session.get_outputs()[0]
+        if inp.name != "observation" or out.name != "action":
+            raise ValueError(f"unexpected ONNX names: {inp.name!r}, {out.name!r}")
+        if inp.shape[-1] != 35 or out.shape[-1] != 6:
+            raise ValueError(f"unexpected ONNX shapes: {inp.shape}, {out.shape}")
+
+    def __call__(self, observation: np.ndarray) -> np.ndarray:
+        x = np.asarray(observation, dtype=np.float32).reshape(-1, 35)
+        y = self.session.run(["action"], {"observation": x})[0]
+        return np.asarray(y[0], dtype=np.float64)
