+
+$Help = New-Object Windows.Forms.Label
+$Help.Text = "操控：W/S 前后，A/D 转向，X 停车，Q/E 高度，F 循环场地，V 循环模式，Y 辅助，C 对比策略。"
+$Help.Location = New-Object Drawing.Point(20, 520)
+$Help.Size = New-Object Drawing.Size(845, 45)
+$Help.Anchor = "Bottom,Left,Right"
+$Form.Controls.Add($Help)
+
+function Refresh-Policies([string]$SelectPath = "") {
+  $PolicyBox.Items.Clear()
+  $script:PolicyMap = @{}
+  $files = Get-ChildItem -LiteralPath (Join-Path $Root "policies") -Filter "*.onnx" -File -Recurse | Sort-Object LastWriteTime -Descending
+  foreach ($file in $files) {
+    $relative = $file.FullName.Substring($Root.Length + 1)
+    $script:PolicyMap[$relative] = $file.FullName
+    [void]$PolicyBox.Items.Add($relative)
+  }
+  if ($PolicyBox.Items.Count -eq 0) { return }
+  $chosen = -1
+  if ($SelectPath) {
+    for ($i = 0; $i -lt $PolicyBox.Items.Count; $i++) {
+      if ([IO.Path]::GetFullPath($script:PolicyMap[$PolicyBox.Items[$i]]) -eq [IO.Path]::GetFullPath($SelectPath)) { $chosen = $i; break }
+    }
+  }
+  if ($chosen -lt 0) {
+    $preferred = "policies\mod4_general_16295.onnx"
+    $chosen = $PolicyBox.Items.IndexOf($preferred)
+  }
+  if ($chosen -lt 0) { $chosen = 0 }
+  $PolicyBox.SelectedIndex = $chosen
+}
+
+function Get-SelectedPolicy {
+  if ($PolicyBox.SelectedIndex -lt 0) { throw "请先导入或选择一个 ONNX。" }
+  return $script:PolicyMap[[string]$PolicyBox.SelectedItem]
+}
+
+function Inspect-Selected {
+  try {
+    $policy = Get-SelectedPolicy
+    $report = Invoke-Backend @("inspect", "--policy", $policy, "--model", $Model)
+    $meta = $report.policy.metadata
+    $source = if ($meta.source_checkpoint) { $meta.source_checkpoint } else { "旁置 JSON 未提供" }
+    $iteration = if ($null -ne $meta.source_iteration) { $meta.source_iteration } else { "旁置 JSON 未提供" }
+    $Details.Text = "PASS：策略接口和 MuJoCo 机构契约均通过`r`n" +
+      "ONNX: $($report.policy.path)`r`n" +
+      "SHA256: $($report.policy.sha256)`r`n" +
+      "接口: observation [batch,35] -> action [batch,6]`r`n" +
+      "零观测动作: $($report.policy.zero_action -join ', ')`r`n" +
+      "源检查点: $source`r`n训练迭代: $iteration`r`n" +
+      "MJCF: nq=$($report.model.nq) nv=$($report.model.nv) nu=$($report.model.nu) bodies=$($report.model.bodies) geoms=$($report.model.geoms) equalities=$($report.model.equalities)`r`n`r`n" +
+      "说明：PASS 只证明 ONNX 接口和机构能够运行。训练是否成熟，请在各场地查看直立、闭链误差、峰值力矩和是否通过。"
+    $Status.Text = "可以启动；策略能力仍需在场地中实测"
+    $Status.ForeColor = [Drawing.Color]::DarkGreen
+    return $true
+  } catch {
+    $Details.Text = "FAIL：$($_.Exception.Message)"
+    $Status.Text = "校验失败，未启动"
+    $Status.ForeColor = [Drawing.Color]::DarkRed
+    [Windows.Forms.MessageBox]::Show($_.Exception.Message, "检查失败", "OK", "Error") | Out-Null
+    return $false
+  }
+}
+
+function Import-Onnx([string]$Source) {
+  try {
+    $report = Invoke-Backend @("import", "--source", $Source)
+    Refresh-Policies $report.destination
+    [void](Inspect-Selected)
+    $Status.Text = "已导入：$($report.destination)"
+  } catch {
+    [Windows.Forms.MessageBox]::Show($_.Exception.Message, "导入失败", "OK", "Error") | Out-Null
+  }
+}
+
+$RefreshButton.Add_Click({ Refresh-Policies; [void](Inspect-Selected) })
+$PolicyBox.Add_SelectedIndexChanged({ if ($PolicyBox.SelectedIndex -ge 0) { [void](Inspect-Selected) } })
+$CheckButton.Add_Click({ [void](Inspect-Selected) })
+$ImportButton.Add_Click({
+  $dialog = New-Object Windows.Forms.OpenFileDialog
+  $dialog.Title = "选择训练导出的 ONNX"
+  $dialog.Filter = "ONNX policy (*.onnx)|*.onnx"
+  if ($dialog.ShowDialog() -eq "OK") { Import-Onnx $dialog.FileName }
+})
+$FolderButton.Add_Click({ New-Item -ItemType Directory -Force -Path $Imported | Out-Null; Start-Process explorer.exe -ArgumentList $Imported })
+
+$StartButton.Add_Click({
+  if (-not (Inspect-Selected)) { return }
+  if ($script:Simulation -and -not $script:Simulation.HasExited) {
+    [Windows.Forms.MessageBox]::Show("MuJoCo 已经在运行。", "提示", "OK", "Information") | Out-Null
+    return
+  }
+  $policy = Get-SelectedPolicy
+  $spawn = $SpawnCodes[[string]$SpawnBox.SelectedItem]
+  $yaw = if ($AssistBox.Checked) { "80" } else { "0" }
+  $psi = New-Object Diagnostics.ProcessStartInfo
+  $psi.FileName = $Python
+  $psi.WorkingDirectory = $Root
+  $psi.UseShellExecute = $true
+  $psi.Arguments = '"' + $Driver + '" --policy "' + $policy + '" --model "' + $Model + '" --spawn ' + $spawn + ' --yaw-assist ' + $yaw
+  try {
+    $script:Simulation = [Diagnostics.Process]::Start($psi)
+    $StartButton.Enabled = $false
+    $StopButton.Enabled = $true
+    $Status.Text = "MuJoCo 运行中：$([IO.Path]::GetFileName($policy))"
+    $Status.ForeColor = [Drawing.Color]::DarkBlue
+  } catch {
+    [Windows.Forms.MessageBox]::Show($_.Exception.Message, "启动失败", "OK", "Error") | Out-Null
+  }
+})
+
+$StopButton.Add_Click({
+  if ($script:Simulation -and -not $script:Simulation.HasExited) { $script:Simulation.Kill() }
+  $StartButton.Enabled = $true
+  $StopButton.Enabled = $false
+  $Status.Text = "仿真已停止"
+})
+
+$Timer = New-Object Windows.Forms.Timer
+$Timer.Interval = 500
+$Timer.Add_Tick({
+  if ($script:Simulation -and $script:Simulation.HasExited) {
+    $code = $script:Simulation.ExitCode
+    $script:Simulation = $null
+    $StartButton.Enabled = $true
+    $StopButton.Enabled = $false
+    $Status.Text = if ($code -eq 0) { "仿真已关闭" } else { "仿真异常退出，代码 $code" }
+  }
+})
+$Timer.Start()
+
+Refresh-Policies
+if ($PolicyBox.Items.Count -gt 0) {
+  [void](Inspect-Selected)
+} else {
+  $Status.Text = "请先导入授权的 MOD4 ONNX，并放入对应的 MJCF/mesh 资产"
+  $Details.Text = "源码仓库不包含机器人模型和训练策略。将完整交付资产放入 model/ 与 policies/ 后即可检查和启动。"
+}
+if ($IncomingOnnx -and (Test-Path -LiteralPath $IncomingOnnx)) { Import-Onnx $IncomingOnnx }
+[void]$Form.ShowDialog()
diff --git a/launcher.py b/launcher.py
new file mode 100644
index 0000000..6ba8a76
--- /dev/null
+++ b/launcher.py
@@ -0,0 +1,132 @@
+"""Backend used by the native Windows ONNX/MuJoCo launcher."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import shutil
+
+import mujoco
+import numpy as np
+import onnxruntime as ort
+
+
+ROOT = Path(__file__).resolve().parent
+POLICY_DIR = ROOT / "policies"
+IMPORTED_DIR = POLICY_DIR / "imported"
+DEFAULT_MODEL = ROOT / "model" / "rm_training_arena.xml"
+EXPECTED_INPUT = 35
+EXPECTED_OUTPUT = 6
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def adjacent_metadata(path: Path) -> Path | None:
+    candidates = [path.with_suffix(".json"), path.with_name(path.stem + "_metadata.json")]
+    return next((item for item in candidates if item.is_file()), None)
+
+
+def validate_policy(path: Path) -> dict:
+    path = path.expanduser().resolve()
+    if not path.is_file() or path.suffix.lower() != ".onnx":
+        raise ValueError("请选择有效的 .onnx 文件")
+    session = ort.InferenceSession(str(path), providers=["CPUExecutionProvider"])
+    if len(session.get_inputs()) != 1 or len(session.get_outputs()) != 1:
+        raise ValueError("策略必须恰好有一个输入和一个输出")
+    inp, out = session.get_inputs()[0], session.get_outputs()[0]
+    if inp.name != "observation" or out.name != "action":
+        raise ValueError(f"节点名不匹配：输入 {inp.name!r}，输出 {out.name!r}；要求 observation/action")
+    if inp.shape[-1] != EXPECTED_INPUT or out.shape[-1] != EXPECTED_OUTPUT:
+        raise ValueError(f"维度不匹配：{inp.shape} -> {out.shape}；要求 [batch,35] -> [batch,6]")
+    output = session.run([out.name], {inp.name: np.zeros((1, EXPECTED_INPUT), np.float32)})[0]
+    if output.shape != (1, EXPECTED_OUTPUT) or not np.isfinite(output).all():
+        raise ValueError(f"零观测推理输出异常：shape={output.shape}, finite={np.isfinite(output).all()}")
+    actual_hash = sha256(path)
+    metadata_path = adjacent_metadata(path)
+    metadata = {}
+    if metadata_path:
+        metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
+        declared_input = metadata.get("input", {}).get("shape", [None, None])[-1]
+        declared_output = metadata.get("output", {}).get("shape", [None, None])[-1]
+        if declared_input not in (None, EXPECTED_INPUT) or declared_output not in (None, EXPECTED_OUTPUT):
+            raise ValueError("旁置 JSON 声明的输入/输出维度与 ONNX 不一致")
+        declared_hash = metadata.get("onnx_sha256")
+        if declared_hash and declared_hash.lower() != actual_hash:
+            raise ValueError("旁置 JSON 的 onnx_sha256 与文件内容不一致")
+    return {
+        "path": str(path), "sha256": actual_hash,
+        "input": {"name": inp.name, "shape": inp.shape},
+        "output": {"name": out.name, "shape": out.shape},
+        "zero_action": np.asarray(output[0], dtype=float).round(5).tolist(),
+        "metadata_path": str(metadata_path.resolve()) if metadata_path else None,
+        "metadata": metadata,
+    }
+
+
+def validate_model(path: Path = DEFAULT_MODEL) -> dict:
+    path = path.expanduser().resolve()
+    if not path.is_file():
+        raise ValueError(f"找不到 MJCF：{path}")
+    model = mujoco.MjModel.from_xml_path(str(path))
+    if model.nu != 6:
+        raise ValueError(f"MJCF 执行器数量为 {model.nu}，训练契约要求 6")
+    if model.neq < 10:
+        raise ValueError(f"MJCF 等式约束只有 {model.neq}，闭链/耦合约束不完整")
+    return {"path": str(path), "nq": model.nq, "nv": model.nv, "nu": model.nu,
+            "bodies": model.nbody, "geoms": model.ngeom, "equalities": model.neq}
+
+
+def import_policy(source: Path) -> dict:
+    source = source.expanduser().resolve()
+    report = validate_policy(source)
+    IMPORTED_DIR.mkdir(parents=True, exist_ok=True)
+    try:
+        already_local = source.is_relative_to(POLICY_DIR.resolve())
+    except AttributeError:
+        already_local = str(source).lower().startswith(str(POLICY_DIR.resolve()).lower())
+    if already_local:
+        destination = source
+    else:
+        destination = IMPORTED_DIR / source.name
+        if destination.exists() and sha256(destination) != report["sha256"]:
+            destination = IMPORTED_DIR / f"{source.stem}_{report['sha256'][:8]}.onnx"
+        if not destination.exists():
+            shutil.copy2(source, destination)
+        metadata = adjacent_metadata(source)
+        if metadata:
+            shutil.copy2(metadata, destination.with_suffix(".json"))
+    return {"destination": str(destination.resolve()), "validation": validate_policy(destination)}
+
+
+def emit(payload: dict, code: int = 0):
+    print(json.dumps(payload, ensure_ascii=False, indent=2))
+    raise SystemExit(code)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    sub = parser.add_subparsers(dest="command", required=True)
+    inspect_parser = sub.add_parser("inspect", help="validate one ONNX and the MJCF contract")
+    inspect_parser.add_argument("--policy", type=Path, required=True)
+    inspect_parser.add_argument("--model", type=Path, default=DEFAULT_MODEL)
+    import_parser = sub.add_parser("import", help="validate and copy an ONNX into policies/imported")
+    import_parser.add_argument("--source", type=Path, required=True)
+    args = parser.parse_args()
+    try:
+        if args.command == "inspect":
+            emit({"status": "PASS", "policy": validate_policy(args.policy),
+                  "model": validate_model(args.model)})
+        emit({"status": "PASS", **import_policy(args.source)})
+    except Exception as exc:
+        emit({"status": "FAIL", "error": f"{type(exc).__name__}: {exc}"}, 1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/policy_runtime.py b/policy_runtime.py
new file mode 100644
index 0000000..cb9d9a3
--- /dev/null
+++ b/policy_runtime.py
@@ -0,0 +1,24 @@
+"""Small ONNX runtime wrapper shared by the viewer and robustness runner."""
+from __future__ import annotations
+
+from pathlib import Path
+
+import numpy as np
+import onnxruntime as ort
+
+
+class OnnxPolicy:
+    def __init__(self, path: str | Path):
+        self.path = Path(path).resolve()
+        self.session = ort.InferenceSession(str(self.path), providers=["CPUExecutionProvider"])
+        inp = self.session.get_inputs()[0]
+        out = self.session.get_outputs()[0]
+        if inp.name != "observation" or out.name != "action":
+            raise ValueError(f"unexpected ONNX names: {inp.name!r}, {out.name!r}")
+        if inp.shape[-1] != 35 or out.shape[-1] != 6:
+            raise ValueError(f"unexpected ONNX shapes: {inp.shape}, {out.shape}")
+
+    def __call__(self, observation: np.ndarray) -> np.ndarray:
+        x = np.asarray(observation, dtype=np.float32).reshape(-1, 35)
+        y = self.session.run(["action"], {"observation": x})[0]
+        return np.asarray(y[0], dtype=np.float64)
