"""Finite actual-pose rendering from the new USD, without policy or mj_step.

MuJoCo is used only as a mesh renderer. The measured PhysX contacts in the
evaluation report, rather than this display, decide supported ascent.
"""
from pathlib import Path
from copy import deepcopy
import argparse,hashlib,io,json,subprocess,shutil,xml.etree.ElementTree as ET
import numpy as np

USD_SHA='2c421a8ec66e425ee6e47341ed0803f2c7e84f1f50afcc726572027ef6566ef3'

def mesh_visuals(usd,names):
    from pxr import Usd,UsdGeom,UsdPhysics
    stage=Usd.Stage.Open(str(usd));cache=UsdGeom.XformCache()
    bodies={str(p.GetName()):p for p in stage.Traverse()if p.HasAPI(UsdPhysics.RigidBodyAPI)}
    vfs={};elements=[]
    for name in names:
        body=bodies[name];inverse=cache.GetLocalToWorldTransform(body).GetInverse()
        vertices=[];faces=[];offset=0
        for p in Usd.PrimRange(body):
            if not p.IsA(UsdGeom.Mesh)or p.HasAPI(UsdPhysics.CollisionAPI):continue
            m=UsdGeom.Mesh(p);points=np.asarray(m.GetPointsAttr().Get(),dtype=np.float64)
            matrix=np.asarray(cache.GetLocalToWorldTransform(p)*inverse)
            points=points@matrix[:3,:3]+matrix[3,:3]
            counts=np.asarray(m.GetFaceVertexCountsAttr().Get());indices=np.asarray(m.GetFaceVertexIndicesAttr().Get())
            cursor=0
            for count in counts:
                f=indices[cursor:cursor+count]+offset;cursor+=count
                for j in range(1,len(f)-1):faces.append((int(f[0]),int(f[j]),int(f[j+1])))
            vertices.append(points);offset+=len(points)
        assert vertices and faces,('Authored visual mesh missing',name)
        vertices=np.concatenate(vertices)
        lines=['v %.8g %.8g %.8g'%tuple(p)for p in vertices]
        lines+=['f %d %d %d'%(a+1,b+1,c+1)for a,b,c in faces]
        filename=name+'.obj';vfs[filename]=('\n'.join(lines)+'\n').encode()
        elements.append((name,filename))
    return elements,vfs

def main():
    q=argparse.ArgumentParser();q.add_argument('--evaluation',required=True,type=Path)
    q.add_argument('--usd',required=True,type=Path);q.add_argument('--output',required=True,type=Path)
    q.add_argument('--video',action='store_true');a=q.parse_args()
    assert hashlib.sha256(a.usd.read_bytes()).hexdigest()==USD_SHA
    meta=json.loads((a.evaluation/'REPLAY_METADATA.json').read_bytes())
    assert meta['quaternion_order']=='xyzw'
    names=meta['body_names'];packets=[]
    for r in meta['replay']:
        p=a.evaluation/Path(r['path']).name;raw=p.read_bytes()
        assert len(raw)==r['bytes']and hashlib.sha256(raw).hexdigest()==r['SHA']
        with np.load(io.BytesIO(raw),allow_pickle=False)as z:packet={k:z[k].copy()for k in z.files}
        packet['body_pos']-=np.asarray(meta['origins'][r['env']])
        packets.append((r,packet))
    assert packets
    a.output.mkdir(exist_ok=False,parents=True)
    elements,vfs=mesh_visuals(a.usd,names)
    root=ET.Element('mujoco',model='Recorded actual MOD4v1 standing200 body poses')
    ET.SubElement(root,'compiler',angle='radian');vis=ET.SubElement(root,'visual')
    ET.SubElement(vis,'global',offwidth='640',offheight='400')
    ET.SubElement(vis,'headlight',ambient='.6 .6 .6',diffuse='.6 .6 .6')
    assets=ET.SubElement(root,'asset')
    for name,file in elements:ET.SubElement(assets,'mesh',name=name,file=file)
    world=ET.SubElement(root,'worldbody');ET.SubElement(world,'light',pos='0 -1 3',dir='0 0 -1')
    ET.SubElement(world,'geom',type='plane',size='6 6 .1',rgba='.25 .28 .32 1',contype='0',conaffinity='0')
    ET.SubElement(world,'geom',name='step200',type='box',pos='2.3 0 .1',size='1.5 1 .1',rgba='.25 .5 .75 1',contype='0',conaffinity='0')
    for name,_ in elements:
        body=ET.SubElement(world,'body',name='recorded_'+name,mocap='true',pos='0 0 -10')
        ET.SubElement(body,'geom',type='mesh',mesh=name,contype='0',conaffinity='0',density='0',rgba='.73 .77 .82 1')
    import mujoco
    from PIL import Image,ImageDraw
    model=mujoco.MjModel.from_xml_string(ET.tostring(root,encoding='unicode'),vfs)
    data=mujoco.MjData(model)
    assert model.nq==0 and model.nmocap==len(names)
    ids=np.array([model.body_mocapid[mujoco.mj_name2id(model,mujoco.mjtObj.mjOBJ_BODY,'recorded_'+n)]for n in names])
    renderer=mujoco.Renderer(model,height=400,width=640)
    camera=mujoco.MjvCamera();mujoco.mjv_defaultCamera(camera)
    def render(case,i,top=False):
        r,p=packets[case];i=min(i,len(p['time'])-1)
        data.mocap_pos[ids]=p['body_pos'][i]
        data.mocap_quat[ids]=p['body_quat'][i][...,[3,0,1,2]]
        mujoco.mj_forward(model,data)
        camera.lookat[:]=[.65,0.,.25];camera.distance=2.15
        camera.azimuth=90;camera.elevation=-89 if top else -18
        renderer.update_scene(data,camera);tile=Image.fromarray(renderer.render())
        draw=ImageDraw.Draw(tile);draw.rectangle((0,0,640,24),fill='black')
        draw.text((8,7),'Actual standing200 env%d | %.2fs | saved PhysX poses'%(r['env'],p['time'][i]),fill='white')
        return tile
    media=[]
    try:
        for case,(r,p)in enumerate(packets):
            indices=np.linspace(0,len(p['time'])-1,12).round().astype(int)
            for top in (False,True):
                sheet=Image.new('RGB',(640*3,400*4))
                for j,i in enumerate(indices):sheet.paste(render(case,i,top),((j%3)*640,(j//3)*400))
                path=a.output/('ACTUAL_env%d_%s.png'%(r['env'],'top'if top else'side'));sheet.save(path);media.append(path)
        if a.video:
            frames=a.output/'frames';frames.mkdir()
            for i in range(max(len(p['time'])for _,p in packets)):
                sheet=Image.new('RGB',(1280,800))
                for case in range(min(4,len(packets))):sheet.paste(render(case,i),((case%2)*640,(case//2)*400))
                sheet.save(frames/('frame_%04d.png'%i))
            ffmpeg=shutil.which('ffmpeg');assert ffmpeg
            path=a.output/'ACTUAL_STANDING200_half_speed.mp4'
            subprocess.run([ffmpeg,'-hide_banner','-loglevel','error','-framerate','25','-i',str(frames/'frame_%04d.png'),'-c:v','libx264','-crf','20','-pix_fmt','yuv420p','-movflags','+faststart',str(path)],check=True)
            media.append(path)
    finally:renderer.close()
    report=dict(source='actual 50Hz pre-reset PhysX body poses',new_USD_SHA=USD_SHA,checkpoint=meta['checkpoint'],
                zero_policy_reads=True,zero_physics_steps=True,render_forward_only=True,
                recorded_manifold_is_acceptance_not_render=True,
                media=[dict(path=str(p),bytes=p.stat().st_size,SHA=hashlib.sha256(p.read_bytes()).hexdigest())for p in media])
    (a.output/'RENDER_REPORT.json').write_text(json.dumps(report,indent=2),encoding='utf-8')
    print(json.dumps(report))

if __name__=='__main__':main()
