def run(c,source,value,timeout=90):
    body='import sys,json;v=json.loads(sys.stdin.readline());exec(v["source"])'
    channel=c.get_transport().open_session(timeout=15);channel.settimeout(timeout)
    channel.exec_command(shlex.quote(PY)+' -B -c '+shlex.quote(body))
    try:
        f=channel.makefile_stdin('wb');f.write((json.dumps(dict(value,source=source))+'\n').encode());f.flush();channel.shutdown_write()
        text=channel.makefile('rb').read().decode();error=channel.makefile_stderr('rb').read().decode();rc=channel.recv_exit_status()
        if rc:raise RuntimeError('Remote stage returned '+str(rc)+': '+error[-3000:])
        return json.loads(text)
    finally:channel.close()


