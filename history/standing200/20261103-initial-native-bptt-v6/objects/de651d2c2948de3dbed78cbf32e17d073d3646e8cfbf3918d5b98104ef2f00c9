class FakeTeacher(torch.nn.Module):
    def __init__(self):
        super().__init__();self.net=torch.nn.Linear(35,6)
    def forward(self,obs,stochastic_output=False):return self.net(obs['policy'])

class Synthetic:
    def __init__(self):
        self.device=torch.device('cpu');self.num_envs=8
        self.mdp=StandingMDP(52)
        self.s=torch.zeros(8,73);self.s[:,2]=.25;self.s[:,3]=1
        self.xi=torch.zeros(8,52);self.xi[:,0]=.35;self.xi[:,3]=1.25
        self.xi[:,35:44]=torch.tensor([.8,.2,0,0,2,3,1,0,1])
        self.f=torch.zeros(8,dtype=torch.long);self.a=torch.zeros(8,6)
        self.state=None
    @property
    def supermimic_mdp(self):return self.mdp
    def init_state(self):
        z=torch.zeros(8)
        self.state=BridgeState(info={SUPERMIMIC_STATE_KEY:dict(s=self.s.clone(),xi=self.xi.clone(),
            f=self.f.clone(),ep_step=self.f.to(torch.int32),a_prev=self.a.clone())},
            reward=z,terminated=z.bool(),truncated=z.bool(),obs={})
        return self.state
    @torch.no_grad()
    def step(self,a):
        old=self.state.info[SUPERMIMIC_STATE_KEY]
        s1=old['s'].clone();s1[:,13:19]+=.02*a;s1[:,0]+=.01*(a[:,4]+a[:,5])
        s1[:,7]=.5*(a[:,4]+a[:,5]);xi=old['xi'].clone()
        xi[:,4:10]=s1[:,13:19];xi[:,22:28]=a;xi[:,35]-=.01*(a[:,4]+a[:,5])
        r=-(s1[:,13:19]-.1).square().sum(-1)-.01*(s1[:,7]-.35).square()
        done=torch.zeros(8,dtype=torch.bool);self.f+=1
        t=dict(s=old['s'],s1=s1,a=a.clone(),a_prev=old['a_prev'],xi=old['xi'],xi1=xi,
            xi1_valid=~done,r=r,f=old['f'],ep_step=old['ep_step'],done=done,term=done,trunc=done)
        self.state=BridgeState(info={SUPERMIMIC_STATE_KEY:dict(s=s1,xi=xi,f=self.f.clone(),
            ep_step=self.f.to(torch.int32),a_prev=a.clone()),SUPERMIMIC_TRANSITION_KEY:t},
            reward=r,terminated=done,truncated=done,obs={})
        return self.state
    def export_supermimic_resume(self):return dict(exact=False,environment_resume='Synthetic fresh episode')

