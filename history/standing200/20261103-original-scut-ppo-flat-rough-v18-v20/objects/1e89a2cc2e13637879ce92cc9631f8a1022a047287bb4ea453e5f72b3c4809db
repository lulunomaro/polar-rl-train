"""Original actual step path with only straightguard changed; stub physical super."""
from pathlib import Path
from types import ModuleType,SimpleNamespace
import ast
import json
import os
import sys
import time
import traceback
HERE=Path(__file__).resolve().parent


def main():
    report=HERE.parent/'reports/SCUT20_COMMAND_STEP_CPU.json';assert not report.exists()
    value=dict(epoch=time.time(),passed=False,source_model_reads=0,SDK=0,actual_physics_steps=0)
    try:
        import torch
        from step_adapter import adapt_step
        p=Path('C:/Users/lulu/Desktop/claude/mjcf/polar-rl-train/project/isaac/mod4/mod4_env.py')
        raw=p.read_text(encoding='utf-8-sig');tree=ast.parse(raw)
        cls=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name=='Mod4Env')
        step=next(n for n in cls.body if isinstance(n,ast.FunctionDef) and n.name=='step')
        trace=[]
        class Parent:
            def step(self,action):trace.append('physical_super');self.common_step_counter+=1;return action+1
        module=ModuleType('scut20_real_step_fixture');module.__file__=str(p);sys.modules[module.__name__]=module
        def scripted(env,action):trace.append('original_script_hook');return action
        module.__dict__.update(ManagerBasedRLEnv=Parent,os=os,torch=torch,_scripted_jump_actions=scripted)
        unit=ast.Module(body=[ast.ClassDef(name='Mod4Env',bases=[ast.Name(id='ManagerBasedRLEnv',ctx=ast.Load())],keywords=[],body=[step],decorator_list=[])],type_ignores=[])
        exec(compile(ast.fix_missing_locations(unit),str(p),'exec'),module.__dict__)
        receipt=adapt_step(module.Mod4Env,source=raw)
        env=module.Mod4Env();env.common_step_counter=0;env.step_dt=.02
        term=SimpleNamespace(command=torch.tensor([[1.,0.,2.]]),cfg=SimpleNamespace(ranges=SimpleNamespace(ang_vel_z=(-6.283,6.283))))
        env.command_manager=SimpleNamespace(get_term=lambda name:term)
        env.event_manager=SimpleNamespace(available_modes=['step'],apply=lambda **kw:trace.append('original_step_event'))
        saved={k:os.environ.get(k) for k in ['RM_GYRO_CURRICULUM','RM_SPIN_STAGE']}
        os.environ['RM_GYRO_CURRICULUM']='0';os.environ['RM_SPIN_STAGE']=''
        try:result=env.step(torch.zeros(1,6))
        finally:
            for k,v in saved.items():
                if v is None:os.environ.pop(k,None)
                else:os.environ[k]=v
        assert trace==['original_script_hook','original_step_event','physical_super']
        assert (result==1).all() and env.common_step_counter==1
        value.update(passed=True,receipt=receipt,trace=trace,nonzero_yaw_command_preserved=True,zeroarg_super_class_closure_verified=True)
    except BaseException:value['error']=traceback.format_exc()
    report.write_text(json.dumps(value,indent=2)+'\n',encoding='utf-8');print(json.dumps(value,indent=2));raise SystemExit(0 if value['passed'] else 1)


if __name__=='__main__':main()
