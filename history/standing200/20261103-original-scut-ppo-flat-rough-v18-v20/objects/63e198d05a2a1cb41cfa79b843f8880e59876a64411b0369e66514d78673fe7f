"""Replace only the old straight-only task assertion for source SCUT commands."""
import ast
import copy
import inspect
import types


def adapt_step(cls, source=None):
    source=source or inspect.getsource(inspect.getmodule(cls))
    tree=ast.parse(source)
    body=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name==cls.__name__)
    step=copy.deepcopy(next(n for n in body.body if isinstance(n,ast.FunctionDef) and n.name=='step'))
    count=0
    for i,node in enumerate(step.body):
        for parent in ast.walk(node):
            if not hasattr(parent,'body') or not isinstance(parent.body,list):continue
            updated=[]
            for child in parent.body:
                if isinstance(child,ast.If) and any(isinstance(r,ast.Raise) and isinstance(r.exc,ast.Call)
                    and any(isinstance(a,ast.Constant) and a.value=='Straight-speed contract violated: nonzero yaw command' for a in r.exc.args)
                    for r in child.body):
                    count+=1
                    replacement=ast.parse("audit['command_contract']='SCUT saved flat/rough rotation command distribution'").body[0]
                    updated.append(ast.copy_location(replacement,child))
                else:updated.append(child)
            parent.body=updated
    if count!=1:raise ValueError('Expected exactly one obsolete straight-only assertion')
    shell=ast.ClassDef(name=cls.__name__,bases=[],keywords=[],body=[step],decorator_list=[])
    unit=ast.fix_missing_locations(ast.Module(body=[shell],type_ignores=[]))
    ns=dict(inspect.getmodule(cls).__dict__)
    exec(compile(unit,inspect.getfile(cls),'exec'),ns)
    compiled=vars(ns[cls.__name__])['step']
    class_cell=(lambda:cls).__closure__[0]
    closure=tuple(class_cell if name=='__class__' else cell for name,cell in zip(compiled.__code__.co_freevars,compiled.__closure__ or ()))
    cls.step=types.FunctionType(compiled.__code__,compiled.__globals__,compiled.__name__,compiled.__defaults__,closure or None)
    return dict(obsolete_straight_assertions_replaced=count,physics_action_event_super_step_unchanged=True,
        command_distribution='original SCUT recipe',other_AST_changed=False)
