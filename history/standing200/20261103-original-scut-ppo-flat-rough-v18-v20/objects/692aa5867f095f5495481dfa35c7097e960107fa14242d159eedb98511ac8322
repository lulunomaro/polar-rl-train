def install(stage,source_stage=None):
    import torch
    import mod4v1_scut.sdk as sdk
    import mod4v1_scut.config as config
    import mod4v1_scut.checkpoint as checkpoint
    # The shared constructor allocates a scan descriptor unconditionally.
    # Read its descriptor before selecting flat, then remove that scene field
    # before any SDK scene is instantiated. Flat never calls this sensor.
    if stage=='flat':
        descriptor=config.ground_scan_config()
        sdk.ground_scan_config=lambda: descriptor
    receipt=base.install(stage,source_stage=source_stage)
    if stage=='flat':
        original=sdk.configure
        def configure(cfg,n,profile='trained_stair'):
            original(cfg,n,profile)
            cfg.scene.scut_ground=None
            return cfg
        sdk.configure=configure
        def read_reward_scans(self,ids=None,forward=True):
            select=slice(None) if ids is None else ids
            wheels=self.reward.robot.data.body_pos_w[select][:,self.reward._wheel_link_idx]
            ground=torch.zeros(wheels.shape[0],device=self.device)
            wheel_ground=ground[:,None].expand(-1,2).clone()
            points=wheels.clone();hits=wheels.clone();hits[...,2]=0.
            return ground,wheel_ground,points,hits,points.clone(),hits.clone()
        sdk.ScutBridge.read_reward_scans=read_reward_scans
        receipt.update(flat_height_scanner=None,flat_sensor_instantiated=False,flat_world_ground_z=0.)
    checkpoint.FORMAT='MOD4V1_SCUT_STANDING_RECIPE_V19'
    return receipt
