'''
        actual = run(client, code, dict(job=frozen['job']), 45)
        put('SCUT18_OWNER_LAUNCH_ACTUAL.json', actual)
        p = R / 'CURRENT_WORK_ORDER.json'
        w = json.loads(p.read_bytes())
        w['prior_V16_closed'] = dict(run_id=w['run_id'], remote_job=w['remote_job'], final=w['current_run_final'], evaluation=w['evaluation_result'])
