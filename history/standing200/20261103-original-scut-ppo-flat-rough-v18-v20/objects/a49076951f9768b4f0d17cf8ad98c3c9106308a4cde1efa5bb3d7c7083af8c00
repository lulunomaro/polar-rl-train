def launch():
    marker = R / 'reports/SCUT18_LAUNCH_ONCE.json'
    assert not marker.exists()
    frozen = json.loads((HERE / 'FROZEN.json').read_bytes())
    plan = json.loads((HERE / 'PLAN.json').read_bytes())
    for row in frozen['files']:
        raw = Path(row['path']).read_bytes()
        assert len(raw) == row['bytes'] and hashlib.sha256(raw).hexdigest() == row['SHA']
    inventory = json.loads((R / 'reports/FOUR4090_RESOURCE_ACTUAL_SCUT18B.json').read_bytes())
    assert inventory['all_clients_closed'] and inventory['SESSION_restored'] and inventory['serial'] == 'FREE'
    assert set(inventory['hosts']) == {'72', '210', '86'}, 'All four4090 inventory required'
    assert inventory['hosts']['72']['passed'], 'Selected host has no actual resource read'
    from datetime import datetime
    assert time.time() - datetime.fromisoformat(inventory['captured']).timestamp() < 600, 'Refresh unused operation version if resource snapshot stale'
    rows, blocked = admission()
    if blocked:
        print(json.dumps(dict(blocked=blocked, network=0, once_consumed=False)))
        return
    put('SCUT18_LAUNCH_LOCAL_ADMISSION.json', dict(epoch=time.time(), rows=rows, blocked=[], serial='FREE'))
    client = sf = None
    try:
        sys.path.insert(0, str(R.parent / 'mod4v1_experts_fulldr_rm70_20261101'))
        from project_connector import connect72
        client = connect72()
        check = run(client, ADMIT, dict(job=frozen['job'], uuid=plan['GPU_UUID'], shared=frozen['shared_text']), 90)
        put('SCUT18_PARENT_ADMISSION.json', check)
        put('SCUT18_LAUNCH_ONCE.json', dict(epoch=time.time(), run_id=frozen['run_id'], frozen_SHA=hashlib.sha256((HERE / 'FROZEN.json').read_bytes()).hexdigest()))
        sf = client.open_sftp()
        sf.mkdir(frozen['job'])
        def upload(relative, raw):
            path = frozen['job']
            for part in relative.split('/')[:-1]:
                path += '/' + part
                try:
                    sf.mkdir(path)
                except OSError:
                    sf.stat(path)
            with sf.open(frozen['job'] + '/' + relative, 'wx') as f:
                f.write(raw)
        for row in frozen['files']:
            upload(row['relative'], Path(row['path']).read_bytes())
        manifest = dict(files=[{k: row[k] for k in ['relative', 'bytes', 'SHA']} for row in frozen['files']], shared_text=frozen['shared_text'])
        upload('INSTALL_MANIFEST.json', json.dumps(manifest, indent=2).encode())
        sf.close(); sf = None
        code = r'''
