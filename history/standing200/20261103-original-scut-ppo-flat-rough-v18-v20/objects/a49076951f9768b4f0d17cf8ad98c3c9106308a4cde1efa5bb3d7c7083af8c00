def put(name, value):
    with (R / 'reports' / name).open('x', encoding='utf-8') as f:
        json.dump(value, f, ensure_ascii=False, indent=2)


def admission():
    spec = importlib.util.spec_from_file_location('standing_original_local_gate', R / 'repair_v11/control.py')
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module.admission()


def gpu():
    _, blocked = admission()
    if blocked:
        print(json.dumps(dict(blocked=blocked, network=0, once_consumed=False)))
        return
    import check_four4090_once as inventory
    source = Path(inventory.__file__).read_text(encoding='utf-8')
    for name in ['FOUR4090_READ_V1_ONCE.json', 'FRESH_LOCAL_CIM_BEFORE_FOUR4090_V1.json', 'FOUR4090_RESOURCE_ACTUAL_V1.json']:
        assert source.count(name) == 1
        source = source.replace(name, name.replace('_V1', '_SCUT18B'))
    ns = dict(__name__='standing_scut18_inventory', __file__=inventory.__file__)
    exec(compile(source, inventory.__file__, 'exec'), ns)
    ns['local_rows'] = admission
    ns['main']()


