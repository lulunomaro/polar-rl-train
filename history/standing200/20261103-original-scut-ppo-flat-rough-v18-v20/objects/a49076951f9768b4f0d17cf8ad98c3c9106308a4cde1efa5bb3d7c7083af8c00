def first():
    import collect_standing_status_v1 as reader
    s = Path(reader.__file__).read_text(encoding='utf-8')
    s = s.replace("assert '/MOD4_STANDING200_RLBPTT_' in job", "assert '/MOD4_STANDING200_SCUT_RECIPE_V18_' in job")
    s = s.replace("'production/NATIVE_STARTUP.json'", "'production/STARTUP.json'").replace("'production/PROGRESS.json'", "'production/LATEST_PROGRESS.json'")
    s = s.replace("'production/WORKER_ERROR.json'", "'production/ERROR.json'").replace("'evaluation/EVAL_ERROR.json'", "'evaluation/ERROR.json'")
    ns = dict(__name__='standing_scut18_first', __file__=reader.__file__)
    exec(compile(s, reader.__file__, 'exec'), ns)
    ns['local_rows'] = admission
    sys.argv = [reader.__file__, '--label', 'SCUT18_FIRST', '--wait-seconds', '300']
    ns['main']()


def closed():
    """One closed evidence transfer; requires original owner terminal receipt."""
    _, blocked = admission()
    if blocked:
        print(json.dumps(dict(blocked=blocked, network=0, once_consumed=False)))
        return
    plan = json.loads((HERE / 'PLAN.json').read_bytes())
    runid, job = plan['run_id'], plan['remote_root']
    marker = R / 'reports/SCUT18_CLOSED_TRANSFER_ONCE.json'
    assert not marker.exists()
    client = sf = None
    try:
        sys.path.insert(0, str(R.parent / 'mod4v1_experts_fulldr_rm70_20261101'))
        from project_connector import connect72
        client = connect72(); sf = client.open_sftp(); sf.get_channel().settimeout(60)
        def read(relative, limit=32*1024**2):
            with sf.open(job + '/' + relative, 'rb') as stream:
                raw = stream.read(limit + 1)
            assert len(raw) <= limit
            return raw
        own = json.loads(read('OWNER_EXIT.json'))
        assert own['run_id'] == runid and own['all_own_waited'] and own['original_cost_settled'] and own['original_leases_released']
        put(marker.name, dict(epoch=time.time(), run_id=runid, original_exit=own))
        dest = R / 'actual_closed' / runid
        dest.mkdir(parents=True, exist_ok=False)
        rows = []
        def store(relative, raw):
            path = dest / relative; path.parent.mkdir(parents=True, exist_ok=True)
            with path.open('xb') as stream:
                stream.write(raw)
            rows.append(dict(remote_path=job+'/'+relative, local_path=str(path), bytes=len(raw), SHA=hashlib.sha256(raw).hexdigest()))
        names = ['OWNER_EXIT.json', 'OWNER_STARTED.json', 'OWNER_ERROR.json', 'INSTALL_MANIFEST.json', 'TASK.json', 'PLAN.json',
            'ROOT_ADMISSION_ACTUAL.json', 'GO_PRODUCTION.json', 'WORKER_IDENTITY.json', 'TRAIN_CLOSED.json', 'EVAL_WAITED.json',
            'production/STARTUP.json', 'production/FIRST_UPDATED.json', 'production/LATEST_PROGRESS.json', 'production/FINAL.json',
            'production/ERROR.json', 'production/ENV_CLOSED.json', 'production/APP_CLOSE_INTENT.json', 'production/POSE_CACHE_EVENTS.json',
            'evaluation/RESULT.json', 'evaluation/ERROR.json', 'evaluation/NATIVE_STARTUP.json', 'evaluation/ALL80.json',
            'evaluation/CONTROL_CURVES.json', 'evaluation/ENV_CLOSED.json', 'evaluation/APP_CLOSE_INTENT.json']
        for relative in names:
            try:
                raw = read(relative)
            except FileNotFoundError:
                continue
            store(relative, raw)
        result_path = dest / 'evaluation/RESULT.json'
        if result_path.exists():
            result = json.loads(result_path.read_bytes())
            for key in ('all80_manifold', 'actual_poses'):
                row = result[key]; relative = 'evaluation/' + Path(row['path']).name
                assert row['path'] == job + '/' + relative
                raw = read(relative, 128*1024**2)
                assert len(raw) == row['bytes'] and hashlib.sha256(raw).hexdigest() == row['SHA']
                store(relative, raw)
        put('SCUT18_CLOSED_TRANSFER_ACTUAL.json', dict(epoch=time.time(), run_id=runid, original_exit=own, files=rows,
            evaluation=str(dest/'evaluation'), source_PT_reads=0, physics_operations=0, native_review_pending=True))
        print(json.dumps(dict(evaluation=str(dest/'evaluation'), files=len(rows))))
    except FileNotFoundError:
        print(json.dumps(dict(owner_not_closed=True, once_consumed=marker.exists(), no_relaunch=True)))
        if marker.exists():
            put('SCUT18_CLOSED_TRANSFER_ERROR.json', dict(epoch=time.time(), error=traceback.format_exc(), never_replay=True))
            raise
    except BaseException:
        put('SCUT18_CLOSED_TRANSFER_ERROR.json', dict(epoch=time.time(), error=traceback.format_exc(), once_consumed=marker.exists()))
        raise
    finally:
        if sf is not None: sf.close()
        if client is not None: client.close()
        if marker.exists():
            put('SCUT18_CLOSED_TRANSFER_SSH_CLOSED.json', dict(epoch=time.time(), SSHclosed=True, SESSION_restored=True, serial='FREE'))


