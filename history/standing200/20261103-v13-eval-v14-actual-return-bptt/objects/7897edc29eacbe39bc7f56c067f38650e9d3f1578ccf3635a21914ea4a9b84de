def gaussian_log_prob(sample,mean,std=.1):
    return (-.5*((sample-mean)/std).square()-math.log(std)-.5*math.log(2*math.pi)).sum(-1)


def actual_gae(reward,done,value,next_value,gamma=.99,lam=1.):
    if not(reward.shape==done.shape==value.shape==next_value.shape):
        raise ValueError('Actual [controls,env] arrays must share shape')
    continuation=(~done.bool()).to(reward.dtype)
    delta=reward+gamma*continuation*next_value-value
    following=torch.zeros_like(reward[0]);reverse=[]
    for k in range(len(reward)-1,-1,-1):
        following=delta[k]+gamma*lam*continuation[k]*following
        reverse.append(following)
    advantage=torch.stack(reverse[::-1])
    return advantage,advantage+value


def surrogate(mean,preclip_sample,old_logprob,advantage,std=.1,clip=.2):
    logprob=gaussian_log_prob(preclip_sample,mean,std)
    ratio=(logprob-old_logprob).exp()
    objective=torch.minimum(ratio*advantage,ratio.clamp(1-clip,1+clip)*advantage)
    return -objective.mean(),ratio


def actual_mean_kl(old_mean,new_mean,std=.1):
    return .5*((old_mean-new_mean)/std).square().sum(-1).mean()
