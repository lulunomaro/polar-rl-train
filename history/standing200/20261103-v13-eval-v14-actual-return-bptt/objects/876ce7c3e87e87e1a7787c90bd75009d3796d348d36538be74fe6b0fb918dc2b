        future='If this phase alreadyrecorded,ordinarysupplements; never rerecord or retag'),ensure_ascii=False,indent=2)+'\n',encoding='utf-8')
    print(json.dumps(dict(destination=str(DEST),text_rows=len(rows),new_objects=len(list((DEST/'objects').iterdir())),large_indexed=len(large))))


