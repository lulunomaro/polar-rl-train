    guard=importlib.util.module_from_spec(spec);spec.loader.exec_module(guard)
    known={}
    for path in(REPO/'history/standing200').rglob('INDEX.json'):
        for row in json.loads(path.read_bytes()).get('rows',[]):
            if row.get('archive_SHA')and row.get('archive_path'):known[row['archive_SHA']]=row['archive_path']
    text={'.py','.json','.md','.txt','.toml','.diff','.log','.csv'}
    closed=R/'actual_closed/MOD4_STANDING200_RLBPTT_V13_1793670990137789700'
    files=[]
    for base in[D,R/'repair_v11',R/'reports',closed]:
        files.extend(p for p in base.rglob('*')if p.is_file()and p.suffix.lower()in text and '__pycache__'not in p.parts)
    files.extend([R/'CURRENT_WORK_ORDER.json',Path('C:/Users/lulu/.codex/automations/mod4-200-rl-bptt/automation.toml')])
    DEST.mkdir(parents=True);(DEST/'objects').mkdir();rows=[]
