    for rel in ['rendered_v2/RENDER_REPORT.json','analysis/MEDIA_INDEX.json']:
        large.extend(dict(row,published_by=str(closed/rel))for row in json.loads((closed/rel).read_bytes())['media'])
    (DEST/'README.md').write_text((D/'README.md').read_text(encoding='utf-8'),encoding='utf-8')
