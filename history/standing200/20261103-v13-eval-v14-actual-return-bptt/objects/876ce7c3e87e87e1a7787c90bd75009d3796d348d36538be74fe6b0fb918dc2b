            out=DEST/'objects'/sha
            if not out.exists():out.write_bytes(content)
            target=out.relative_to(REPO).as_posix();known[sha]=target
        rows.append(dict(source_path=str(path),bytes=len(raw),SHA=hashlib.sha256(raw).hexdigest(),
            archive_path=target,archive_SHA=sha,archive_bytes=len(content),redactions=n,
            mode='complete_text'if not n else'redacted_text'))
