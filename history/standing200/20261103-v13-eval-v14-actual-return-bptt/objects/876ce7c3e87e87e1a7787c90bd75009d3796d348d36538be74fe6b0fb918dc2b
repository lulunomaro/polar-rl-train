        rows=rows,large_external_artifacts=large,model_media_reads_for_archive=0,shared_runtime_copies=0,
        V13_trialobject_preserved='3ba22ac6f49d2a8b9a46eb60680b7b5316bf15ca',
        V13_trialpeel_preserved='a129e10d278e0bcb9c9641aedb54a248a9a692f4',
