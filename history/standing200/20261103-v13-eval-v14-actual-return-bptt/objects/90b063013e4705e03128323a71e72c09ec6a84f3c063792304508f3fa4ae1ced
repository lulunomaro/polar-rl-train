def close(ns,env,course,out,error):
    if course is not None:course.close()
    if env is not None:env.close();put(out/'ENV_CLOSED.json',dict(epoch=time.time(),original_close_returned=True))
    if ns is not None:
        # Isaac's original fast_shutdown may os._exit. Durable save + env closure
        # before its untouched no-argument close and actual parent wait are joined.
        put(out/'APP_CLOSE_INTENT.json',dict(epoch=time.time(),error=error,original_zero_argument_close=True,
            final_exists=(out/'FINAL.json').exists(),env_closed=(out/'ENV_CLOSED.json').exists()))
        ns['app'].close()
        put(out/'APP_CLOSED.json',dict(epoch=time.time(),returned=True))


def train(J,task,go):
    out=J/'production';out.mkdir(exist_ok=False)
    ns=env=course=guard=bridge=learner=None;error=None;latest=None;lifetime={}
    try:
        ns,env,course,guard,obs,tensor=build(J,task,task['num_envs'],task['seed'],out,lifetime=lifetime)
        import torch
        from native_supermimic_bridge import PinnedTeacher
        from standing_bridge_v1 import StandingBridge
        from standing_action_v8 import StandingResidualPolicy,ACTION_CONTRACT,path_receipt
        from standing_resume_v8 import load_pinned,EmbeddedTeacher,restore_learner
        from hybrid_actual import Learner as ContextRewardLearner,Policy as StandingResidualPolicy,CONTRACT as REPAIR_CONTRACT
        from supermimic_vendor_v2.learner import SuperMimicConfig
        source=load_pinned(task["resume"])
        teacher=EmbeddedTeacher(task,source);actor=teacher.build_actor(env.device)
        bridge=StandingBridge(env,task,out,tensor,teacher,course,initial_obs=obs);bridge.init_state()
        class Learner(ContextRewardLearner):
            def _make_policy(self):return StandingResidualPolicy(super()._make_policy(),actor,scale=1.)
            def _checkpoint(self,include_optimizers):
                full=super()._checkpoint(include_optimizers)
                full.update(standing_task=task,teacher_source=teacher.receipt(),course_height_m=.2,
                    action_mode=ACTION_CONTRACT,source_counts=source['context_reward_extension']['counts'],
                    physical_resume='fresh episode; all learner optimizer/replay/RNG restored',
                    acceptance='supported ascent, not first-flight jump')
                return full
            def save(self,path=None,include_optimizers=True):
                nonlocal latest
                teacher.assert_frozen();count=self.counts.pi_bptt_optimizer_steps
                p=out/'checkpoints'/('BPTT'+str(count).zfill(6)+'_I'+str(self.iteration).zfill(6)+'_'+str(time.time_ns())+'_complete.pt')
                p=super().save(p,include_optimizers=True)
                latest=dict(epoch=time.time(),path=str(p),bytes=p.stat().st_size,SHA=digest(p),
                    counts=vars(self.counts),iteration=self.iteration,full_models_four_optimizers_replay_RNG=True,
                    last_bptt_receipt=self.last_bptt_receipt)
                put(out/'latest_complete.json',latest)
                return p
        cfg=SuperMimicConfig(iterations=100000,buffer_steps=256,utd=.4,horizon=32,goal_frames=1,
            hist=10,z_dim=32,wm_hidden=(512,512,512),policy_hidden=(512,256,128),critic_hidden=(256,128),
            wm_window=8,wm_batches=4,wm_batch=512,pi_batch=512,lr=1e-4,action_noise=.10,
            warmup_steps=64,wm_only_iters=100,critic_epochs=2,critic_minibatches=2,
            ckpt_every=250,log_every=10,log_backend='none',amp='none',compile=False,seed=task['seed'])
        mask=torch.ones(bridge.mdp.context_dim);mask[:3]=0;mask[14:16]=0;mask[22:35]=0
        learner=Learner(bridge,cfg,out/'learner',device=env.device,backend='standing200_actual_rl_learnedWM_BPTT',
                        policy_dt_s=.02,predict_context_mask=mask)
        restored=restore_learner(learner,source)
        source_steps=learner.counts.pi_bptt_optimizer_steps
        put(out/'FULL_RESTORE_V14.json',dict(epoch=time.time(),source=task['resume'],receipt=restored,
            policy_action_contract=ACTION_CONTRACT,optimizer_repair_contract=REPAIR_CONTRACT,source_model_decodes=1,source_teacher_PT_opens=0))
        bridge.learner=learner;last_report=-1;first_saved=False
        def before_action():
            nonlocal last_report,first_saved
            if time.time()>=go['save_deadline']or(J/'STOP_AFTER_SAVE.json').exists()or shutil.disk_usage(J).free<8*1024**3:
                raise SavedStop()
            if learner.counts.pi_bptt_optimizer_steps>source_steps and not first_saved:
                learner.save();put(out/'FIRST_UPDATED.json',dict(epoch=time.time(),checkpoint=latest,
                    metrics=bridge.metrics(),teacher=teacher.receipt(),physical_RL_skill_not_evaluated=True,
                    new_BPTT_steps=learner.counts.pi_bptt_optimizer_steps-source_steps,repair=learner.last_repair,actual_returns=learner.last_actual,
                    actual_action_path=path_receipt(learner.pi,learner.obs_hist,learner._goal(
                        learner._state_info()['f'],learner._state_info()['xi']))))
                first_saved=True
            if learner.iteration!=last_report and learner.iteration%10==0:
                put(out/'PROGRESS.json',dict(epoch=time.time(),iteration=learner.iteration,counts=vars(learner.counts),
                    last_bptt=learner.last_bptt_receipt,repair=learner.last_repair,actual_returns=learner.last_actual,**bridge.metrics()));last_report=learner.iteration
        bridge.before_action=before_action
        # Same underlying transition model, changed policy commands: refill
        # original replay capacity with new real transitions before new BPTT.
        # Restored four Adam/counters/RNG are never reset; original ring is
        # overwritten through normal collection, source checkpoint retained.
        try:
            learner.collect(256)
            for _ in range(64):
                if time.time()>=go['save_deadline']:raise SavedStop()
                learner.wm_update()
            put(out/'REPAIR_FRESH_ACTION_WM_WARMUP.json',dict(epoch=time.time(),actual_controls=bridge.controls,
                fresh_actual_transitions=bridge.controls*bridge.num_envs,WM_aux_additional_updates=64,
                policy_optimizer_steps=learner.counts.pi_bptt_optimizer_steps,
                source_policy_optimizer_steps=source_steps,source_replay_retained_in_source_checkpoint=True))
            learner.train(target_bptt_steps=source_steps+3000)
        except SavedStop:pass
        learner.save();teacher.assert_frozen();guard.assert_new_nominals_unchanged()
        put(out/'FINAL.json',dict(epoch=time.time(),passed_execution=True,checkpoint=latest,
            counts=vars(learner.counts),native_BPTT_steps=learner.counts.pi_bptt_optimizer_steps,
            source_native_BPTT_steps=source_steps,new_native_BPTT_steps=learner.counts.pi_bptt_optimizer_steps-source_steps,
            skill_graduated=False,independent80_required=True,actual_returns=learner.last_actual,**bridge.metrics()))
    except BaseException:
        error=traceback.format_exc();put(out/'WORKER_ERROR.json',dict(epoch=time.time(),error=error,
            counts=None if learner is None else vars(learner.counts)))
        if learner is not None:
            try:learner.save()
            except BaseException:put(out/'ERROR_SAVE_FAILURE.json',dict(error=traceback.format_exc()))
    finally:
        if bridge is not None:
            env.termination_manager.compute=bridge._oldterm
        close(ns or lifetime.get('ns'),env or lifetime.get('env'),course or lifetime.get('course'),out,error)
    if error:raise RuntimeError(error)


