    axes[1].plot(t,root[:,0],label=label,color=color)
    axes[2].plot(t,targets[:,0],color=color,label=label+' left');axes[2].plot(t,targets[:,1],'--',color=color,label=label+' right')
    axes[3].plot(t,z[:,4],color=color,label=label+' leftwheel');axes[3].plot(t,z[:,5],'--',color=color,label=label+' rightwheel')
    axes[4].plot(t,lower.min(-1),color=color,label=label+' lowerwheel')
    axes[5].plot(t,d['reward'],color=color,label=label)
