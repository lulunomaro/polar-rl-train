    # reconstruction's tiny derivative as a production live-gradient proof.
    z=np.arctanh(np.clip((base-mid)/radius,-.8,.8))+latent/6
    mapped=mid+radius*np.tanh(z)
    derivative=radius/6*(1-np.tanh(z)**2)
    early=t<=.20+1e-6
    front=d['upper'][:,:,0];lower=d['lower'][:,:,2]
    yaw=rpy[:,2];roll=rpy[:,0];pitch=rpy[:,1]
    wheelvel=d['joint_vel'][:,[25,28]];wheelq=d['joint_pos'][:,[25,28]]
    targets=d['joint_vel_target'][:,[25,28]]
