def load(folder,row):
    p=folder/Path(row['path']).name;raw=p.read_bytes()
    assert len(raw)==row['bytes']and hashlib.sha256(raw).hexdigest()==row['SHA']
    with np.load(p,allow_pickle=False)as z:return {k:z[k].copy()for k in z.files}
for index,row in enumerate(meta['replay']):
    d=load(E,row);t=d['time'];n=len(t);origin=np.asarray(meta['origins'][row['env']],dtype=np.float32)
    root=d['root'].copy();root[:,:3]-=origin
    a=d['action'];base=d['teacher_raw'];latent=d['residual_latent'];rpy=np.rad2deg(d['euler'])
    unit=(a-mid)/radius
