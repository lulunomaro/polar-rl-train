    ca[0,0].plot(t,pitch,color=color,label=label+' V13')
    ca[0,1].plot(t,a[:,5]*10-a[:,4]*10,color=color,label=label)
    ca[1,0].plot(t,wheelvel[:,0],color=color,label=label+' leftactual');ca[1,0].plot(t,wheelvel[:,1],'--',color=color,label=label+' rightactual')
    ca[1,1].plot(t,a[:,0]*.5,color=color,label=label+' leftcrank');ca[1,1].plot(t,a[:,2]*.5,'--',color=color,label=label+' rightcrank')
    case=dict(env=row['env'],controls=n,seconds=float(t[-1]),first_root=root[0,:3].tolist(),final_root=root[-1,:3].tolist(),
        initial_to_final_delta=root[-1,:3].tolist()if False else(root[-1,:3]-root[0,:3]).tolist(),
        wheel_front_max_m=float(front.max()),remaining_wheel_front_distance_m=float(.8-front.max()),
        bothwheel_bottom_max_m=float(lower.min(-1).max()),each_wheel_bottom_max_m=lower.max(0).tolist(),
        final_roll_pitch_yaw_deg=rpy[-1].tolist(),peak_abs_roll_pitch_yaw_deg=np.abs(rpy).max(0).tolist(),
        first_action=a[0].tolist(),last_action=a[-1].tolist(),
        first_latent=latent[0].tolist(),last_latent=latent[-1].tolist(),
        base_min=base.min(0).tolist(),base_max=base.max(0).tolist(),
        total_logit_min=z.min(0).tolist(),total_logit_max=z.max(0).tolist(),
        near_bound_fraction=(np.abs(unit)>.999).mean(0).tolist(),
        exact_float32_zero_derivative_fraction=(derivative==0).mean(0).tolist(),
        initial_action_formula_numpy_float32_max_difference=float((mapped-a).abs().max())if hasattr(mapped,'abs')else float(np.abs(mapped-a).max()),
        first20_targets_rad_s=targets[early].mean(0).tolist(),first20_actual_wheel_rad_s=wheelvel[early].mean(0).tolist(),
        first20_target_differential_rad_s=float((targets[early,1]-targets[early,0]).mean()),
        actual_wheel_target_minmax=[targets.min(0).tolist(),targets.max(0).tolist()],
        actual_wheel_speed_minmax=[wheelvel.min(0).tolist(),wheelvel.max(0).tolist()],
        initial_crank_hip_targets_rad=d['joint_pos_target'][0,[1,0,5,4]].tolist(),
        first_depth=d['depth'][0].tolist(),depth_valid_fraction=float((d['depth'][:,8]>.5).mean()),
        top_max_N=float(d['top'].max()),ground_max_N=float(d['ground'].max()),
        recorded_reward_mean=float(d['reward'].mean()),
        limits='selected 4 actual cases only; no all80 visual or unique causal inference')
    cases.append(case)
    for k in range(n):
        out=dict(env=row['env'],seconds=float(t[k]),x=float(root[k,0]),y=float(root[k,1]),z=float(root[k,2]),roll_deg=float(roll[k]),pitch_deg=float(pitch[k]),yaw_deg=float(yaw[k]),reward=float(d['reward'][k]))
        for name,values in [('action',a),('latent',latent),('pretanh',z)]:out.update({name+str(j):float(values[k,j])for j in range(6)})
        out.update(left_target_rad_s=float(targets[k,0]),right_target_rad_s=float(targets[k,1]),left_actual_rad_s=float(wheelvel[k,0]),right_actual_rad_s=float(wheelvel[k,1]))
        csvrows.append(out)
