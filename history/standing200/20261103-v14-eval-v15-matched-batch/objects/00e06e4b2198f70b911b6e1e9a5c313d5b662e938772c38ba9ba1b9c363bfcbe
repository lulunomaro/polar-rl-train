        raw = (R / 'repair_v14' / name).read_bytes()
        wrapper = ("from pathlib import Path\nimport hashlib\n"
            f"_p=Path({(w['remote_job'] + '/' + folder + '/' + name)!r})\n"
            f"_r=_p.read_bytes()\nassert hashlib.sha256(_r).hexdigest()=={hashlib.sha256(raw).hexdigest()!r}\n"
            "exec(compile(_r,str(Path(__file__).absolute()),'exec'),globals())\n")
        (D / name).write_text(wrapper, encoding='utf-8', newline='\n')
    plan = json.loads((R / 'repair_v14/PLAN.json').read_bytes())
    runid = 'MOD4_STANDING200_RLBPTT_V15_' + str(time.time_ns())
