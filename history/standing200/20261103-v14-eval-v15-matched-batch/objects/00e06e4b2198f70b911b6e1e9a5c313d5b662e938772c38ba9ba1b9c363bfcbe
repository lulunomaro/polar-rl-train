def launch():
    assert not (R / 'reports/MATCHED_ACTUAL_V15_LAUNCH_ONCE.json').exists()
    frozen = json.loads((D / 'FROZEN.json').read_bytes())
    plan = json.loads((D / 'PLAN.json').read_bytes())
    for row in frozen['files']:
        raw = (D / row['name']).read_bytes()
        assert len(raw) == row['bytes'] and hashlib.sha256(raw).hexdigest() == row['SHA']
    rows, blocked = admission()
    if blocked:
        print(json.dumps(dict(blocked=blocked, network=0, once_consumed=False)))
        return
    inventory = json.loads((R/'reports/FOUR4090_RESOURCE_ACTUAL_V15.json').read_bytes())
    assert inventory['all_clients_closed'] and inventory['SESSION_restored'] and inventory['serial'] == 'FREE'
    assert all(row['passed'] for row in inventory['hosts'].values())
    put('MATCHED_ACTUAL_V15_LAUNCH_LOCAL_ADMISSION.json', dict(epoch=time.time(), rows=rows, blocked=[], serial='FREE'))
    put('MATCHED_ACTUAL_V15_LAUNCH_ONCE.json', dict(epoch=time.time(), frozen_SHA=hashlib.sha256((D/'FROZEN.json').read_bytes()).hexdigest(), run_id=frozen['run_id']))
    c = None
    try:
        sys.path.insert(0, str(R.parent / 'mod4v1_experts_fulldr_rm70_20261101'))
        from project_connector import connect72
        c = connect72()
        check = run(c, old.PREFLIGHT, dict(job=frozen['job'], base=old.SHARED, uuid=plan['GPU_UUID'], super='/home/lc01/Zonglin Li/zonglin2/tasks/MOD4V1_SUPERMIMIC_BPTT8_V1_20261102_181251_1793614371303119100/roles/E0'))
        put('MATCHED_ACTUAL_V15_PARENT_ADMISSION.json', check)
        deploy = {}
        for name in ['matched_actual.py', 'standing_worker_v1.py', 'standing_owner_v1.py', 'evaluate_standing200_v1.py', 'PLAN.json']:
            raw = (D/name).read_bytes()
            rel = ('' if name == 'PLAN.json' else 'control/' if name == 'standing_owner_v1.py' else 'source/') + name
            deploy[rel] = dict(text=raw.decode(), SHA=hashlib.sha256(raw).hexdigest())
        stage = old.exact_replace(old.STAGE, 'from hybrid_actual import CONTRACT', 'from matched_actual import CONTRACT')
        stage = old.exact_replace(stage, 'STANDING200_ACTUAL_RETURN_H32_V14_SMALL_OVERRIDE', 'STANDING200_MATCHED_ACTUAL_H32_V15_SMALL_OVERRIDE')
        result = run(c, stage, dict(frozen, deploy=deploy, uuid=plan['GPU_UUID']), 180)
        put('MATCHED_ACTUAL_V15_OWNER_LAUNCH_ACTUAL.json', result)
        p = R / 'CURRENT_WORK_ORDER.json'
        w = json.loads(p.read_bytes())
        w['prior_V14'] = dict(run_id=w['run_id'], job=w['remote_job'], final=w['current_run_final'], evaluation=w['evaluation_result'], native_review=w['native_review_report'])
        w.update(status='V15_ORIGINAL_OWNER_DISPATCHED_AWAIT_GO_FIRST', run_id=frozen['run_id'], remote_job=frozen['job'],
            training_started='AWAIT_GO_FIRST', training_completed=False, source_resume=plan['resume'], original_owner=result['owner'],
            source_version=dict(shared_source=old.SHARED, overlay=str(D), frozen=str(D/'FROZEN.json'), manifest_SHA=result['manifest_SHA']),
            latest_status='reports/MATCHED_ACTUAL_V15_OWNER_LAUNCH_ACTUAL.json',
            current_run_final=None, actual_owner_exit=None, current_model_native_reviewed=False,
            evaluation_closed_and_transferred=False, evaluation_once_consumed=False,
            current_model_independent_evaluation='PENDING_NEW_FINAL_V15',
            pending_repair=dict(version='V15', status='CPU_PASS_FROZEN_LAUNCH_CONSUMED', CPU_once_consumed=True, physical_training='AWAIT_GO_FIRST'),
            next='UniqueV15 FIRST only. Sameoriginalowner fullsave/save3600/close/immediateindependent80. Healthy no relaunch/hotpatch or repeatedCPU/resources.')
        p.write_text(json.dumps(w, ensure_ascii=False, indent=2)+'\n', encoding='utf-8')
        print(json.dumps(result))
    except BaseException:
        put('MATCHED_ACTUAL_V15_LAUNCH_ERROR.json', dict(epoch=time.time(), error=traceback.format_exc(), never_replay=True))
        raise
    finally:
        if c is not None:
            c.close()
        put('MATCHED_ACTUAL_V15_LAUNCH_CLOSED.json', dict(epoch=time.time(), SSHclosed=True, SESSION_restored=True, serial='FREE'))


