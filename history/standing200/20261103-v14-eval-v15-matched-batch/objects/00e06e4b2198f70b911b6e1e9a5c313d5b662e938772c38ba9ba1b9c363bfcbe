    cpu = json.loads((R / 'reports/MATCHED_ACTUAL_V15_ACTUAL.json').read_bytes())
    assert cpu['own_waited'] and cpu['returncode'] == 0 and cpu['result']['passed']
    check = cpu['result']
    assert check['source']['SHA'] == w['current_run_final']['SHA']
    assert check['fixture']['all_weights_four_Adam_restored']
    assert check['fixture']['actual']['distribution_recomputation']['pre_Adam_ratio_max_abs_from_one'] < 1e-4
    worker = """from pathlib import Path
