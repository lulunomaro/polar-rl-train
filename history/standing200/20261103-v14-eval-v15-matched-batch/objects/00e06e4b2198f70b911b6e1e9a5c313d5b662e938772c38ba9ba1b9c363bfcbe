    (D / 'PLAN.json').write_text(json.dumps(plan, indent=2) + '\n', encoding='utf-8')
    shared = {}
    for name in ['standing_action_v8.py', 'standing_resume_v8.py', 'actual_returns.py', 'hybrid_actual.py']:
        source = R / ('repair_v8' if name.startswith('standing_') else 'repair_v14') / name
        raw = source.read_bytes()
        shared['source/' + name] = dict(path=w['remote_job'] + '/source/' + name, bytes=len(raw), SHA=hashlib.sha256(raw).hexdigest())
    names = ['matched_actual.py', 'standing_worker_v1.py', 'standing_owner_v1.py', 'evaluate_standing200_v1.py', 'PLAN.json', 'control.py', 'check_full_restore.py']
