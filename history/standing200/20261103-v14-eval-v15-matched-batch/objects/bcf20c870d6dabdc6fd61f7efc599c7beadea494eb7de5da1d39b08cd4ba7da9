def archive():
    assert not DEST.exists()
    spec=importlib.util.spec_from_file_location('standing_v15_archive_guard',REPO/'archive_tools/capture_history.py')
    guard=importlib.util.module_from_spec(spec)
    spec.loader.exec_module(guard)
    known={}
    for index in (REPO/'history/standing200').rglob('INDEX.json'):
        for row in json.loads(index.read_bytes()).get('rows',[]):
            if row.get('archive_SHA') and row.get('archive_path'):
                known[row['archive_SHA']]=row['archive_path']
    closed=R/'actual_closed/MOD4_STANDING200_RLBPTT_V14_1793685133426758900'
    suffixes={'.py','.json','.md','.txt','.toml','.diff','.log','.csv'}
    files=[]
    for base in [D,R/'repair_v14',R/'reports',closed]:
        files.extend(p for p in base.rglob('*') if p.is_file() and p.suffix.lower() in suffixes and '__pycache__' not in p.parts)
    files.extend([R/'CURRENT_WORK_ORDER.json',R/'repair_v11/analyze_final_v13.py',R/'render_standing_recorded_v2.py',Path('C:/Users/lulu/.codex/automations/mod4-200-rl-bptt/automation.toml')])
    DEST.mkdir(parents=True)
    (DEST/'objects').mkdir()
    rows=[]
    for path in sorted(set(files),key=str):
        raw=path.read_bytes()
        safe,n=guard.redact(raw.decode('utf-8-sig'))
        content=raw if n==0 else safe.encode()
        sha=hashlib.sha256(content).hexdigest()
        target=known.get(sha)
        if target is None:
            out=DEST/'objects'/sha
            out.write_bytes(content)
            target=out.relative_to(REPO).as_posix()
            known[sha]=target
        rows.append(dict(source_path=str(path),bytes=len(raw),SHA=hashlib.sha256(raw).hexdigest(),
            archive_path=target,archive_SHA=sha,archive_bytes=len(content),redactions=n,mode='complete_text' if n==0 else 'redacted_text'))
    w=json.loads((R/'CURRENT_WORK_ORDER.json').read_bytes())
    large=[]
    for row in json.loads((R/'reports/V14_CLOSED_ACTUAL_EVALUATION_TRANSFER.json').read_bytes())['files']:
        if Path(row['local_path']).suffix.lower() not in suffixes:
            large.append(dict(row,published_by='actualV14 uniqueclosedtransfer'))
    for rel in ['rendered_v2/RENDER_REPORT.json','analysis/MEDIA_INDEX.json']:
        large.extend(dict(row,published_by=str(closed/rel)) for row in json.loads((closed/rel).read_bytes())['media'])
    for key in ['source_resume','first_checkpoint','latest_checkpoint','current_run_final']:
        if w.get(key):
            large.append(dict(w[key],published_by='workorder.'+key))
    large.append(dict(json.loads((closed/'production/FINAL.json').read_bytes())['checkpoint'],published_by='V14 originalcompletefinal'))
    (DEST/'README.md').write_text((D/'README.md').read_text(encoding='utf-8'),encoding='utf-8')
    (DEST/'INDEX.json').write_text(json.dumps(dict(epoch=time.time(),kind='ACTUAL_V14_FAILURE_AND_MATCHED_BATCH_V15',
        rows=rows,large_external_artifacts=large,model_media_reads_for_archive=0,shared_runtime_copies=0,
        oldV14_trialobject='2252f5e5ff5af7b0bdd75b62963a903375cb120a',
        oldV14_trialpeel='4d88bb97207242227289b02b9f8d51b211764600',
        currentstatus=w['status'],future='recordonce newV15phase;ordinarysupplementafterrecord;no retag'),ensure_ascii=False,indent=2)+'\n',encoding='utf-8')
    print(json.dumps(dict(destination=str(DEST),textrows=len(rows),newobjects=len(list((DEST/'objects').iterdir())),large=len(large))))


