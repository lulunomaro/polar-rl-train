def change(s,old,new):
    assert s.count(old)==1,old
    return s.replace(old,new)


def inherited():
    s=P.read_text(encoding='utf-8')
    replacements=[
        ("sys.argv = [str(R / 'repair_v11/finite_cpu.py'), 'matched_actual_v15', 'check_full_restore.py', 'matched_actual.py']",
         "sys.argv = [str(R / 'repair_v11/finite_cpu.py'), 'actual_led_v16', 'check_full_restore.py', 'actual_led.py']"),
        ('MATCHED_ACTUAL_V15','ACTUAL_LED_V16'),
        ('FOUR4090_RESOURCE_ACTUAL_V15.json','FOUR4090_RESOURCE_ACTUAL_V16.json'),
        ("name.replace('_V1.', '_V15.').replace('_V1_', '_V15_')","name.replace('_V1.', '_V16.').replace('_V1_', '_V16_')"),
        ("for name in ['matched_actual.py', 'standing_worker_v1.py'", "for name in ['actual_led.py', 'standing_worker_v1.py'"),
        ("'from matched_actual import CONTRACT'","'from actual_led import CONTRACT'"),
        ('STANDING200_MATCHED_ACTUAL_H32_V15_SMALL_OVERRIDE','STANDING200_ACTUAL_LED_H32_V16_SMALL_OVERRIDE'),
        ('V15_ORIGINAL_OWNER_DISPATCHED_AWAIT_GO_FIRST','V16_ORIGINAL_OWNER_DISPATCHED_AWAIT_GO_FIRST'),
        ("w['prior_V14'] = dict", "w['prior_V15'] = dict"),
        ("pending_repair=dict(version='V15'", "pending_repair=dict(version='V16'"),
        ('PENDING_NEW_FINAL_V15','PENDING_NEW_FINAL_V16'),
        ('UniqueV15 FIRST only.','UniqueV16 FIRST only.'),
        ('STATUS_V15_FIRST_UPDATED.json','STATUS_V16_FIRST_UPDATED.json'),
        ('production/FULL_RESTORE_V15.json','production/FULL_RESTORE_V16.json'),
        ("'V15_FIRST_UPDATED'","'V16_FIRST_UPDATED'"),
        ('V15_CLOSED_EVIDENCE_TRANSFER_ONCE.json','V16_CLOSED_EVIDENCE_TRANSFER_ONCE.json'),
        ("'V15_' + name","'V16_' + name"),
    ]
    for old,new in replacements:
        assert old in s,old
        s=s.replace(old,new)
    ns=dict(__name__='standing_v16_inherited_control',__file__=str(D/'control.py'))
    exec(compile(s,str(P),'exec'),ns)
    return ns


