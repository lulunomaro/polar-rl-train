    assert receipt['own_waited'] and receipt['returncode']==0 and receipt['result']['passed']
    cpu=receipt['result']
    assert cpu['source']['SHA']==w['current_run_final']['SHA']
    assert cpu['fixture']['all_weights_four_Adam_restored']
    assert cpu['fixture']['actual']['gradient_balance']['applied_other_to_actual_ratio']<=.250001
    worker="""from pathlib import Path
