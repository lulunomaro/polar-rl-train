    w = json.loads(p.read_bytes())
    w.update(status='V15_CLOSED_ACTUAL80_0STRICT_NATIVE_REVIEWED_V16_GRADIENT_REPAIR_PREPARING',
        training_started=False, training_completed=True, current_run_final=final['checkpoint'], latest_checkpoint=final['checkpoint'],
