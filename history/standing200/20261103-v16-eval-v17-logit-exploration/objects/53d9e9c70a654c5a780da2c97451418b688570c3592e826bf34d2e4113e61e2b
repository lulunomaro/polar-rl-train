"""Small V17 recipe sharing the pinned serial owner/controller runtime."""
from pathlib import Path
import argparse
import ast
import hashlib
import json
import time

D = Path(__file__).resolve().parent
R = D.parent
PRIOR = R / 'repair_v15/control.py'
assert hashlib.sha256(PRIOR.read_bytes()).hexdigest() == '00e06e4b2198f70b911b6e1e9a5c313d5b662e938772c38ba9ba1b9c363bfcbe'


def inherited():
    s = PRIOR.read_text(encoding='utf-8')
    s = s.replace('V15', 'V17').replace('v15', 'v17')
    s = s.replace('MATCHED_ACTUAL', 'LOGIT_EXPLORATION').replace('matched_actual', 'logit_exploration')
    s = s.replace('STANDING200_LOGIT_EXPLORATION_H32_V17_SMALL_OVERRIDE', 'STANDING200_LOGIT_EXPLORATION_H32_V17_SMALL_OVERRIDE')
    s = s.replace("w['prior_V14'] = dict", "w['prior_V16'] = dict")
    ns = dict(__name__='standing_v17_shared_control', __file__=str(D / 'control.py'))
    exec(compile(s, str(PRIOR), 'exec'), ns)
    return ns


def prepare():
    assert not (D / 'FROZEN.json').exists()
    w = json.loads((R / 'CURRENT_WORK_ORDER.json').read_bytes())
    assert w['run_id'] == 'MOD4_STANDING200_RLBPTT_V16_1793702292525110700'
    assert w['current_model_native_reviewed'] and w['evaluation_closed_and_transferred']
    receipt = json.loads((R / 'reports/LOGIT_EXPLORATION_V17_ACTUAL.json').read_bytes())
    assert receipt['own_waited'] and receipt['returncode'] == 0 and receipt['result']['passed']
    cpu = receipt['result']
    assert cpu['source']['SHA'] == w['current_run_final']['SHA']
    assert cpu['fixture']['all_weights_four_Adam_restored']
    assert cpu['fixture']['source_Adam_offsets']['pi']['min'] == 3154
    for name in ['V17_LOCAL_MATH_ACTUAL.json', 'V17_LOCAL_PRODUCTION_SHAPE_ACTUAL.json']:
        assert json.loads((R / 'reports' / name).read_bytes())['passed']
    worker = """from pathlib import Path
import hashlib
_p=Path('/home/lc01/Zonglin Li/zonglin2/tasks/MOD4_STANDING200_RLBPTT_V14_1793685133426758900/source/standing_worker_v1.py')
_r=_p.read_bytes()
assert hashlib.sha256(_r).hexdigest()=='90b063013e4705e03128323a71e72c09ec6a84f3c063792304508f3fa4ae1ced'
_s=_r.decode()
_old='from hybrid_actual import Learner as ContextRewardLearner,Policy as StandingResidualPolicy,CONTRACT as REPAIR_CONTRACT'
assert _s.count(_old)==1
_s=_s.replace(_old,'from logit_exploration import Learner as ContextRewardLearner,Policy as StandingResidualPolicy,CONTRACT as REPAIR_CONTRACT')
_s=_s.replace('FULL_RESTORE_V14.json','FULL_RESTORE_V17.json')
exec(compile(_s,str(Path(__file__).absolute()),'exec'),globals())
"""
    (D / 'standing_worker_v1.py').write_text(worker, encoding='utf-8', newline='\n')
    for name, folder in [('standing_owner_v1.py', 'control'), ('evaluate_standing200_v1.py', 'source')]:
        raw = (R / 'repair_v16' / name).read_bytes()
        wrapper = ('from pathlib import Path\nimport hashlib\n'
            f'_p=Path({(w["remote_job"] + "/" + folder + "/" + name)!r})\n_r=_p.read_bytes()\n'
            f'assert hashlib.sha256(_r).hexdigest()=={hashlib.sha256(raw).hexdigest()!r}\n'
            'exec(compile(_r,str(Path(__file__).absolute()),"exec"),globals())\n')
        ast.parse(wrapper)
        (D / name).write_text(wrapper, encoding='utf-8', newline='\n')
    plan = json.loads((R / 'repair_v16/PLAN.json').read_bytes())
    runid = 'MOD4_STANDING200_RLBPTT_V17_' + str(time.time_ns())
    plan.update(run_id=runid, resume=w['current_run_final'],
        algorithm='actual64 state-dependent total-logit Gaussian PPO + same capped H32 learned-model BPTT; unchanged deterministic actor',
        action_repair='training exploration beforetanh;fullfinalV16/fourAdam;no deterministic/physical/reward/thresholdreset',
        actual_return_contract=cpu['contract'],
        optimizer_repair=dict(contract=cpu['contract'], CPU='reports/LOGIT_EXPLORATION_V17_ACTUAL.json',
            actual_evidence='V16actual0/80;39orientation41timeoutsmean5.65275s;three selected stuck10s/righttarget59rad_s/lowerwheel<.036m;newexplorationhypothesis'))
    (D / 'PLAN.json').write_text(json.dumps(plan, indent=2) + '\n', encoding='utf-8')
    shared = {}
    for name in ['standing_action_v8.py', 'standing_resume_v8.py', 'actual_returns.py', 'hybrid_actual.py', 'matched_actual.py', 'actual_led.py']:
        directory = 'repair_v8' if name.startswith('standing_') else 'repair_v16' if name == 'actual_led.py' else 'repair_v15' if name == 'matched_actual.py' else 'repair_v14'
        local = R / directory / name
        raw = local.read_bytes()
        shared['source/' + name] = dict(path=w['remote_job'] + '/source/' + name, bytes=len(raw), SHA=hashlib.sha256(raw).hexdigest())
    names = ['logit_exploration.py', 'standing_worker_v1.py', 'standing_owner_v1.py', 'evaluate_standing200_v1.py', 'PLAN.json', 'control.py', 'check_full_restore.py']
    frozen = dict(epoch=time.time(), run_id=runid, job='/home/lc01/Zonglin Li/zonglin2/tasks/' + runid,
        source_job='/home/lc01/Zonglin Li/zonglin2/tasks/MOD4_STANDING200_RLBPTT_V6_1793639156617427400',
        source_manifest_SHA='21e4a1ef44bc36af36a4d93a488e8727db4ad9c315a471efa4e0823b053a554b',
        prior_job=w['remote_job'], shared=shared,
        files=[dict(name=n, bytes=(D / n).stat().st_size, SHA=hashlib.sha256((D / n).read_bytes()).hexdigest()) for n in names],
        CPU_report_SHA=hashlib.sha256((R / 'reports/LOGIT_EXPLORATION_V17_ACTUAL.json').read_bytes()).hexdigest(),
        runtime_full_copies=0, source_PT_copies=0)
    (D / 'FROZEN.json').write_text(json.dumps(frozen, indent=2) + '\n', encoding='utf-8')
    print(json.dumps(dict(frozen=True, run_id=runid, physical_training=False)))


if __name__ == '__main__':
    q = argparse.ArgumentParser()
    q.add_argument('mode', choices=['cpu', 'prepare', 'gpu', 'launch', 'first', 'closed'])
    a = q.parse_args()
    if a.mode == 'prepare':
        prepare()
    else:
        inherited()[a.mode]()
