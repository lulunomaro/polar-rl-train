    relevant=[r for r in blocked if re.search(pat,r.get('CommandLine')or'',re.I)]
    if relevant:
        print(json.dumps(dict(blocked=relevant,network=0,once_consumed=False)));return False
    put('REPAIR_V8_LOCAL_'+label+'.json',dict(epoch=time.time(),rows=rows,blocked=[],serial='FREE'))
    return True


