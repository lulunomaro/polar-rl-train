from standing_resume_v8 import verify_shared_source
shared=verify_shared_source(J)
(J/'INSTALL_MANIFEST.json').write_text(json.dumps(dict(kind='STANDING200_V8_SMALL_REPAIR_OVERLAY',files=rows,shared=shared,PT_copies=0),indent=2))
# Fresh second canonical/resource admission immediately before the sole owner.
