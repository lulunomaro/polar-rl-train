 raw=json.dumps(value,indent=2).encode();(J/rel).write_bytes(raw)
 rows.append(dict(relative=rel,bytes=len(raw),SHA=hashlib.sha256(raw).hexdigest()))
write('SHARED_REFERENCE.json',dict(root=str(S),manifest_SHA=v['source_manifest_SHA'],original_dependencies_immutable=True))
