def put(name,value):
    with (R/'reports'/name).open('x',encoding='utf-8') as f:json.dump(value,f,ensure_ascii=False,indent=2)


def gate():
    spec=importlib.util.spec_from_file_location('eval22_original_local_gate',R/'repair_v11/control.py')
    m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)
    return m.admission()


