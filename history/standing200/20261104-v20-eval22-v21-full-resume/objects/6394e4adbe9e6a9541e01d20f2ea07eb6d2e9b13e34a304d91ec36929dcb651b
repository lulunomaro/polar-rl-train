    w=json.loads((R/'CURRENT_WORK_ORDER.json').read_bytes())
    final=w['current_run_final'];assert final['SHA']=='4b6255e6f9f3bf15ccfe5f65b02015dae990f7f9ab61ae7e6d4ced61b4197d13'
    closed=R/'actual_closed'/w['run_id']
    own=json.loads((closed/'OWNER_EXIT.json').read_bytes());assert own['all_own_waited'] and own['original_leases_released']
    source=R/'scut_recipe_v18/evaluate.py';raw=source.read_bytes();text=raw.decode()
    required=["install_pose_cache_runtime_adapter_v4(env.scene['robot'])","final = json.loads((out.parent / 'production/FINAL.json').read_bytes())['checkpoint']","bridge.physics_observer = observe"]
    assert all(text.count(k)==1 for k in required)
    entry=(HERE/'entry.py').read_text(encoding='utf-8')
    ast.parse(entry)
    assert 'receipt_callback=lambda value:' in entry and "task['independent_checkpoint']" in entry
    plan=dict(kind='STANDING200_FINAL20_FIRST_ACTUAL_EVAL22',closed_root=w['remote_job'],
        remote_root=w['remote_job']+'/independent_eval_v22',checkpoint=final,
        GPU_UUID='GPU-16828f91-2b45-b646-8dc0-9481138e2842',expected_source_format='MOD4V1_SCUT_STANDING_RECIPE_V20',
        frozen_evaluate_path=w['remote_job'].rsplit('/',1)[0]+'/MOD4_STANDING200_SCUT_RECIPE_V18_FLAT_1793718201739612500/evaluate.py',
        frozen_evaluate_SHA=hashlib.sha256(raw).hexdigest(),seed=9137,num_envs=80,controls=500,seconds=10,
        neural_checkpoint_reads=1,optimizer_steps=0,ledger_writes=0,original_SOURCE_clock_unchanged=True,
        task_change='only requiredposecachecallback and independentoutput/finalpaths;pre-resetmotorrecordfix',
        acceptance='same200mm fullfootprint400Hzbothwheel/stable.5s/no return/unsupported<=.10s',
        original_failed_evaluation_error=json.loads((closed/'evaluation/ERROR.json').read_bytes()))
    (HERE/'PLAN.json').write_text(json.dumps(plan,indent=2)+'\n',encoding='utf-8')
    files=[]
    for name in ['entry.py','owner.py','control.py','PLAN.json']:
        p=HERE/name;raw=p.read_bytes()
        if p.suffix=='.py':ast.parse(raw.decode())
        files.append(dict(relative=name,path=str(p),bytes=len(raw),SHA=hashlib.sha256(raw).hexdigest()))
    frozen=dict(epoch=time.time(),files=files,source_model_reads=0,SDK=0,physics=0)
    (HERE/'FROZEN.json').write_text(json.dumps(frozen,indent=2)+'\n',encoding='utf-8')
    put('SCUT22_STATIC_CALLBACK_IDENTITY_ADMISSION.json',dict(epoch=time.time(),passed=True,original_actor_evaluation_contract_unchanged=True,
        source_evaluate_SHA=plan['frozen_evaluate_SHA'],samefinalSHA=final['SHA'],source_model_reads=0,physics=0))
    print(json.dumps(dict(prepared=True,remote=plan['remote_root'],model_reads=0)))


