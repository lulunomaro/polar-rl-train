def execute():
    rows,blocked=gate()
    if blocked:print(json.dumps(dict(localbusy=blocked,network=0,once_consumed=False)));return
    plan=json.loads((HERE/'PLAN.json').read_bytes());frozen=json.loads((HERE/'FROZEN.json').read_bytes())
    marker=R/'reports/SCUT22_EVAL_ONCE.json';assert not marker.exists()
    for row in frozen['files']:
        raw=Path(row['path']).read_bytes();assert len(raw)==row['bytes'] and hashlib.sha256(raw).hexdigest()==row['SHA']
    client=sf=None
    try:
        sys.path.insert(0,str(R.parent/'mod4v1_experts_fulldr_rm70_20261101'))
        from project_connector import connect72
        client=connect72()
        admission=run(client,PREFLIGHT,dict(uuid=plan['GPU_UUID'],job=plan['remote_root']))
        if not admission['ready']:
            print(json.dumps(dict(resource_wait=admission,once_consumed=False)));return
        put('SCUT22_EVAL_LOCAL_ADMISSION.json',dict(epoch=time.time(),rows=rows,blocked=[],serial='FREE'))
        put(marker.name,dict(epoch=time.time(),admission=admission,frozenSHA=hashlib.sha256((HERE/'FROZEN.json').read_bytes()).hexdigest()))
        sf=client.open_sftp();sf.get_channel().settimeout(60);sf.mkdir(plan['remote_root'])
        for row in frozen['files']:
            with sf.open(plan['remote_root']+'/'+row['relative'],'wx') as f:f.write(Path(row['path']).read_bytes())
        with sf.open(plan['remote_root']+'/INSTALL_MANIFEST.json','wx') as f:f.write(json.dumps(dict(files=[{k:r[k] for k in ['relative','bytes','SHA']} for r in frozen['files']]),indent=2).encode())
        code=r'''
from pathlib import Path
import subprocess,psutil,json,time
J=Path(v['job'])
with (J/'OWNER.log').open('xb') as f:
 p=subprocess.Popen(['/home/lc01/Zonglin Li/zonglin2/run-python.sh','-u','-B',str(J/'owner.py')],cwd=J,stdin=subprocess.DEVNULL,stdout=f,stderr=subprocess.STDOUT,start_new_session=True)
 q=psutil.Process(p.pid);print(json.dumps(dict(epoch=time.time(),pid=q.pid,creation=q.create_time(),exe=q.exe(),argv=q.cmdline(),root=q.cwd())))
'''
        owner=run(client,code,dict(job=plan['remote_root']));put('SCUT22_OWNER_LAUNCHED.json',owner)
        start=time.monotonic();value={}
        names=['OWNER_STARTED.json','OWNER_ERROR.json','WORKER_IDENTITY.json','WORKER_WAITED.json','RELEASE.json',
            'evaluation/RESULT.json','evaluation/ERROR.json','evaluation/NATIVE_STARTUP.json','evaluation/ALL80.json',
            'evaluation/CONTROL_CURVES.json','evaluation/POSE_CACHE_EVENTS.json','evaluation/ENV_CLOSED.json','evaluation/APP_CLOSE_INTENT.json']
        while True:
            value=dict(epoch=time.time(),job=plan['remote_root'],files={},logs={})
            for name in names:
                try:
                    with sf.open(plan['remote_root']+'/'+name,'rb') as f:value['files'][name]=json.loads(f.read())
                except FileNotFoundError:pass
            for name in ['OWNER.log','WORKER.log']:
                try:
                    size=sf.stat(plan['remote_root']+'/'+name).st_size
                    with sf.open(plan['remote_root']+'/'+name,'rb') as f:f.seek(max(0,size-12000));value['logs'][name]=f.read().decode('utf-8','replace')
                except FileNotFoundError:pass
            p=R/'reports/SCUT22_STATUS_LOCAL.json';tmp=p.with_suffix('.partial');tmp.write_text(json.dumps(value,indent=2)+'\n',encoding='utf-8');tmp.replace(p)
            if value['files'].get('RELEASE.json'):break
            if time.monotonic()-start>600:raise TimeoutError('finite observer ended; originalowner remains; use independent receiver after closure')
            time.sleep(10)
        release=value['files']['RELEASE.json'];assert release['all_own_waited'] and release['locks_released']
        dest=R/'actual_closed'/Path(plan['closed_root']).name/'independent_eval_v22';dest.mkdir(exist_ok=False)
        copied=[]
        def store(name,raw):
            p=dest/name;p.parent.mkdir(parents=True,exist_ok=True)
            with p.open('xb') as f:f.write(raw)
            copied.append(dict(path=plan['remote_root']+'/'+name,local_path=str(p),bytes=len(raw),SHA=hashlib.sha256(raw).hexdigest()))
        for name,v in value['files'].items():store(name,(json.dumps(v,indent=2)+'\n').encode())
        result=value['files'].get('evaluation/RESULT.json')
        if result:
            for key in ['all80_manifold','actual_poses']:
                r=result[key];relative='evaluation/'+Path(r['path']).name;assert r['path']==plan['remote_root']+'/'+relative
                with sf.open(r['path'],'rb') as f:raw=f.read()
                assert len(raw)==r['bytes'] and hashlib.sha256(raw).hexdigest()==r['SHA'];store(relative,raw)
        value.update(transfer=copied,source_PT_reads_by_controller=0,new_physics_by_controller=0)
        put('SCUT22_FULL_RETURNED.json',value)
        print(json.dumps(dict(result=result,release=release,destination=str(dest))))
    except BaseException:
        put('SCUT22_ORIGINAL_CONTROLLER_ERROR.json',dict(epoch=time.time(),error=traceback.format_exc(),once_consumed=marker.exists(),never_replay=marker.exists()));raise
    finally:
        if sf is not None:sf.close()
        if client is not None:client.close()
        if marker.exists():put('SCUT22_SSH_CLOSED.json',dict(epoch=time.time(),SSHclosed=True,SESSIONrestored=True,serial='FREE'))


if __name__=='__main__':
