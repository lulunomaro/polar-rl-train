"""Freeze only the small hardware-interface delta after actual V23 review."""
from pathlib import Path
import ast
import hashlib
import json
import time

HERE=Path(__file__).resolve().parent
ROOT=HERE.parent


def row(path, relative=None):
    raw=path.read_bytes()
    value=dict(path=str(path),bytes=len(raw),SHA=hashlib.sha256(raw).hexdigest())
    if relative is not None:value['relative']=relative
    return value


def main():
    assert not (HERE/'FROZEN.json').exists()
    review=json.loads((ROOT/'reports/SCUT23_FINAL745_NATIVE_TARGET_LIMIT_REVIEW_V25_DECISION.json').read_bytes())
    assert review['native_review']['actual_four_side_four_top_sheets_reviewed']
    assert review['transfer']['independent_V24_once_consumed_complete']
