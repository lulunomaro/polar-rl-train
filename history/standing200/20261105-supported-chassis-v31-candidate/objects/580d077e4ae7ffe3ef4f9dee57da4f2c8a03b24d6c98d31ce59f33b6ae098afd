"""Behavioral checks for supported-ascent incentives and contact exceptions."""
from pathlib import Path
import ast
import json
import time
import numpy as np
from reward_model import terms, harmful_contact, height_command


def state():
    return dict(root=np.array([[.3, 0., .30]]), velocity=np.zeros((1, 3)),
        roll=np.zeros(1), pitch=np.zeros(1), yaw_error=np.zeros(1),
        wheel_low=np.zeros((1, 2, 3)), wheel_top_force=np.zeros((1, 2)),
        wheel_ground_force=np.full((1, 2), 80.), support_top_force=np.zeros(1),
        previous_potential=np.array([.3 / 1.35]), supported_ticks=np.zeros(1))


def main():
    checks = {}
    def evaluate(s):
        result = terms(np, **s)
        assert all(np.isfinite(v).all() for v in result[0].values())
        return result[0]
    idle = state(); idle['root'][0, 2] = .39
    a = evaluate(idle)
    assert sum(v.item() for v in a.values()) <= 0.
    checks['stationary_extended_chassis_has_no_positive_return'] = True
    advance = state(); advance['velocity'][0, 0] = .25
    advance['root'][0] = [.35, 0., .39]
    b = evaluate(advance)
    assert sum(v.item() for v in b.values()) > sum(v.item() for v in a.values())
    checks['actual_raise_and_forward_progress_beats_idle'] = True
    hold = state(); hold['root'][0, 2] = .39
    assert evaluate(hold)['stand31_progress'].item() == 0.
    checks['unchanged_position_receives_no_progress_credit'] = True
    reverse = state(); reverse['root'][0, 0] = .25
    assert evaluate(reverse)['stand31_progress'].item() < 0.
    checks['reversing_keeps_negative_progress'] = True
    support = state(); support['root'][0] = [.78, 0., .38]
    support['support_top_force'][:] = 80.
    low = evaluate(support)
    support['wheel_low'][..., 2] = .20
    lifted = evaluate(support)
    assert lifted['stand31_retract'].item() > low['stand31_retract'].item()
    checks['actual_top_support_then_wheel_lift_is_rewarded'] = True
    nosupport = state(); nosupport['wheel_low'][..., 2] = .20
    assert evaluate(nosupport)['stand31_retract'].item() == 0.
    checks['wheel_lift_without_platform_support_is_not_retraction_credit'] = True
    hang = state(); hang['root'][0] = [.78, 0., .38]
    hang['support_top_force'][:] = 80.; hang['supported_ticks'][:] = 150
    h = evaluate(hang)
    assert h['stand31_support'].item() == 0. and h['stand31_hang'].item() < 0.
    checks['persistent_hanging_loses_support_bonus'] = True
    top = state(); top['root'][0] = [1.1, 0., .50]
    top['wheel_top_force'][:] = 80.; top['wheel_ground_force'][:] = 0.
    top['previous_potential'][:] = 1.1 / 1.35
    assert sum(v.item() for v in evaluate(top).values()) > sum(v.item() for v in lifted.values())
    checks['both_wheels_top_quiet_dominates_intermediate_support'] = True
    force = np.array([[40., 0.], [40., 0.], [40., 0.], [40., 0.]])
    verified = np.array([[40., 0.], [0., 0.], [40., 0.], [40., 0.]])
    bad = harmful_contact(np, force, verified, np.array([.38, .38, .20, .38]),
        np.array([0., 0., 0., .8]), np.zeros(4))
    assert bad.tolist() == [False, True, True, True]
    checks['only_upright_raised_verified_top_contact_is_exempt'] = True
    target = height_command(np, np.array([0., .55, 1.1]), np.array([False, False, True]), np.zeros(3, dtype=bool))
    assert np.allclose(target, [.30, .39, .50])
    checks['approach_height_and_platform_height_commands'] = True
    root = Path(__file__).resolve().parent
    for p in root.glob('*.py'):
        ast.parse(p.read_text(encoding='utf-8'))
    checks['all_candidate_python_AST'] = True
    result = dict(epoch=time.time(), passed=True, checks=checks, check_count=len(checks),
        production_model_reads=0, SDK=0, new_physics=0, neural_training=0,
        limitation='NumPy semantic checks only. Actual frozen SDK/contact sensor and full-restore integration still require native validation before production.')
    report = root.parent/'reports/SCUT31_SUPPORTED_REWARD_CONTACT_CPU_20261105.json'
    with report.open('x', encoding='utf-8') as f:
        json.dump(result, f, indent=2)
    print(json.dumps(result))


if __name__ == '__main__':
    main()
