        p = V25 / 'full_resume.py'
        raw = p.read_bytes()
        assert hashlib.sha256(raw).hexdigest() == '569422b125250d00971457ff88f881849ba52d680bda9f3b1f2f30b0caee5844'
        ns = dict(__file__=str(p), __name__='stand31_resume')
        exec(compile(raw, str(p), 'exec'), ns)
        ns['FORMAT'] = FORMAT
        ns['LEGACY'] = 'MOD4V1_SCUT_STANDING_RECIPE_V25_JOINT_TARGET_LIMITS'
