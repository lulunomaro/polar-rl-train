"""Exercise the requested reward changes and actual generated contact predicate."""
from pathlib import Path
import ast
import hashlib
import json
import time
import numpy as np

from reward_model import (terms, contact_termination, height_command,
                          wheel_geometry, NOMINAL_WHEEL_SPAN)
from recipe import candidate_source


def state(n=1):
    return dict(root=np.tile([.3, 0., .30], (n, 1)),
        velocity=np.zeros((n, 3)), roll=np.zeros(n), pitch=np.zeros(n),
        yaw_error=np.zeros(n), wheel_low=np.zeros((n, 2, 3)),
        wheel_top_force=np.zeros((n, 2)), wheel_ground_force=np.full((n, 2), 80.),
        support_top_force=np.zeros(n), chassis_edge_force=np.zeros(n),
        wheel_span=np.full(n, NOMINAL_WHEEL_SPAN), wheel_stagger=np.zeros(n),
        previous_potential=np.full(n, .3 / 1.35), supported_ticks=np.zeros(n))


def main():
    checks = {}
    def evaluate(s):
        result = terms(np, **s)
        assert all(np.isfinite(v).all() for v in result[0].values())
        return result[0]
    low = state(); high = state(); high['root'][:, 2] = .39
    a, b = evaluate(low), evaluate(high)
    assert b['stand32_raise'].item() > 0. and b['stand32_raise'].item() > a['stand32_raise'].item()
    assert b['stand32_height'].item() > a['stand32_height'].item()
    assert high['velocity'][0, 0] == 0.
    checks['standing_high_reward_needs_no_forward_motion'] = True
    airborne = state(); airborne['root'][:, 2] = .39; airborne['wheel_ground_force'][:] = 0.
    u = evaluate(airborne)
    assert u['stand32_raise'].item() == 0. and u['stand32_height'].item() == 0.
    checks['unsupported_spawn_height_is_not_standing_credit'] = True
    scrape = state(); scrape['root'][0] = [.65, 0., .39]; scrape['chassis_edge_force'][:] = 40.
    assert evaluate(scrape)['stand32_chassis_edge'].item() > 0.
    scrape['chassis_edge_force'][:] = 0.
    assert evaluate(scrape)['stand32_chassis_edge'].item() == 0.
    checks['actual_chassis_lip_contact_adds_scraping_reward'] = True
    scrape['chassis_edge_force'][:] = 40.; scrape['root'][:, 2] = .2
    assert evaluate(scrape)['stand32_chassis_edge'].item() == 0.
    checks['low_ground_collision_gets_no_chassis_lip_reward'] = True
    support = state(); support['root'][0] = [.8, 0., .38]; support['support_top_force'][:] = 80.
    before = evaluate(support)['stand32_retract'].item()
    support['wheel_low'][..., 2] = .2
    assert evaluate(support)['stand32_retract'].item() > before
    checks['supported_actual_wheel_lift_increases_retraction_reward'] = True
    support['support_top_force'][:] = 0.
    assert evaluate(support)['stand32_retract'].item() == 0.
    checks['unsupported_leg_lift_gets_no_retraction_credit'] = True
    top = state(); top['root'][0] = [1.2, 0., .50]
    top['wheel_top_force'][:] = 80.; top['wheel_ground_force'][:] = 0.
    result = evaluate(top)
    assert result['stand32_top'].item() > 0. and result['stand32_top_quiet'].item() > 0.
    checks['both_top_and_quiet_have_separate_rewards'] = True
    yaw = state(3); yaw['yaw_error'][:] = [0., .175, .35]
    penalty = evaluate(yaw)['stand32_heading']
    assert penalty[0] == 0. and penalty[0] > penalty[1] > penalty[2]
    checks['yaw_penalty_is_continuous_and_increases_with_error'] = True
    span = state(5); span['wheel_span'] += [0., .015, -.015, .07, -.07]
    penalty = evaluate(span)['stand32_wheel_distance']
    assert np.all(penalty[:3] == 0.) and np.all(penalty[3:] < 0.) and np.isclose(penalty[3], penalty[4])
    checks['track_width_penalizes_too_wide_and_too_narrow_after_tolerance'] = True
    span = state(); span['wheel_span'][:] = -NOMINAL_WHEEL_SPAN
    assert evaluate(span)['stand32_wheel_distance'].item() < 0.
    checks['crossed_wheels_cannot_hide_behind_absolute_track_width'] = True
    wheel = np.array([[[0., NOMINAL_WHEEL_SPAN/2, 0.], [0., -NOMINAL_WHEEL_SPAN/2, .2]]])
    width, stagger = wheel_geometry(np, wheel, np.zeros(1))
    assert np.allclose(width, NOMINAL_WHEEL_SPAN) and np.allclose(stagger, 0.)
    checks['wheel_lift_height_difference_is_not_track_width_error'] = True
    angle = .8; rotation = np.array([[np.cos(angle), -np.sin(angle)], [np.sin(angle), np.cos(angle)]])
    rotated = wheel.copy(); rotated[..., :2] = wheel[..., :2] @ rotation.T
    rw, rs = wheel_geometry(np, rotated, np.array([angle]))
    assert np.allclose(rw, width) and np.allclose(rs, stagger)
    checks['track_geometry_is_invariant_to_world_yaw'] = True
    staggered = state(); staggered['wheel_stagger'][:] = .1
    assert evaluate(staggered)['stand32_wheel_stagger'].item() < 0.
    checks['fore_aft_wheel_stagger_has_explicit_cost'] = True
    impacts = np.array([[0., 0.], [1., 1000.], [1.e6, 1.e9]])
    assert not contact_termination(np, impacts).any()
    checks['all_chassis_and_guide_impact_magnitudes_cannot_terminate'] = True
    target = height_command(np, np.array([0., .7, 1.2]),
        np.array([False, False, True]), np.array([False, True, False]))
    assert np.allclose(target, [.39, .42, .50])
    checks['raise_support_top_commands_match_sequence'] = True

    generated = candidate_source(); tree = ast.parse(generated)
    bad = next(n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef) and n.name == 'bad_contact')
    assert len(bad.body) == 1 and isinstance(bad.body[0], ast.Return)
    call = bad.body[0].value
    assert isinstance(call, ast.Call) and isinstance(call.func, ast.Name) and call.func.id == 'contact_termination'
    assert "cfg.rewards['no_fork'] = 0." in generated and "cfg.rewards['no_fork_square'] = 0." in generated
    assert "'wheel_distance'" in generated and "'heading'" in generated
    checks['generated_active_recipe_uses_contact_free_predicate_and_explicit_penalties'] = True
    assert 'target=torch.full((self.n,), .39, device=self.device)' in generated
    assert 'self.stand32_target[ids] = .39' in generated
    checks['initial_and_reset_observed_height_command_matches_standing_reward'] = True

    # Execute the same source transformation on the existing pinned function,
    # then compare its AST: only the contact predicate assignment changes.
    repo = Path('C:/Users/lulu/Desktop/claude/mjcf/polar-rl-train')
    registry = json.loads((repo/'project/isaac/mod4v1_scut/SOURCES.json').read_bytes())
    primary = Path(registry['files']['base_env']['path'])
    primary_raw = primary.read_bytes()
    assert hashlib.sha256(primary_raw).hexdigest() == registry['files']['base_env']['sha256']
    original_text = primary_raw.decode('utf-8-sig')
    original_node = next(n for n in ast.walk(ast.parse(original_text)) if isinstance(n, ast.FunctionDef) and n.name == '_get_dones')
    original_source = ast.get_source_segment(original_text, original_node)
    original_predicate = 'terminate = torch.any(reset_contact_force > 1.0, dim=-1)'
    new_predicate = 'terminate = self._stand32_harmful_contact(reset_contact_force)'
    modified_source = original_source.replace(original_predicate, new_predicate)
    assert modified_source != original_source
    assert ast.dump(ast.parse(modified_source.replace(new_predicate, original_predicate))) == ast.dump(ast.parse(original_source))
    assert all(x in modified_source for x in ['nan_terminate', 'outlier_terminate', 'roll_limit_rad', 'pitch_limit_rad', 'immediate_terminate', '_apply_termination_duration'])
    checks['original_orientation_observation_numerical_duration_timeout_logic_preserved'] = True

    rng = np.random.default_rng(20261105); n = 3000; vector = state(n)
    vector['root'][:] = rng.uniform([-.2, -.5, .15], [1.6, .5, .6], (n, 3))
    vector['velocity'][:] = rng.uniform(-1., 1., (n, 3))
    vector['roll'][:] = rng.uniform(-.8, .8, n); vector['pitch'][:] = rng.uniform(-.8, .8, n)
    vector['yaw_error'][:] = rng.uniform(-3.14, 3.14, n)
    vector['wheel_span'][:] = rng.uniform(-.5, .8, n); vector['wheel_stagger'][:] = rng.uniform(-.3, .3, n)
    vector['wheel_low'][:] = rng.uniform(-.05, .3, (n, 2, 3))
    vector['support_top_force'][:] = rng.uniform(0., 100., n); vector['chassis_edge_force'][:] = rng.uniform(0., 100., n)
    vector['supported_ticks'][:] = rng.integers(0, 300, n)
    vector['previous_potential'][:] = rng.uniform(0., 1., n)
    output = evaluate(vector)
    assert all(v.shape == (n,) for v in output.values())
    checks['vectorized_3000_cases_finite'] = True

    root = Path(__file__).resolve().parent
    for p in root.glob('*.py'):
        ast.parse(p.read_text(encoding='utf-8'))
    checks['all_candidate_and_transformed_python_AST'] = True
    result = dict(epoch=time.time(), passed=True, check_count=len(checks), checks=checks,
        generated_recipe_SHA=hashlib.sha256(generated.encode()).hexdigest(),
        nominal_wheel_span_m=NOMINAL_WHEEL_SPAN, production_PT_reads=0,
        SDK=0, new_physics=0, neural_training=0,
        limitation='CPU reward/contact semantics only. Frozen SDK binding and native full-state restore remain pending; no training or skill pass claim.')
    report = root.parent/'reports/SCUT32_CONTACT_FREE_YAW_TRACK_FINAL_CPU_20261105.json'
    with report.open('x', encoding='utf-8') as f:
        json.dump(result, f, ensure_ascii=False, indent=2)
    print(json.dumps(result))


if __name__ == '__main__':
    main()
