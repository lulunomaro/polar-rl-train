o().flatten().tolist():\n                results[i] = {k: v[i].detach().cpu().tolist() if torch.is_tensor(v) else v for k, v in snap.items()}\n                results[i].update(env=i, controls=control + 1, seconds=(control + 1) * .02,\n                    strict200_standing=results[i].pop('strict270'),\n                    whole_footprint=results[i].pop('first_flight_wholeclear'))\n            curves.append(dict(control=control + 1, active=active.cpu().tolist(), reward=reward.cpu().tolist(), action=action.cpu().tolist(),\n                joint_vel=tensor(env.scene['robot'].data.joint_vel)[:, bridge.reward._wheel_idx].cpu().tolist(),\n                joint_pos_target=pre_reset_targets.cpu().tolist(), joint_pos_measured=snap['measured_actuated_joint_pos'].cpu().tolist(), joint_vel_measured=snap['measured_actuated_joint_vel'].cpu().tolist(), applied_torque=snap['measured_applied_torque'].cpu().tolist(), reward_terms={key:value.detach().cpu().tolist() for key,value in bridge.reward._last_reward_terms.items()}))\n            active &= ~done\n            if not active.any():\n                break\n        def npz(name, rows):\n            p = out / name\n            np.savez_compressed(p, **{k: np.stack([row[k] for row in rows]) for k in rows[0]})\n            with p.open('rb') as f:\n                sha = hashlib.file_digest(f, 'sha256').hexdigest()\n            return dict(path=str(p), bytes=p.stat().st_size, SHA=sha)\n        all400 = npz('actual400hz.npz', ticks)\n        actualposes = npz('selected_actual_poses.npz', poses)\n        put(out / 'CONTROL_CURVES.json', dict(curves=curves))\n        put(out / 'ALL80.json', dict(first_episodes=results))\n        force = np.stack([row['top_force'] for row in ticks]); mask = np.stack([row['active'] for row in ticks])\n        both = (force > 1).all(-1) & mask\n        put(out / 'RESULT.json', dict(epoch=time.time(), passed_execution=all(r is not None for r in results),\n            source=final, source_recipe_stage=task['stage'], strict=sum(r['strict200_standing'] for r in results),\n            independent_first_episodes=80, controls_max=500, policy_hz=50, physics_hz=400,\n            bothtop_envs=int(both.any(0).sum()), max_top_force=float(force.max()), mean_seconds=sum(r['seconds'] for r in results) / 80,\n            all80_manifold=all400, actual_poses=actualposes, recorded_envs=selected, body_names=list(bridge.robot.body_names),\n            origins=env.scene.env_origins.detach().cpu().tolist(), saved_pose_quaternion_order='wxyz',\n            course=metadata(), optimizer_operations=0, native_review_pending=True))\n    except BaseException:\n        error = traceback.format_exc()\n        put(out / 'ERROR.json', dict(epoch=time.time(), error=error))\n        raise\n    finally:\n        if bridge is not None:\n            bridge.close()\n        if env is not None:\n            env.close(); put(out / 'ENV_CLOSED.json', dict(epoch=time.time(), returned=True))\n        put(out / 'APP_CLOSE_INTENT.json', dict(epoch=time.time(), error=error))\n        ns['app'].close()\n"
