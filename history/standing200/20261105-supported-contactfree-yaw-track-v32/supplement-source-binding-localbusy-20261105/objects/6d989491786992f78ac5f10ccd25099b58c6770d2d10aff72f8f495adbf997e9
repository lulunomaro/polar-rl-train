_v4(env.scene['robot'], receipt_callback=lambda value: put(out/'POSE_CACHE_EVENTS.json', dict(actual_latest=value)))\n        bridge = ScutBridge(env, mod4, model_contract(args.assets), tensor, 'trained_stair')\n        vec = ScutVecEnv(env, bridge, env.observation_manager.compute())\n        rc = runner_config(); actorcfg = rc['actor'].copy(); actorcfg.pop('class_name')\n        actor = MLPModel(vec.get_observations(), rc['obs_groups'], 'actor', 6, **actorcfg).to(args.device)\n        final = json.loads((out.parent / 'production/FINAL.json').read_bytes())['checkpoint']\n        raw = Path(final['path']).read_bytes()\n        assert len(raw) == final['bytes'] and hashlib.sha256(raw).hexdigest() == final['SHA']\n        data = torch.load(io.BytesIO(raw), map_location=args.device, weights_only=False)\n        del raw\n        assert data['format'] == FORMAT and data['interface'] == INTERFACE and data['profile'] == 'trained_stair'\n        actor.load_state_dict(data['actor_state_dict'], strict=True)\n        actor.eval().requires_grad_(False)\n        with guard.around_original_fullstate_restore():\n            obs = env.reset(); vec.current = obs[0] if isinstance(obs, tuple) else obs\n        guard.check_observations(vec.current)\n        bridge.ready = True\n        put(out / 'NATIVE_STARTUP.json', dict(epoch=time.time(), actual_native=True, source=final,\n            one_model_decode=True, optimizer_operations=0, seed=9137, D0_D7=guard.receipt(), course=metadata(),\n            simulator_quaternion_order=bridge.quaternion_order, saved_pose_quaternion_order='wxyz'))\n        active = torch.ones(80, dtype=torch.bool, device=args.device)\n        ticks, poses, curves, results = [], [], [], [None] * 80\n        selected = [0, 1, 40, 41]\n        def observe(b):\n            d = b.reward.robot.data\n            row = dict(tick=np.int32(b.physics_ticks), active=active.cpu().numpy().copy())\n            for key, value in dict(top_force=b.top_force, ground_force=b.ground_force,\n                support_force=b.recipe_support, root_pos=d.root_pos_w, root_quat=d.root_quat_w,\n                velocity=d.root_lin_vel_w, wholeclear=b.acceptance.wholeclear, strict=b.acceptance.success,\n                unsupported_peak=b.acceptance.unsupported_peak).items():\n                row[key] = value.detach().cpu().numpy().copy()\n            from reward_model import wheel_geometry\n            from mod4v1_scut.math_ops import euler_xyz_from_quat\n            yaw = euler_xyz_from_quat(d.root_quat_w)[2]\n            span, stagger = wheel_geometry(torch,d.body_pos_w[:,b.reward._wheel_link_idx],yaw)\n            for key,value in dict(chassis_top_force=b.stand32_body_top[:,b.stand32_chassis_id],\n                chassis_edge_force=b.stand32_body_edge[:,b.stand32_chassis_id],\n                support_body_top=b.stand32_body_top,wheel_span=span,wheel_stagger=stagger,\n                target_height=b.reward.stand32_target).items():\n                row[key]=value.detach().cpu().numpy().copy()\n            ticks.append(row)\n            if b.physics_ticks % 8 == 0:\n                poses.append(dict(tick=np.int32(b.physics_ticks), active=active[selected].cpu().numpy().copy(),\n                    body_pos=d.body_pos_w[selected].detach().cpu().numpy().copy(), body_quat=d.body_quat_w[selected].detach().cpu().numpy().copy()))\n        bridge.physics_observer = observe\n        pre_reset_targets = torch.zeros(80, 4, device=args.device)\n        original_snapshot = bridge.snapshot\n        def snapshot(terminated, timeout):\n            pre_reset_targets.copy_(tensor(env.scene['robot'].data.joint_pos_target)[:, bridge.reward._legs_act_idx])\n            value = original_snapshot(terminated, timeout)\n            r = bridge.reward\n            from mod4v1_scut.math_ops import euler_xyz_from_quat, wrap_to_pi\n            from reward_model import wheel_geometry\n            roll, pitch, yaw = euler_xyz_from_quat(r.robot.data.root_quat_w)\n            span, stagger 