    inventory=json.loads(invs[-1].read_bytes())
    from datetime import datetime
    assert time.time()-datetime.fromisoformat(inventory['captured']).timestamp()<600,'Need new distinct resource-read version'
    results=sorted((R/'reports').glob('SCUT32_NATIVE2_RESULT_*.json'))
    native=json.loads(results[-1].read_bytes())['files']
    own=native['NATIVE2_OWNER_EXIT.json']
    assert own['error'] is None and own['all_own_waited'] and own['original_cost_settled'] and own['original_leases_released']
    assert native['NATIVE2_WAITED.json']['returncode']==0 and native['native_validation_r2/RESULT.json']['passed']
