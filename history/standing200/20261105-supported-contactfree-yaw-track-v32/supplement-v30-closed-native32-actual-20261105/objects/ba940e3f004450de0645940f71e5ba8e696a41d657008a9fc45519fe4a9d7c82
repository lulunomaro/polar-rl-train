        put('SCUT32_PRODUCTION_PARENT_ADMISSION.json',check)
        put('SCUT32_LAUNCH_ONCE.json',dict(epoch=time.time(),run_id=plan['run_id'],frozen_SHA=hashlib.sha256((HERE/'DEPLOYMENT_FROZEN.json').read_bytes()).hexdigest()))
