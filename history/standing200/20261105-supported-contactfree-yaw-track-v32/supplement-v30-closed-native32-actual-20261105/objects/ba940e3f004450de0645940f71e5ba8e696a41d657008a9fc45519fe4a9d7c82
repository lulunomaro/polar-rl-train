def native_result():
    frozen,plan=checked()
    _,blocked=admission()
    if blocked:print(json.dumps(dict(blocked=blocked,network=0)));return
    client=sf=None
    value=dict(epoch=time.time(),job=frozen['job'],files={},logs={})
    try:
        client=connection();sf=client.open_sftp();sf.get_channel().settimeout(45)
        for name in ['NATIVE2_OWNER_STARTED.json','NATIVE2_OWNER_EXIT.json','NATIVE2_OWNER_ERROR.json','NATIVE2_WAITED.json','NATIVE2_ADMISSION.json','NATIVE2_GO.json','NATIVE2_WORKER_IDENTITY.json',
            'native_validation_r2/RESULT.json','native_validation_r2/ERROR.json','native_validation_r2/CONTACT_TRACE.json','native_validation_r2/REWARD_LOG.json','native_validation_r2/APP_CLOSE_INTENT.json','native_validation_r2/ENV_CLOSED.json']:
            try:
                with sf.open(frozen['job']+'/'+name,'rb') as f:value['files'][name]=json.loads(f.read())
            except FileNotFoundError:pass
        for name in ['NATIVE2_OWNER.log','NATIVE2_WORKER.log']:
            try:
                size=sf.stat(frozen['job']+'/'+name).st_size
                with sf.open(frozen['job']+'/'+name,'rb') as f:f.seek(max(0,size-10000));raw=f.read()
                value['logs'][name]=dict(bytes=size,tail=raw.decode('utf-8','replace'))
            except FileNotFoundError:pass
    finally:
        if sf is not None:sf.close()
        if client is not None:client.close()
    value.update(SSHclosed=True,SESSION_restored=True,serial='FREE',source_PT_reads=0)
    put('SCUT32_NATIVE2_RESULT_'+str(time.time_ns())+'.json',value)
    print(json.dumps(dict(files={k:v for k,v in value['files'].items() if k not in ['native_validation_r2/CONTACT_TRACE.json','native_validation_r2/REWARD_LOG.json']},logs=value['logs'])))


def launch():
