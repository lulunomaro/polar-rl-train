def virtual_legs(reward):
    from mod4v1_scut.math_ops import quat_apply_inverse
    d=reward.robot.data
    wheel=d.body_pos_w[:,reward._wheel_link_idx]-d.root_pos_w[:,None]
    q=d.root_quat_w[:,None].expand(-1,2,-1)
    anchors=wheel.new_tensor([reward.contract['joints'][side+'_hip']['local_pos0'] for side in ('left','right')])
    vector=quat_apply_inverse(q,wheel)-anchors[None]
    length=vector.norm(dim=-1)
    import torch
    theta=torch.atan2(vector[...,0],-vector[...,2])
    return length,theta


def geometry_costs(xp,theta,span,yaw,nominal_span):
    error=xp.clip(xp.abs(span-nominal_span)-.02,0.,None)
    return dict(pen_theta_no0=xp.sum(theta*theta,axis=-1),
        stand32_heading=-xp.clip((yaw/.35)**2,0.,4.),
        stand32_wheel_distance=-xp.clip((error/.05)**2,0.,4.))
