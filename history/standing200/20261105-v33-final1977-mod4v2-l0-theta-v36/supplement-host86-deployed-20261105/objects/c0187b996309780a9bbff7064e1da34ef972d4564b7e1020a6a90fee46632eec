"""New task-only backend expression for already measured PhysX110 limits."""
from pathlib import Path
import hashlib
import json
import sys

J=Path(__file__).resolve().parent


def install():
    import integration
    original_load=integration.load
    effective=J/'v2package/assets/physx_runtime.usda'
    original=J/'v2package/assets/robot.usd'
    assert hashlib.sha256(original.read_bytes()).hexdigest()=='2237070ddc0a4e33f0c28e23fe5bb3db1f12bb619fddcdd89f9a74d5ac875f18'
    def load(name,path):
        module=original_load(name,path)
        if name=='mod4v1_fresh_dr_guard':
            configure=module.configure_new_task
            def new_configure(cfg,identity):
                result=configure(cfg,identity)
                cfg.scene.robot.spawn.usd_path=str(effective)
                return result
            module.configure_new_task=new_configure
            # Reuse the whole guard; only its effective spawn-path check gains
            # this declared expression. Constructor nominal checks are exact.
            raw=Path(module.__file__).read_text()
            pinned=Path('/home/lc01/Zonglin Li/zonglin2/tasks/MOD4_STANDING200_RLBPTT_V6_1793639156617427400/runtime/isaac/mod4/mod4v1_fresh_dr_guard.py').read_text()
            import ast
            node=next(n for n in ast.parse(pinned).body if isinstance(n,ast.ClassDef) and n.name=='FreshDRNominalGuard')
            source=ast.get_source_segment(pinned,node)
            old="Path(env.cfg.scene.robot.spawn.usd_path).resolve() == Path(identity.usd_path)"
            assert source.count(old)==1
            source=source.replace(old,"Path(env.cfg.scene.robot.spawn.usd_path).resolve() == V36_EFFECTIVE_USD and Path(identity.usd_path).resolve() == V36_RELEASED_USD")
            module.__dict__.update(V36_EFFECTIVE_USD=effective,V36_RELEASED_USD=original)
            exec(compile(source,str(module.__file__),'exec'),module.__dict__)
        return module
    integration.load=load
    guard_loader=None
    # train.load_guard normally executes the task file again under a second
    # name. Route that exact task guard to the declared adapted guard above.
    original_install=integration.install
    def install_v2(train,config,checkpoint):
        result=original_install(train,config,checkpoint)
        old_loader=train.load_guard
        def guard(path):
            if Path(path).resolve()==J/'guard.py':return sys.modules['mod4v1_fresh_dr_guard']
            return old_loader(path)
        train.load_guard=guard
        return result
    integration.install=install_v2
