def checked():
    frozen=json.loads((HERE/'FROZEN.json').read_bytes());plan=json.loads((HERE/'PLAN.json').read_bytes())
    for row in frozen['files']:
        raw=Path(row['path']).read_bytes()
        assert len(raw)==row['bytes'] and hashlib.sha256(raw).hexdigest()==row['SHA']
    return frozen,plan


def admit_code():
    m=load('v36_original_admission',R/'scut_native_v32/native_control.py')
    return m.ADMIT


def start(kind):
    assert kind in ('native','production')
    frozen,plan=checked()
    marker='SCUT36_'+('NATIVE' if kind=='native' else 'LAUNCH')+'_ONCE.json'
    assert not (R/'reports'/marker).exists()
    if kind=='production':
        native=json.loads((R/'reports/SCUT36_NATIVE_RESULT.json').read_bytes())['files']
        own=native['NATIVE_OWNER_EXIT.json']
        assert own['error'] is None and own['all_own_waited'] and own['original_cost_settled'] and own['original_leases_released']
        assert native['NATIVE_WAITED.json']['returncode']==0 and native['native_validation/RESULT.json']['passed']
    _,blocked=admission()
    if blocked:print(json.dumps(dict(blocked=blocked,network=0,once_consumed=False)));return
    client=sf=None
    try:
        client=connection()
        check=run(client,admit_code(),dict(job=frozen['job'],uuid=plan['GPU_UUID'],shared=frozen['shared_text'],deployed=kind=='production'),90)
        put('SCUT36_'+kind.upper()+'_PARENT_ADMISSION.json',check)
        put(marker,dict(epoch=time.time(),run_id=plan['run_id'],frozen_SHA=hashlib.sha256((HERE/'FROZEN.json').read_bytes()).hexdigest()))
        if kind=='native':
            sf=client.open_sftp();sf.mkdir(frozen['job'])
            def upload(relative,raw):
                path=frozen['job']
                for part in relative.split('/')[:-1]:
                    path+='/'+part
                    try:sf.mkdir(path)
                    except OSError:sf.stat(path)
                with sf.open(frozen['job']+'/'+relative,'wx') as f:f.write(raw)
            for row in frozen['files']:upload(row['relative'],Path(row['path']).read_bytes())
            upload('TASK.json',(HERE/'PLAN.json').read_bytes())
            upload('INSTALL_MANIFEST.json',json.dumps(dict(files=[{k:r[k] for k in ('relative','bytes','SHA')} for r in frozen['files']],shared_text=frozen['shared_text'])).encode())
            sf.close();sf=None
        code=r'''
from pathlib import Path
import subprocess,psutil,time,json
J=Path(v['job']);entry='native_owner.py' if v['kind']=='native' else 'owner.py'
logname='NATIVE_OWNER.log' if v['kind']=='native' else 'OWNER.log'
assert not (J/('NATIVE_OWNER_STARTED.json' if v['kind']=='native' else 'OWNER_STARTED.json')).exists()
with (J/logname).open('xb') as log:
 p=subprocess.Popen(['/home/lc01/Zonglin Li/zonglin2/run-python.sh','-u','-B',str(J/entry)],cwd=J,stdin=subprocess.DEVNULL,stdout=log,stderr=subprocess.STDOUT,start_new_session=True)
 q=psutil.Process(p.pid)
 print(json.dumps(dict(epoch=time.time(),pid=q.pid,creation=q.create_time(),exe=q.exe(),argv=q.cmdline(),root=q.cwd())))
'''
        actual=run(client,code,dict(job=frozen['job'],kind=kind),45)
        put('SCUT36_'+kind.upper()+'_OWNER_LAUNCH_ACTUAL.json',actual)
        if kind=='production':
            p=R/'CURRENT_WORK_ORDER.json';w=json.loads(p.read_bytes())
            w.update(status='V36_MOD4V2_OWNER_DISPATCHED_AWAIT_ACTUAL_FULLRESTORE_FIRST',run_id=plan['run_id'],remote_job=frozen['job'],original_owner=actual,training_started='AWAIT_GO_FIRST',training_completed=False,current_run_final=None,evaluation_result=None,next='Unique V36 FIRST metadata; original finite save/exit/independent80; no legacy once replay')
            p.write_text(json.dumps(w,ensure_ascii=False,indent=2)+'\n',encoding='utf-8')
        print(json.dumps(actual))
    except BaseException:
        put('SCUT36_'+kind.upper()+'_DISPATCH_ERROR.json',dict(epoch=time.time(),error=traceback.format_exc(),once_consumed=(R/'reports'/marker).exists()))
        raise
    finally:
        if sf is not None:sf.close()
        if client is not None:client.close()
        put('SCUT36_'+kind.upper()+'_DISPATCH_CLOSED.json',dict(epoch=time.time(),SSHclosed=True,SESSION_restored=True,serial='FREE'))


