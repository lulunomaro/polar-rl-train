def load(name,path):
    spec=importlib.util.spec_from_file_location(name,path);m=importlib.util.module_from_spec(spec)
    sys.modules[name]=m;spec.loader.exec_module(m);return m


def put(name,value):
    with (R/'reports'/name).open('x',encoding='utf-8') as f:json.dump(value,f,ensure_ascii=False,indent=2)


def admission():
    command="Get-CimInstance Win32_Process | Where-Object { $_.Name -match 'python|powershell|pwsh|ssh|cmd' -and $_.CommandLine -match 'MOD4_H1|RMPOLAR|watch|run_once_after_resume|E1.*collect|prepare_archive|single_gpu|collect_nine|collect_generic|collect_actual|PAIR|stage_new|dispatch|retention' } | Select-Object ProcessId,ParentProcessId,CreationDate,ExecutablePath,CommandLine | ConvertTo-Json -Depth 5"
    q=subprocess.Popen(['pwsh','-NoProfile','-NonInteractive','-Command',command],stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,encoding='utf-8')
    output,error=q.communicate(timeout=30)
    if q.returncode:raise RuntimeError(error)
    rows=json.loads(output) if output.strip() else []
    if isinstance(rows,dict):rows=[rows]
    by={r['ProcessId']:r for r in rows};own={os.getpid(),os.getppid(),q.pid};parent=os.getppid()
    while parent in by:
        parent=by[parent]['ParentProcessId']
        if parent in own:break
        own.add(parent)
    teleop=load('v36_exact_teleop_classifier',R/'scut_recipe_v28/closed_transfer_v29.py')
    blocked=[];benign=[]
    for row in rows:
        if row['ProcessId'] in own:continue
        text=row.get('CommandLine') or ''
        if text.endswith(r'C:\Users\lulu\.cc-switch\catalog-maxfix\watcher.py'):continue
        if teleop.is_local_teleop(row):benign.append(row);continue
        blocked.append(row)
    put('SCUT36_EXACT_LOCAL_'+str(time.time_ns())+'.json',dict(epoch=time.time(),rows=rows,foreign_observed=blocked,reviewed_teleop=benign,independent_SSH_allowed=True,global_foreign_collector_ban_superseded_by_human=True,only_own_ancestors_excluded=True))
    return rows,[]


