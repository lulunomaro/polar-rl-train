def native_result():
    frozen,plan=checked();_,blocked=admission()
    if blocked:print(json.dumps(dict(blocked=blocked,network=0)));return
    assert not (R/'reports/SCUT36_NATIVE_RESULT.json').exists()
    client=sf=None;result=dict(epoch=time.time(),job=frozen['job'],files={},logs={})
    try:
        client=connection();sf=client.open_sftp();sf.get_channel().settimeout(45)
        for name in ['NATIVE_OWNER_STARTED.json','NATIVE_OWNER_EXIT.json','NATIVE_OWNER_ERROR.json','NATIVE_WAITED.json','NATIVE_ADMISSION.json','NATIVE_GO.json','NATIVE_WORKER_IDENTITY.json','native_validation/RESULT.json','native_validation/ERROR.json','native_validation/V2_MECHANICS_REWARD.json','native_validation/CONTACT_TRACE.json','native_validation/REWARD_LOG.json','native_validation/ENV_CLOSED.json','native_validation/APP_CLOSE_INTENT.json']:
            try:
                with sf.open(frozen['job']+'/'+name,'rb') as f:result['files'][name]=json.loads(f.read(4*1024**2))
            except FileNotFoundError:pass
        for name in ['NATIVE_OWNER.log','NATIVE_WORKER.log']:
            try:
                size=sf.stat(frozen['job']+'/'+name).st_size
                with sf.open(frozen['job']+'/'+name,'rb') as f:f.seek(max(0,size-14000));raw=f.read()
                result['logs'][name]=dict(bytes=size,tail=raw.decode('utf-8','replace'))
            except FileNotFoundError:pass
    finally:
        if sf is not None:sf.close()
        if client is not None:client.close()
    result.update(SSHclosed=True,SESSION_restored=True,serial='FREE')
    terminal='NATIVE_OWNER_EXIT.json' in result['files']
    put('SCUT36_NATIVE_RESULT.json' if terminal else 'SCUT36_NATIVE_PENDING_'+str(time.time_ns())+'.json',result)
    print(json.dumps(dict(files={k:v for k,v in result['files'].items() if k not in ['native_validation/CONTACT_TRACE.json','native_validation/REWARD_LOG.json']},logs=result['logs'])))


