def launch(mode,attempt=''):
    assert mode in ('native','train')
    key='NATIVE' if mode=='native' else 'PRODUCTION'
    suffix=('_'+attempt) if attempt else ''
    marker='SCUT36_'+key+'86_BRIDGE'+suffix+'_ONCE.json'
    assert not (R/'reports'/marker).exists()
    if mode=='train':
        result=json.loads((R/'reports/SCUT36_NATIVE86_N02_RESULT.json').read_bytes())
        assert result['files']['native_validation/RESULT.json']['passed']
        own=result['bridge']['NATIVE_OWNER_EXIT.json']
        assert own['error'] is None and own['all_own_waited'] and own['original_cost_settled'] and own['original_leases_released']
    fresh();client=None;restore=lambda:None;secret=None
    try:
        client,restore,py=connect('72');secret=secret86()
        owner_filename='owner86_bridge_train.py' if mode=='train' else 'owner86_bridge_r2.py'
        if attempt=='R2' or mode=='train' and not attempt:
            owner_source=(D/'owner86_bridge.py').read_bytes()
            if mode=='train':owner_source=owner_source.replace(b"REMOTE+'/agent86.py'",b"REMOTE+'/agent86_production.py'")
            sf=client.open_sftp()
            try:
                with sf.open(BRIDGE+'/'+owner_filename,'wx') as f:f.write(owner_source)
            except OSError:
                with sf.open(BRIDGE+'/'+owner_filename,'rb') as f:assert f.read()==owner_source
            finally:sf.close()
        put(marker,dict(epoch=time.time(),run=FROZEN['run_id'],host='86',mode=mode))
        code="""import sys,subprocess,psutil,json,time
from pathlib import Path
secret=sys.stdin.readline().rstrip('\\r\\n')
job=Path(JOB)
with (job/LOG).open('xb') as log:
 p=subprocess.Popen([PY,'-u','-B',str(job/'owner86_bridge.py'),MODE],cwd=job,stdin=subprocess.PIPE,stdout=log,stderr=subprocess.STDOUT,start_new_session=True,text=True)
 p.stdin.write(secret+'\\n');p.stdin.close()
q=psutil.Process(p.pid)
print(json.dumps(dict(epoch=time.time(),pid=q.pid,creation=q.create_time(),exe=q.exe(),argv=q.cmdline(),root=q.cwd(),bridge=JOB,execution_host='86')))
"""
        if attempt=='R2' or mode=='train' and not attempt:code=code.replace("job/'owner86_bridge.py'","job/"+repr(owner_filename))
        code=code.replace('JOB',repr(BRIDGE)).replace('LOG',repr(key+'_BRIDGE'+suffix+'.log')).replace('PY',repr(py)).replace('MODE',repr(mode))
        i,o,e=client.exec_command(shlex.quote(py)+' -B -c '+shlex.quote(code),timeout=50)
        i.write(secret['password']+'\n');i.flush();i.channel.shutdown_write();secret=None
        raw=o.read().decode();err=e.read().decode();rc=o.channel.recv_exit_status()
        if rc:raise RuntimeError(err[-2000:])
        actual=json.loads(raw);put('SCUT36_'+key+'86_BRIDGE'+suffix+'_LAUNCH_ACTUAL.json',actual);print(json.dumps(actual))
    finally:
        secret=None
        if client is not None:client.close()
        restore();put('SCUT36_'+key+'86'+suffix+'_DISPATCH_CLOSED.json',dict(epoch=time.time(),SSHclosed=True,SESSION_restored=True))


def collect(mode,attempt=''):
    assert mode in ('native','train','first')
    fresh();clients=[];streams=[];restores=[]
    result=dict(epoch=time.time(),files={},bridge={},logs={},host='86',job=JOB86)
    key='NATIVE' if mode=='native' else 'PRODUCTION'
    try:
        for host,root in [('72',BRIDGE),('86',JOB86)]:
            c,restore,_=connect(host);clients.append(c);restores.append(restore);sf=c.open_sftp();streams.append(sf);sf.get_channel().settimeout(30)
            names=[key+'_OWNER_STARTED.json',key+'_WAIT_ORIGINAL_AUTHORITY.json',key+'_OWNER_CURRENT.json',key+'_OWNER_EXIT.json',key+'_OWNER_ERROR.json',key+'_REMOTE_WAITED.json','NATIVE_GO.json','GO_PRODUCTION.json'] if host=='72' else ['AGENT_'+key+'_STARTED.json','AGENT_'+key+'_EXIT.json','AGENT_'+key+'_ERROR.json','NATIVE_WORKER_IDENTITY.json','WORKER_IDENTITY.json','native_validation/RESULT.json','native_validation/ERROR.json','native_validation/V2_MECHANICS_REWARD.json','native_validation/ENV_CLOSED.json','native_validation/APP_CLOSE_INTENT.json','production/FULL_RESTORE.json','production/FIRST_UPDATED.json','production/STARTUP.json','production/FINAL.json','production/ERROR.json','production/ENV_CLOSED.json','production/APP_CLOSE_INTENT.json','TRAIN_CLOSED.json','EVAL_WAITED.json','evaluation/RESULT.json','evaluation/ERROR.json']
            out=result['bridge'] if host=='72' else result['files']
            for name in names:
                try:
                    with sf.open(root+'/'+name,'rb') as f:out[name]=json.loads(f.read(4*1024**2))
                except FileNotFoundError:pass
            logs=[key+'_BRIDGE.log',key+'_BRIDGE_R2.log'] if host=='72' else (['AGENT_NATIVE.log','AGENT_NATIVE_R2.log','NATIVE_WORKER.log'] if mode=='native' else ['AGENT_PRODUCTION.log','WORKER.log','EVAL.log'])
            for name in logs:
                try:
                    size=sf.stat(root+'/'+name).st_size
                    with sf.open(root+'/'+name,'rb') as f:f.seek(max(0,size-12000));raw=f.read(12000)
                    result['logs'][host+'/'+name]=dict(bytes=size,tail=raw.decode('utf-8','replace'))
                except FileNotFoundError:pass
    finally:
        for stream in streams:stream.close()
        for c in clients:c.close()
        for restore in restores:restore()
        result.update(all_SSH_closed=True,SESSION_restored=True)
    terminal=key+'_OWNER_EXIT.json' in result['bridge']
    native_label='SCUT36_NATIVE86'+('_'+attempt if attempt else '')
    name=(native_label+'_RESULT.json' if terminal else native_label+'_PENDING_'+str(time.time_ns())+'.json') if mode=='native' else (('SCUT36_FIRST86'+('_'+attempt if attempt else '')+'_ACTUAL.json') if mode=='first' else 'SCUT36_PRODUCTION86'+('_'+attempt if attempt else '')+'_METADATA_'+str(time.time_ns())+'.json')
    put(name,result);print(json.dumps(result))


