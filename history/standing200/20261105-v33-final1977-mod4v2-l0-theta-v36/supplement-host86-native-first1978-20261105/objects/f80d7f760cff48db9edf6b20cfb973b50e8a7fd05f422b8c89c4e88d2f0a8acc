    op=sys.argv[1]
    if op=='deploy':deploy()
    elif op in ('native','train'):launch(op)
    elif op=='native_r2':launch('native','R2')
    elif op in ('native_result','train_result','first'):collect({'native_result':'native','train_result':'train','first':'first'}[op])
    else:raise ValueError(op)
