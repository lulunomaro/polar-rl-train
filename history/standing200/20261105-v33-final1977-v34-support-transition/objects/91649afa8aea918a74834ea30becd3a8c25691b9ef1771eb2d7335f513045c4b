def height_command(xp,lift,both_top,supported):
    # Contact discovery alone must not increase the required height.
    # Actual supported wheel lift raises the target from .39 to .42m.
    return xp.where(both_top,.50,xp.where(supported,.39+.03*lift,.39))


def terms(xp,*,state,**kwargs):
    values,potential,_,supported,top=old.terms(xp,state=state,**kwargs)
    root=kwargs['root'];roll=kwargs['roll'];pitch=kwargs['pitch']
    grounded=xp.any(kwargs['wheel_ground_force']>1.,axis=-1)
    bearing=grounded|supported|top
    align=xp.exp(-4.*(roll*roll+pitch*pitch))*xp.exp(-(kwargs['yaw_error']/.35)**2)*xp.exp(-(root[:,1]/.45)**2)
    raised=xp.clip((root[:,2]-.30)/.09,0.,1.)
    lift=xp.clip(kwargs['wheel_low'][:,:,2]/.20,0.,1.).mean(axis=-1)
    target=height_command(xp,lift,top,supported)
    values['stand32_raise']=2.*raised*bearing*(~top)*align
    values['stand32_height']=1.5*xp.exp(-((root[:,2]-target)/.055)**2)*bearing*align
    deficit=xp.clip((target-root[:,2])/.09,0.,2.)
    values['stand33_height_shortfall']=-4.*deficit*deficit*bearing
    return values,potential,target,supported,top
