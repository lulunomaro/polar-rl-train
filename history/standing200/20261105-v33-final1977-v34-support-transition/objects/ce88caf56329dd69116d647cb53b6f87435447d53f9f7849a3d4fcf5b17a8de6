from scipy.spatial.transform import Rotation
import reward_model as new

R=Path(__file__).resolve().parent.parent;D=Path(__file__).resolve().parent
E=R/'actual_closed/MOD4_STANDING200_SUPPORTED_V33_1793834866525473900/evaluation'
OLD_REMOTE='/home/lc01/Zonglin Li/zonglin2/tasks/MOD4_STANDING200_SUPPORTED_V33_1793834866525473900'
BASE_REMOTE='/home/lc01/Zonglin Li/zonglin2/tasks/MOD4_STANDING200_SUPPORTED_V32_1793822795305806500'


def state(n=1):
    return dict(edge_seen=np.zeros(n,bool),support_gap=np.full(n,6,np.int64),
        support_count=np.zeros(n,np.int64),lip_dwell=np.zeros(n,np.int64),peak_lift=np.zeros(n))


def fixture(z=.35,support=0.,lift=0.,ground=80.):
    return dict(root=np.array([[.718,0.,z]]),velocity=np.zeros((1,3)),roll=np.zeros(1),pitch=np.zeros(1),yaw_error=np.zeros(1),
        wheel_low=np.array([[[.65,.22,lift],[.65,-.22,lift]]]),wheel_top_force=np.zeros((1,2)),
        wheel_ground_force=np.ones((1,2))*ground,support_top_force=np.array([support]),chassis_edge_force=np.array([50.]),
        wheel_span=np.array([.4376]),wheel_stagger=np.zeros(1),previous_potential=np.array([.718/1.35]),supported_ticks=np.zeros(1,np.int64))


def prefix_source(text,filename):
    """Evaluate source transforms before their exec, without native imports."""
    text=text.replace(OLD_REMOTE,(R/'scut_native_v33').as_posix()).replace(BASE_REMOTE,(R/'scut_native_v32').as_posix())
    tree=ast.parse(text);prefix=[]
    for node in tree.body:
        if isinstance(node,ast.Expr) and isinstance(node.value,ast.Call) and isinstance(node.value.func,ast.Name) and node.value.func.id=='exec':break
        prefix.append(node)
    ns=dict(__file__=str(filename),__name__='standing34_source_check')
    exec(compile(ast.Module(body=prefix,type_ignores=[]),str(filename),'exec'),ns)
    ast.parse(ns['source'])
    return ns['source']


def main():
    out=R/'reports/SCUT34_SUPPORT_TRANSITION_CPU_SAVED80_20261105.json';assert not out.exists()
    checks={}
    for p in D.glob('*.py'):ast.parse(p.read_bytes())
    checks['overlay_AST']=True
    recipe=prefix_source((D/'recipe.py').read_text(encoding='utf-8'),D/'recipe.py')
    expanded=prefix_source(recipe,D/'recipe.py')
    assert "FORMAT = 'MOD4V1_SCUT_STANDING200_V34_SUPPORT_TRANSITION'" in expanded
    assert 'state=self.stand33_state' in expanded and "value[ids]=6 if key=='support_gap' else 0" in expanded
    restore=prefix_source((D/'full_resume.py').read_text(encoding='utf-8'),D/'full_resume.py')
    assert "LEGACY='MOD4V1_SCUT_STANDING200_V33_HEIGHT_LIP_PROGRESS'" in restore
    assert "FORMAT='MOD4V1_SCUT_STANDING200_V34_SUPPORT_TRANSITION'" in restore
    checks['recipe_format_state_reset_and_fullrestore_transform']=True
    spec=importlib.util.spec_from_file_location('standing34_effective_control',D/'control.py');c=importlib.util.module_from_spec(spec);spec.loader.exec_module(c)
    assert c.HERE==D and any(isinstance(v,str) and 'MOD4_STANDING200_SUPPORTED_V34_' in v for v in c.first.__code__.co_consts)
    assert c.gpu.__globals__['R']==R
    checks['effective_controller_and_unique_first_job']=True
    transitions=[]
    for z in [.35,.36,.38,.39]:
        no=new.terms(np,state=state(),**fixture(z=z))[0]
        yes,_,target,_,_=new.terms(np,state=state(),**fixture(z=z,support=50.))
        assert target[0]==.39 and yes['stand32_raise'][0]==no['stand32_raise'][0]>0
        assert yes['stand33_height_shortfall'][0]==no['stand33_height_shortfall'][0]
        delta=float(sum(x[0]for x in yes.values())-sum(x[0]for x in no.values()));assert delta>=0
        transitions.append(dict(z=z,support_reward_delta=delta,target=float(target[0])))
    checks['new_support_no_negative_reward_jump']=True
    lift_targets=[]
    for lift in [0.,.05,.10,.20]:
        v,_,target,supported,_=new.terms(np,state=state(),**fixture(z=.39,support=50.,lift=lift))
        lift_targets.append(float(target[0]));assert supported[0] and v['stand32_raise'][0]>0
    assert np.allclose(lift_targets,[.39,.3975,.405,.42])
    k=fixture(z=.50,lift=.20,ground=0.);k['wheel_top_force'][:]=80.
    v,_,target,_,top=new.terms(np,state=state(),**k);assert top[0] and target[0]==.50 and v['stand32_top'][0]>0
    checks['target_blends_with_measured_lift_and_both_top']=True
    k=fixture(z=.39,ground=0.);v=new.terms(np,state=state(),**k)[0]
    assert v['stand32_raise'][0]==0 and v['stand33_height_shortfall'][0]==0
    k=fixture(z=.39,support=50.,ground=0.);v=new.terms(np,state=state(),**k)[0];assert v['stand32_raise'][0]>0
    checks['unsupported_spawn_no_credit_support_only_credit_preserved']=True
    s=state();k=fixture(support=50.);credits=[];edges=[]
    for i in range(200):
        k['support_top_force'][:]=50. if i%2==0 else 0.
        v=new.terms(np,state=s,**k)[0];credits.append(float(v['stand32_support'][0]));edges.append(float(v['stand32_chassis_edge'][0]))
    assert sum(x>0 for x in credits)==50 and sum(x>0 for x in edges)==1 and v['stand32_hang'][0]==-3.
    s=state();k=fixture(support=50.);new.terms(np,state=s,**k);k['support_top_force'][:]=0.
    assert [bool(new.terms(np,state=s,**k)[3][0])for _ in range(6)]==[True]*5+[False]
    checks['once_edge_finite_credit_persistent_dwell_and100ms_preserved']=True
    k=fixture();k['yaw_error'][:]=.3;k['wheel_span'][:]=.30;k['wheel_stagger'][:]=.1
    a=new.terms(np,state=state(),**k)[0];b=new.old.terms(np,state=state(),**k)[0]
    for key in ['stand32_heading','stand32_wheel_distance','stand32_wheel_stagger']:
        assert a[key][0]==b[key][0]<0
    assert not new.contact_termination(np,np.ones((80,9))*1.e9).any()
    checks['yaw_track_stagger_and_unconditional_contactreset_preserved']=True
    a=np.load(E/'actual400hz.npz',allow_pickle=False);result=json.loads((E/'RESULT.json').read_bytes());curves=json.loads((E/'CONTROL_CURVES.json').read_bytes())['curves']
    origins=np.asarray(result['origins']);s=state(80);previous=np.zeros(80);ticks=np.zeros(80,np.int64);totals={};oldtotals={};target_difference=[];bearing_target_errors=[]
    for row in curves:
        i=row['control']*8-1;angles=Rotation.from_quat(a['root_quat'][i][:,[1,2,3,0]]).as_euler('xyz');root=a['root_pos'][i]-origins
        oldvalues={k:np.asarray(v)for k,v in row['reward_terms'].items()}
        align=np.exp(-4*(angles[:,0]**2+angles[:,1]**2))*np.exp(-(angles[:,2]/.35)**2)*np.exp(-(root[:,1]/.45)**2)
        lift=oldvalues['stand32_retract']/(.02*4*np.maximum(align,1.e-12));low=np.zeros((80,2,3));low[:,:,2]=lift[:,None]*.20
        k=dict(root=root,velocity=a['velocity'][i],roll=angles[:,0],pitch=angles[:,1],yaw_error=angles[:,2],wheel_low=low,
            wheel_top_force=a['top_force'][i],wheel_ground_force=a['ground_force'][i],support_top_force=a['support_body_top'][i].sum(-1),
            chassis_edge_force=a['chassis_edge_force'][i],wheel_span=a['wheel_span'][i],wheel_stagger=a['wheel_stagger'][i],previous_potential=previous,supported_ticks=ticks)
        v,previous,target,supported,_=new.terms(np,state=s,**k);ticks=np.where(supported,ticks+1,0)
        assert all(np.isfinite(x).all()for x in v.values())
        for key,x in v.items():totals[key]=totals.get(key,np.zeros(80))+x*.02
        for key,x in oldvalues.items():oldtotals[key]=oldtotals.get(key,np.zeros(80))+x
        target_difference.extend((target-a['target_height'][i]).tolist())
        bearing_target_errors.extend((target-root[:,2])[supported].tolist())
    checks['saved39920_endpoints_finite_no_new_policy_or_physics']=True
    report=dict(epoch=time.time(),passed=all(checks.values()),checks=checks,source_evaluation=result['source'],same_pose_transitions=transitions,target_lift_blend=lift_targets,
        saved80_accounting=dict(controls=len(curves),environments=80,endpoint_pairs=len(curves)*80,
            old_weighted_episode_mean_sum={k:float(x.mean())for k,x in oldtotals.items()},new_weighted_episode_mean_sum={k:float(x.mean())for k,x in totals.items()},
            target_difference_quantiles=np.quantile(target_difference,[0,.5,1]).tolist(),
            measured_lift_reconstruction='Saved V33 weighted retract term divided by .02*4*align; exact active effective-support lift scalar, otherwise zero.',
            not_a_policy_effect_or_skill_test=True),PT_reads=0,SDK=0,new_physics=0,production_started=False)
    with out.open('x',encoding='utf-8')as f:json.dump(report,f,ensure_ascii=False,indent=2)
    print(json.dumps(dict(passed=report['passed'],checks=len(checks),endpoint_pairs=len(curves)*80,report=str(out))))


if __name__=='__main__':main()
