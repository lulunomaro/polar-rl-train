"""Check the actual-contact dwell fix and account for V34's saved80 endpoints."""
from pathlib import Path
import ast
import hashlib
import importlib.util
import json
import time
import numpy as np
from scipy.spatial.transform import Rotation
import reward_model as new

R=Path(__file__).resolve().parent.parent
D=Path(__file__).resolve().parent
E=R/'actual_closed/MOD4_STANDING200_SUPPORTED_V34_1793841110455553500/evaluation'
REMOTES={
    'MOD4_STANDING200_SUPPORTED_V32_1793822795305806500':'scut_native_v32',
    'MOD4_STANDING200_SUPPORTED_V33_1793834866525473900':'scut_native_v33',
    'MOD4_STANDING200_SUPPORTED_V34_1793841110455553500':'scut_native_v34',
}


def state(n=1):
    return dict(edge_seen=np.zeros(n,bool),support_gap=np.full(n,6,np.int64),
        support_count=np.zeros(n,np.int64),lip_dwell=np.zeros(n,np.int64),peak_lift=np.zeros(n),lip_contact_seen=np.zeros(n,bool))


def fixture(x=.545,z=.299,edge=50.,support=0.,ground=80.,vx=0.,vz=0.,lift=0.):
    return dict(root=np.array([[x,0.,z]]),velocity=np.array([[vx,0.,vz]]),roll=np.zeros(1),pitch=np.zeros(1),yaw_error=np.zeros(1),
        wheel_low=np.array([[[.35,.22,lift],[.35,-.22,lift]]]),wheel_top_force=np.zeros((1,2)),
        wheel_ground_force=np.ones((1,2))*ground,support_top_force=np.array([support]),chassis_edge_force=np.array([edge]),
        wheel_span=np.array([.4376]),wheel_stagger=np.zeros(1),previous_potential=np.array([x/1.35]),supported_ticks=np.zeros(1,np.int64))


def expand(source,filename):
    for remote,local in REMOTES.items():
        source=source.replace('/home/lc01/Zonglin Li/zonglin2/tasks/'+remote,(R/local).as_posix())
    prefix=[]
    for node in ast.parse(source).body:
        if isinstance(node,ast.Expr) and isinstance(node.value,ast.Call) and isinstance(node.value.func,ast.Name) and node.value.func.id=='exec':break
        prefix.append(node)
    ns=dict(__file__=str(filename),__name__='supported35_source_transform')
    exec(compile(ast.Module(body=prefix,type_ignores=[]),str(filename),'exec'),ns)
    ast.parse(ns['source'])
    return ns['source']


def main():
    out=R/'reports/SCUT35_MEASURED_LIP_DWELL_CPU_SAVED80_20261105.json'
    assert not out.exists()
    checks={}
    for p in D.glob('*.py'):ast.parse(p.read_bytes())
    source=(D/'recipe.py').read_text(encoding='utf-8')
    for _ in range(3):source=expand(source,D/'recipe.py')
    assert "FORMAT = 'MOD4V1_SCUT_STANDING200_V35_MEASURED_LIP_DWELL'" in source
    assert 'state=self.stand33_state' in source and "value[ids]=6 if key=='support_gap' else 0" in source
    source=(D/'full_resume.py').read_text(encoding='utf-8')
    for _ in range(2):source=expand(source,D/'full_resume.py')
    assert "LEGACY='MOD4V1_SCUT_STANDING200_V34_SUPPORT_TRANSITION'" in source
    assert "FORMAT='MOD4V1_SCUT_STANDING200_V35_MEASURED_LIP_DWELL'" in source
    checks['AST_recipe_restore_format_and_state_reset']=True
    spec=importlib.util.spec_from_file_location('supported35_effective_control',D/'control.py')
    control=importlib.util.module_from_spec(spec);spec.loader.exec_module(control)
    assert control.HERE==D and any(isinstance(v,str)and'MOD4_STANDING200_SUPPORTED_V35_'in v for v in control.first.__code__.co_consts)
    checks['unique_effective_controller_labels']=True
    low=state();oldlow=state();k=fixture();rows=[]
    for i in range(180):
        a=new.terms(np,state=low,**k)[0];b=new.old.terms(np,state=oldlow,**k)[0]
        if i in [0,49,50,149,179]:rows.append(dict(control=i+1,new_hang=float(a['stand32_hang'][0]),old_hang=float(b['stand32_hang'][0])))
    assert a['stand32_hang'][0]==-3. and b['stand32_hang'][0]==0.
    assert low['lip_contact_seen'][0] and not low['edge_seen'][0] and not oldlow['edge_seen'][0]
    checks['raw_lip_contact_covers_measured_low_root_stall']=True
    low=state();k=fixture();new.terms(np,state=low,**k);k['chassis_edge_force'][:]=0.
    for _ in range(170):v=new.terms(np,state=low,**k)[0]
    assert v['stand32_hang'][0]==-3. and low['lip_dwell'][0]==171
    checks['contact_gaps_do_not_clear_dwell']=True
    for k in [fixture(edge=0.),fixture(vx=.1),fixture(vz=.1)]:
        s=state()
        for _ in range(180):v=new.terms(np,state=s,**k)[0]
        assert v['stand32_hang'][0]==0.
    k=fixture();k['wheel_top_force'][:]=80.
    s=state()
    for _ in range(180):v=new.terms(np,state=s,**k)[0]
    assert v['stand32_hang'][0]==0. and v['stand32_top'][0]>0.
    checks['uncontacted_motion_lift_and_top_not_stalled']=True
    comparisons=[]
    for z in [.30,.35,.38,.39]:
        for support in [0.,50.]:
            k=fixture(z=z,support=support)
            v=new.terms(np,state=state(),**k)[0];old=new.old.terms(np,state=state(),**k)[0]
            for key in v:
                if key!='stand32_hang':assert np.allclose(v[key],old[key])
        k=fixture(z=z);no=new.terms(np,state=state(),**k)[0]
        k=fixture(z=z,support=50.);yes=new.terms(np,state=state(),**k)[0]
        delta=float(sum(x[0]for x in yes.values())-sum(x[0]for x in no.values()))
        assert delta>=0.
        comparisons.append(dict(z=z,support_reward_delta=delta))
    checks['independent_standing_and_continuous_support_transition_preserved']=True
    k=fixture(z=.39,support=50.);s=state();credits=[]
    for i in range(200):
        k['support_top_force'][:]=50. if i%2==0 else 0.
        v=new.terms(np,state=s,**k)[0];credits.append(float(v['stand32_support'][0]))
    assert sum(x>0 for x in credits)==50
    k=fixture(z=.39,support=50.);s=state();new.terms(np,state=s,**k);k['support_top_force'][:]=0.
    assert [bool(new.terms(np,state=s,**k)[3][0])for _ in range(6)]==[True]*5+[False]
    assert not new.contact_termination(np,np.ones((80,9))*1.e9).any()
    k=fixture();k['yaw_error'][:]=.3;k['wheel_span'][:]=.30;k['wheel_stagger'][:]=.1
    v=new.terms(np,state=state(),**k)[0];old=new.old.terms(np,state=state(),**k)[0]
    for key in ['stand32_heading','stand32_wheel_distance','stand32_wheel_stagger']:assert v[key][0]==old[key][0]<0.
    checks['contactreset_off_yaw_track_stagger_and_finite_support_credit_preserved']=True
    a=np.load(E/'actual400hz.npz',allow_pickle=False)
    result=json.loads((E/'RESULT.json').read_bytes())
    curves=json.loads((E/'CONTROL_CURVES.json').read_bytes())['curves']
    origins=np.asarray(result['origins']);s=state(80);previous=np.zeros(80);ticks=np.zeros(80,np.int64)
    totals={};actualtotals={};oldtotals={};olds=state(80);oldprevious=np.zeros(80);oldticks=np.zeros(80,np.int64)
    old_hang_error=0.;old_credit_error=0.;changed_pairs=0
    miss_x=miss_z=edge_pairs=stopped_edge_pairs=0;miss_x_env=np.zeros(80,bool);miss_z_env=np.zeros(80,bool)
    for row in curves:
        i=row['control']*8-1;active=np.asarray(row['active'],bool)
        angles=Rotation.from_quat(a['root_quat'][i][:,[1,2,3,0]]).as_euler('xyz')
        root=a['root_pos'][i]-origins
        # All80 have zero actual top support and zero retract reward. Wheel-low
        # lift is irrelevant to the changed dwell term; no new pose is generated.
        assert not(a['support_body_top'][i]>1).any() and not(a['top_force'][i]>1).any()
        k=dict(root=root,velocity=a['velocity'][i],roll=angles[:,0],pitch=angles[:,1],yaw_error=angles[:,2],wheel_low=np.zeros((80,2,3)),
            wheel_top_force=a['top_force'][i],wheel_ground_force=a['ground_force'][i],support_top_force=a['support_body_top'][i].sum(-1),
            chassis_edge_force=a['chassis_edge_force'][i],wheel_span=a['wheel_span'][i],wheel_stagger=a['wheel_stagger'][i],previous_potential=previous,supported_ticks=ticks)
        v,previous,_,supported,_=new.terms(np,state=s,**k);ticks=np.where(supported,ticks+1,0)
        k.update(previous_potential=oldprevious,supported_ticks=oldticks)
        old,oldprevious,_,supported,_=new.old.terms(np,state=olds,**k);oldticks=np.where(supported,oldticks+1,0)
        for key,x in v.items():
            assert np.isfinite(x).all()
            totals[key]=totals.get(key,np.zeros(80))+np.where(active,x*.02,0.)
            oldtotals[key]=oldtotals.get(key,np.zeros(80))+np.where(active,old[key]*.02,0.)
            actualtotals[key]=actualtotals.get(key,np.zeros(80))+np.where(active,np.asarray(row['reward_terms'][key]),0.)
            if key!='stand32_hang':old_credit_error=max(old_credit_error,float(np.max(np.abs(x-old[key]))))
        old_hang_error=max(old_hang_error,float(np.max(np.abs(old['stand32_hang']*.02-np.asarray(row['reward_terms']['stand32_hang'])))))
        changed_pairs+=int(((v['stand32_hang']<old['stand32_hang']-1.e-7)&active).sum())
        edge=(a['chassis_edge_force'][i]>1)&active
        stopped=edge&(np.abs(a['velocity'][i,:,0])<.03)&(np.abs(a['velocity'][i,:,2])<.03)
        mx=stopped&(root[:,0]<.55);mz=edge&(root[:,2]<=.31)
        edge_pairs+=int(edge.sum());stopped_edge_pairs+=int(stopped.sum());miss_x+=int(mx.sum());miss_z+=int(mz.sum());miss_x_env|=mx;miss_z_env|=mz
    assert old_hang_error<1.e-6 and old_credit_error==0. and changed_pairs>0
    checks['saved39920_endpoints_finite_old_hang_matches_actual']=True
    checks['only_hang_term_changed_on_saved_trajectory']=True
    report=dict(epoch=time.time(),passed=all(checks.values()),checks=checks,source=result['source'],same_pose_low_stall=rows,support_transition=comparisons,
        measured_blind_spot=dict(upper_lip_contact_control_pairs=edge_pairs,stopped_lip_pairs=stopped_edge_pairs,stopped_lip_below_root_x55_pairs=miss_x,
            stopped_lip_below_root_x55_envs=int(miss_x_env.sum()),lip_below_root_z31_pairs=miss_z,lip_below_root_z31_envs=int(miss_z_env.sum())),
        saved80_accounting=dict(endpoint_pairs=len(curves)*80,changed_hang_pairs=changed_pairs,max_old_hang_weighted_error=old_hang_error,
            max_other_formula_delta=old_credit_error,old_actual_episode_mean={k:float(v.mean())for k,v in actualtotals.items()},
            old_recomputed_episode_mean={k:float(v.mean())for k,v in oldtotals.items()},new_recomputed_episode_mean={k:float(v.mean())for k,v in totals.items()},
            not_new_behavior_or_skill=True),PT_reads=0,SDK=0,new_physics=0,production_started=False)
    with out.open('x',encoding='utf-8')as f:json.dump(report,f,ensure_ascii=False,indent=2)
    print(json.dumps(dict(passed=report['passed'],checks=len(checks),blind_spot=report['measured_blind_spot'],old_hang=report['saved80_accounting']['old_actual_episode_mean']['stand32_hang'],new_hang=report['saved80_accounting']['new_recomputed_episode_mean']['stand32_hang'])))


if __name__=='__main__':main()
