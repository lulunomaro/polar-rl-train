def main():
    assert not (R/'reports/SCUT36_RESIZE20000_STOP_REQUEST_ACTUAL.json').exists()
    fresh();c=sf=None;restore=lambda:None;result=dict(epoch=time.time(),human='用20000env练你这个',current_job=PROD,next_num_envs=20000,reward_physics_PPO_unchanged=True)
    try:
        c,restore,_=connect('86');sf=c.open_sftp();sf.get_channel().settimeout(30)
        with sf.open(PROD+'/GO_PRODUCTION.json','rb') as f:go=json.loads(f.read())
        assert go['run_id']=='MOD4_STANDING200_SUPPORTED_V36_1793872547340580700_PRODUCTION02'
        try:
            with sf.open(PROD+'/AGENT_PRODUCTION_EXIT.json','rb') as f:result['already_closed']=json.loads(f.read())
