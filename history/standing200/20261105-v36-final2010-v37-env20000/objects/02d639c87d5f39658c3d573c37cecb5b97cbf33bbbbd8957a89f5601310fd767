        if c is not None:c.close()
        restore();result.update(SSHclosed=True,SESSION_restored=True)
        put('SCUT36_RESIZE20000_STOP_REQUEST_ACTUAL.json',result);print(json.dumps(result))

if __name__=='__main__':main()
