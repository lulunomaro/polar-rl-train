            value=dict(epoch=time.time(),reason='Human requests sameV36 training at20000env; complete currentPPO then fullsave/safeclose/independent80 before resize',fullsave_required=True,next_num_envs=20000)
            with sf.open(PROD+'/STOP_AFTER_SAVE_HUMAN20000.json','wx') as f:f.write(json.dumps(value,indent=2))
