        tr.auth_password('robemo',secret,fallback=False)
        c=paramiko.SSHClient();c._transport=tr;return c
    except BaseException:tr.close();raise


def get(sf,name):
    try:
        with sf.open(REMOTE+'/'+name,'rb') as f:return json.loads(f.read(4*1024**2))
    except FileNotFoundError:return None


def send(sf,name,value):
    with sf.open(REMOTE+'/'+name+'.partial','w') as f:f.write(json.dumps(value,indent=2))
    sf.posix_rename(REMOTE+'/'+name+'.partial',REMOTE+'/'+name)


