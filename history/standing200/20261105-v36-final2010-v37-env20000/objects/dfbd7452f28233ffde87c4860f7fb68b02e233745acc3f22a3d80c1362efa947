    p=json.loads((PREV/'PLAN.json').read_bytes())
    run=json.loads((D/'PLAN.json').read_bytes())['run_id'] if retry else 'MOD4_STANDING200_SUPPORTED_V37_ENV20000_'+str(time.time_ns())
    job=OLD.rsplit('/',1)[0]+'/'+run;owner='/home/lc01/Zonglin Li/zonglin2/tasks/'+run+'_HOST86_BRIDGE'
    p.update(run_id=run,remote_root=job,execution_host='86',host86_root=job,authority72_root=owner,
        assets=job+'/v2package/assets',guard=job+'/guard.py',GPU_UUID=UUID,GPU_preference='host86 dedicated compute-empty GPU0',
        num_envs=20000,resume_checkpoint=source,source_checkpoint=source,
        full_restore_expected=dict(Adam_states=17,Adam_steps_each=40200,source_iteration=2010,source_envs=4096,new_envs=20000,learning_rate=1e-5),
        changes=['Human requested4096->20000 environments only; V36 reward/physics/PPO unchanged','Completeactor/critic/STD/Adam/LR/iteration/globalRNG restored; fresh20000perenvcomponents/queues and onephysicalreset'],
        native_probe='Reuse actualV36 native02; no new mechanical/rewarddelta; actual20000 firstPPO verifies resized deployment')
    with (D/'PLAN.json').open('w' if retry else 'x') as f:json.dump(p,f,indent=2)
    for name in ('entry.py','worker86.py','full_resume.py'):ast.parse((D/name).read_text())
    original=(PREV/'owner86_bridge.py').read_text()
    original=original.replace("REMOTE='"+OLD.rsplit('/production02',1)[0]+"'","REMOTE='"+job+"'")
    assert "REMOTE='"+job+"'" in original
    original=original.replace('supported200_v36_86','supported200_v37_20000_86').replace('MOD4V2_V36_PPO86','MOD4V2_V37_ENV20000_PPO86')
    (D/'owner86_bridge.py').write_text(original)
    fresh();clients=[];streams=[];restores=[];value=dict(epoch=time.time(),run_id=run,source=source,files=[])
    try:
        for host in ['86','72']:
            c,restore,py=connect(host);clients.append(c);restores.append(restore);s=c.open_sftp();s.get_channel().settimeout(45);streams.append(s)
        c86,c72=clients;s86,s72=streams
        s86.mkdir(job);s72.mkdir(owner)
        old_manifest=json.loads((prior/'INSTALL86_MANIFEST.json').read_bytes())
        rows=list(old_manifest['files'])
        # Four changed files only; assets and every unchanged module are references.
        names=['SOURCE_PATHS.json','recipe.py','reward_model.py','integration.py','guard.py','asset_compat.py','evaluate.py','ASSET_MIGRATION.json','relocation86.py','backend86.py','agent86.py','v2package']
        for name in names:s86.symlink(OLD+'/'+name,job+'/'+name)
        for name in ['entry.py','worker86.py','full_resume.py','PLAN.json']:
            raw=(D/name).read_bytes()
            with s86.open(job+'/'+name,'wx') as f:f.write(raw)
            rows.append(dict(path=job+'/'+name,bytes=len(raw),SHA=hashlib.sha256(raw).hexdigest(),source=str(D/name)))
        with s86.open(job+'/TASK.json','wx') as f:f.write((D/'PLAN.json').read_bytes())
        rows.append(dict(path=job+'/TASK.json',bytes=(D/'PLAN.json').stat().st_size,SHA=hashlib.sha256((D/'PLAN.json').read_bytes()).hexdigest()))
        with s86.open(job+'/INSTALL86_MANIFEST.json','wx') as f:f.write(json.dumps(dict(files=rows),indent=2))
        (D/'INSTALL86_MANIFEST.json').write_text(json.dumps(dict(files=rows),indent=2))
        s72.symlink(OLDOWNER+'/ssh_deps',owner+'/ssh_deps')
        for name in ['PLAN.json','owner86_bridge.py']:
            with s72.open(owner+'/'+name,'wx') as f:f.write((D/name).read_bytes())
        code="""import sys,json,pathlib,hashlib,ast
