""".replace('pathlib.Path(JOB)','pathlib.Path('+repr(job)+')').replace('pathlib.Path(SOURCE)','pathlib.Path('+repr(source['path'])+')')
        value['CPU']=query(c86,RUNTIME,code);value.update(passed=True,unchanged_reference_task=OLD,new_files_only=True)
    except BaseException:
