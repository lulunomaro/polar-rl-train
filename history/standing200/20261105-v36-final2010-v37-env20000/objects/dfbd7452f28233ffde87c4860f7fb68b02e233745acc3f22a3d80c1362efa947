    finally:
        for s in streams:s.close()
        for c in clients:c.close()
        for restore in restores:restore()
        value.update(SSHclosed=True,SESSION_restored=True);put('PREPARE02_ACTUAL' if retry else 'PREPARE_ACTUAL',value)
    frozen=dict(epoch=time.time(),run_id=run,num_envs=20000,files=[dict(path=str(f),bytes=f.stat().st_size,SHA=hashlib.sha256(f.read_bytes()).hexdigest()) for f in sorted(D.glob('*')) if f.is_file()],reference_manifest=str(D/'INSTALL86_MANIFEST.json'))
