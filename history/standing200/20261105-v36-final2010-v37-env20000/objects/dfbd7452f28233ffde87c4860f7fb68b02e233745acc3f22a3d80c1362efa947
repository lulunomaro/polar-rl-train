backend86.install()
integration.adapter().prepare_environment(opt_in=True)
integration.load('mod4v1_fresh_dr_guard',J/'guard.py')
for n in ('entry.py','worker86.py','full_resume.py'):ast.parse((J/n).read_text())
assert json.loads((J/'TASK.json').read_bytes())['num_envs']==20000
