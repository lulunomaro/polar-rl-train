def launch():
    p=plan();assert json.loads((R/'reports/SCUT37_PREPARE03_ACTUAL.json').read_bytes())['passed']
    review=json.loads((R/'reports/SCUT36_FINAL2010_NATIVE_REVIEW_20000_DECISION.json').read_bytes());assert review['native_review_completed']
    marker=R/'reports/SCUT37_LAUNCH_ONCE.json';assert not marker.exists()
    fresh();c=None;restore=lambda:None;secret=None
    try:
        c,restore,py=connect('72');secret=secret86()
        put('LAUNCH_ONCE',dict(epoch=time.time(),run_id=p['run_id'],num_envs=20000))
        code="""import sys,subprocess,psutil,json,time
from pathlib import Path
secret=sys.stdin.readline().rstrip('\\r\\n')
job=Path(JOB)
with (job/'PRODUCTION_BRIDGE.log').open('xb') as log:
 p=subprocess.Popen([PY,'-u','-B',str(job/'owner86_bridge.py'),'train'],cwd=job,stdin=subprocess.PIPE,stdout=log,stderr=subprocess.STDOUT,start_new_session=True,text=True)
 p.stdin.write(secret+'\\n');p.stdin.close()
q=psutil.Process(p.pid)
print(json.dumps(dict(epoch=time.time(),pid=q.pid,creation=q.create_time(),exe=q.exe(),argv=q.cmdline(),root=q.cwd(),bridge=JOB,execution_host='86',num_envs=20000)))
""".replace('JOB',repr(p['authority72_root'])).replace('PY',repr(py))
        i,o,e=c.exec_command(shlex.quote(py)+' -B -c '+shlex.quote(code),timeout=50)
        i.write(secret['password']+'\n');i.flush();i.channel.shutdown_write();secret=None
        raw=o.read().decode();err=e.read().decode();rc=o.channel.recv_exit_status()
        if rc:raise RuntimeError(err[-2000:])
        value=json.loads(raw);put('LAUNCH_ACTUAL',value);print(json.dumps(value))
    finally:
        if c:c.close()
        restore();secret=None;put('LAUNCH_SSH_CLOSED',dict(epoch=time.time(),SSHclosed=True,SESSION_restored=True))

def collect():
    p=plan();fresh();clients=[];streams=[];restores=[];value=dict(epoch=time.time(),files={},bridge={},logs={})
    try:
        for host,root in [('72',p['authority72_root']),('86',p['host86_root'])]:
            c,restore,_=connect(host);clients.append(c);restores.append(restore);s=c.open_sftp();streams.append(s);s.get_channel().settimeout(30)
            names=['PRODUCTION_OWNER_STARTED.json','PRODUCTION_WAIT_ORIGINAL_AUTHORITY.json','PRODUCTION_OWNER_CURRENT.json','PRODUCTION_OWNER_EXIT.json','PRODUCTION_OWNER_ERROR.json','PRODUCTION_ADMISSION.json','GO_PRODUCTION.json'] if host=='72' else ['AGENT_PRODUCTION_STARTED.json','AGENT_PRODUCTION_EXIT.json','AGENT_PRODUCTION_ERROR.json','WORKER_IDENTITY.json','PRODUCTION_RESOURCE.json','production/RESIZED_LEARNING_RESTORE.json','production/FULL_RESTORE.json','production/FIRST_UPDATED.json','production/STARTUP.json','production/FINAL.json','production/ERROR.json','TRAIN_CLOSED.json','EVAL_WAITED.json','evaluation/RESULT.json','evaluation/ERROR.json']
            out=value['bridge'] if host=='72' else value['files']
            for name in names:
                try:
                    with s.open(root+'/'+name,'rb') as f:out[name]=json.loads(f.read(4*1024**2))
                except FileNotFoundError:pass
            for name in (['PRODUCTION_BRIDGE.log'] if host=='72' else ['AGENT_PRODUCTION.log','WORKER.log','EVAL.log']):
                try:
                    size=s.stat(root+'/'+name).st_size
                    with s.open(root+'/'+name,'rb') as f:f.seek(max(0,size-6000));tail=f.read(6000)
                    value['logs'][host+'/'+name]=dict(bytes=size,tail=tail.decode('utf-8','replace'))
                except FileNotFoundError:pass
    finally:
        for s in streams:s.close()
        for c in clients:c.close()
        for restore in restores:restore()
        value.update(SSHclosed=True,SESSION_restored=True)
    name='METADATA_'+str(time.time_ns());put(name,value)
    print(json.dumps(dict(report=name,bridge_keys=list(value['bridge']),file_keys=list(value['files']),first=value['files'].get('production/FIRST_UPDATED.json'),error=value['files'].get('production/ERROR.json'))))

