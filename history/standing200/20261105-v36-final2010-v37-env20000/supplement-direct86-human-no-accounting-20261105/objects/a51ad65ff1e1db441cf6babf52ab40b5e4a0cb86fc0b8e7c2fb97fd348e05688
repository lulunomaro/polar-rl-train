def result():
    p=plan();fresh();c=s=None;restore=lambda:None;value=dict(epoch=time.time(),files={},logs={})
    try:
        c,restore,_=connect('86');s=c.open_sftp();s.get_channel().settimeout(35);job=p['host86_root']
        for name in ['GO_PRODUCTION.json','AGENT_PRODUCTION_STARTED.json','AGENT_PRODUCTION_EXIT.json','AGENT_PRODUCTION_ERROR.json','WORKER_IDENTITY.json','PRODUCTION_RESOURCE.json','production/RESIZED_LEARNING_RESTORE.json','production/FULL_RESTORE.json','production/STARTUP.json','production/FIRST_UPDATED.json','production/LATEST_PROGRESS.json','production/FINAL.json','production/ERROR.json','TRAIN_CLOSED.json','EVAL_WAITED.json','evaluation/RESULT.json','evaluation/ERROR.json']:
            try:
                with s.open(job+'/'+name,'rb') as f:value['files'][name]=json.loads(f.read(4*1024**2))
            except FileNotFoundError:pass
        for name in ['AGENT_PRODUCTION_DIRECT.log','WORKER.log','EVAL.log']:
            try:
                size=s.stat(job+'/'+name).st_size
                with s.open(job+'/'+name,'rb') as f:f.seek(max(0,size-6000));tail=f.read(6000)
                value['logs'][name]=dict(bytes=size,tail=tail.decode('utf-8','replace'))
            except FileNotFoundError:pass
    finally:
        if s:s.close()
        if c:c.close()
        restore();value.update(SSHclosed=True,SESSION_restored=True)
    label='DIRECT86_METADATA_'+str(time.time_ns());put(label,value)
    print(json.dumps(dict(report=label,keys=list(value['files']),first=value['files'].get('production/FIRST_UPDATED.json'),error=value['files'].get('production/ERROR.json'),agent_error=value['files'].get('AGENT_PRODUCTION_ERROR.json'))))

if __name__=='__main__':{'launch':launch,'result':result}[sys.argv[1]]()
