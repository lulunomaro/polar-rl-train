        execution_host='86',num_envs=20000,accounting_gate_removed=True,foreign_canonical_write=False)
    try:
        for host in ['72','86']:
            c,restore,py=connect(host);clients.append(c);restores.append(restore);s=c.open_sftp();streams.append(s);s.get_channel().settimeout(40)
        c72,c86=clients;s72,s86=streams;job=p['host86_root'];owner=p['authority72_root']
        code="""import json,pathlib,psutil,time
