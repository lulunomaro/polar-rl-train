""".replace('REPLACE_OWNER',repr(owner))
        value['queued_controller_retired']=query(c72,'/home/lc01/Zonglin Li/zonglin2/run-python.sh',code)
        # Only our exact local sleeping collector is retired; no SSH is open.
        collector=D/'collect_background.py'
        expected='4cb12b615612454cad7970b82d4bfc74a76fdff90ac23def56f93c8ae00c5e60'
        assert hashlib.sha256(collector.read_bytes()).hexdigest()==expected
        cmd="""$p=Get-CimInstance Win32_Process -Filter 'ProcessId=28708'; if(-not $p){throw 'Own sleeper missing'}; if($p.ExecutablePath -ne 'C:\\Users\\lulu\\AppData\\Local\\Programs\\Python\\Python314\\python.exe' -or $p.CommandLine -notlike '*scut_native_v37_env20000/collect_background.py' -or $p.CreationDate.ToString('yyyy-MM-ddTHH:mm:ss') -ne '2026-11-05T19:41:55'){throw 'Exact sleeper mismatch'}; $p | Select-Object ProcessId,CreationDate,ExecutablePath,CommandLine | ConvertTo-Json; Stop-Process -Id 28708 -ErrorAction Stop"""
