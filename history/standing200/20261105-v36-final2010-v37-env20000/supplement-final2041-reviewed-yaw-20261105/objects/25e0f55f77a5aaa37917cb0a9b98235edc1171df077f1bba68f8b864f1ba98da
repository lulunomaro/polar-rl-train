"""Reconstruct human L0/theta from saved poses; no policy or new physics."""
from pathlib import Path
import hashlib,json,time
import numpy as np
from scipy.spatial.transform import Rotation
D=Path(__file__).resolve().parent;R=D.parent
RUN='MOD4_STANDING200_SUPPORTED_V37_ENV20000_1793878393149078100'
E=R/'actual_closed'/RUN/'evaluation'

def main():
    result=json.loads((E/'RESULT.json').read_bytes())
    contract=json.loads(Path('F:/RMPOLAR-RL/mod4v2_p0_mechanical_limits_20261105/candidates/HW300N60/package/assets/import_contract.json').read_bytes())
    with np.load(E/'selected_actual_poses.npz',allow_pickle=False) as z:a={k:z[k].copy() for k in z.files}
    names=result['body_names'];wheel=[names.index('left_wheel'),names.index('right_wheel')];chassis=names.index('chassis')
    root=a['body_pos'][:,:,chassis];q=a['body_quat'][:,:,chassis]
    diff=a['body_pos'][:,:,wheel]-root[:,:,None]
    rot=Rotation.from_quat(q[:,:,[1,2,3,0]].reshape(-1,4))
    vb=np.stack([rot.inv().apply(diff[:,:,i].reshape(-1,3)).reshape(diff.shape[:2]+(3,)) for i in [0,1]],axis=2)
    anchors=np.asarray([contract['joints'][s+'_hip']['local_pos0'] for s in ('left','right')])
    v=vb-anchors;length=np.linalg.norm(v,axis=-1);theta=np.arctan2(v[...,0],-v[...,2])
    mask=a['active'].astype(bool);t=a['tick']*.0025
    after=mask&(t[:,None]>=1.)
    qlevels=[0,.1,.5,.9,1]
    rows=[]
    for j,e in enumerate(result['recorded_envs']):
        m=after[:,j]
        rows.append(dict(env=e,active_controls=int(mask[:,j].sum()),
            L0_after1_minmedianmax=np.quantile(length[m,j],[0,.5,1],axis=0).tolist(),
            theta_after1_minmedianmax=np.quantile(theta[m,j],[0,.5,1],axis=0).tolist(),
            initial_L0=length[0,j].tolist(),initial_theta=theta[0,j].tolist(),
            wheel_body_xz_after1_median=np.median(v[m,j][:,:,[0,2]],axis=0).tolist()))
    value=dict(epoch=time.time(),run_id=RUN,source=result['actual_poses'],
        L0_definition='Hip anchor to wheelcenter norm of inverse chassisrotation vector',
        theta_definition='atan2(bodydx,-bodydz)',anchors_body=anchors.tolist(),
        selected_cases=rows,L0_after1_quantiles=np.quantile(length[after],qlevels,axis=0).tolist(),
        theta_after1_quantiles=np.quantile(theta[after],qlevels,axis=0).tolist(),
        source_PT_reads=0,new_physics=0,original_render_and_evaluation_not_repeated=True)
    out=R/'reports/SCUT37_FINAL2041_SAVED_L0_THETA_AUDIT.json'
    with out.open('x',encoding='utf-8') as f:json.dump(value,f,indent=2)
    print(json.dumps(value))
if __name__=='__main__':main()
