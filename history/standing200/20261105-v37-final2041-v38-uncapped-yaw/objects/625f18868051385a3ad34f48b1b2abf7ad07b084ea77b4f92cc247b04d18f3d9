assert np.all(np.diff(v['stand32_heading'][2:])<0)
for k in ('pen_theta_no0','stand32_wheel_distance'):assert np.array_equal(v[k],old[k])
for n in ('entry.py','worker86.py','full_resume.py'):ast.parse((J/n).read_text())
assert recipe.HERE==J and evaluate.HERE==J and full_resume.FORMAT=='MOD4V2_SCUT_STANDING200_V38_UNCAPPED_YAW'
assert pathlib.Path(__SOURCE__).stat().st_size==38976423
print(json.dumps(dict(passed=True,yaw_boundaries=True,other_geometry_unchanged=True,regular_entry_output_bound=True,same20000_full_restore=True,PT_reads=0,physics=0)))
'''.replace('__JOB__',repr(job)).replace('__SOURCE__',repr(p['resume_checkpoint']['path']))
        compile(code,'v38_prepare_cpu','exec')
        value['CPU']=query(c,RUNTIME,code);value['passed']=True
    except BaseException:
        value['error']=traceback.format_exc();raise
    finally:
        if sf:sf.close()
        if c:c.close()
        restore();value.update(SSHclosed=True,SESSION_restored=True);put('PREPARE_ACTUAL',value)
    frozen=dict(epoch=time.time(),run_id=run,files=[dict(path=str(f),bytes=f.stat().st_size,SHA=hashlib.sha256(f.read_bytes()).hexdigest()) for f in sorted(D.glob('*.py'))],
        PLAN_SHA=hashlib.sha256((D/'PLAN.json').read_bytes()).hexdigest(),reference_manifest=str(D/'INSTALL86_MANIFEST.json'))
    with (D/'FROZEN.json').open('x') as f:json.dump(frozen,f,indent=2)
    print(json.dumps(dict(run_id=run,job=job,prepared=True,CPU=value['CPU'])))

