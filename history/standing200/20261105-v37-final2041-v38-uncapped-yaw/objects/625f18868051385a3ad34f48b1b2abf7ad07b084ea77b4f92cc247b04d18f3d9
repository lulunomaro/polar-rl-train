    review=json.loads((R/'reports/SCUT37_FINAL2041_NATIVE_REVIEW_V38_DECISION.json').read_bytes())
    assert review['native_review_completed'] and not review['next_decision']['skill_pass']
    closed=R/'actual_closed'/json.loads((PREV/'PLAN.json').read_bytes())['run_id']
    agent=json.loads((closed/'AGENT_PRODUCTION_EXIT.json').read_bytes())
    assert agent['error'] is None and agent['all_own_waited'] and agent['GPU_lease_released']
    assert json.loads((R/'reports/SCUT37_DIRECT_COLLECTOR_CLOSED.json').read_bytes())['local_collector_closed']
    p=json.loads((PREV/'PLAN.json').read_bytes())
    run='MOD4_STANDING200_SUPPORTED_V38_ENV20000_YAW_'+str(time.time_ns())
    job=OLD.rsplit('/',1)[0]+'/'+run
    p.update(run_id=run,remote_root=job,host86_root=job,authority72_root=None,
        assets=job+'/v2package/assets',guard=job+'/guard.py',source_checkpoint=review['final'],resume_checkpoint=review['final'],
