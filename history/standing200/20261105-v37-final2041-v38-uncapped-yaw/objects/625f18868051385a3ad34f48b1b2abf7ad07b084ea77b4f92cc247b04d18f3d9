        native_probe='Reuse V36native02; no mechanical/SDK/physical delta. Yaw formula CPU and saveddata checks only.')
    p.pop('original_strictreserve',None)
    (D/'PLAN.json').write_text(json.dumps(p,indent=2),encoding='utf-8')
    # These entry files must be regular so __file__ resolves to the new job.
    for name in ['worker86.py','evaluate.py']:
        with (D/name).open('xb') as f:f.write((PREV/name).read_bytes())
    with (D/'agent86_20000.py').open('xb') as f:f.write((PREV/'agent86_20000.py').read_bytes())
    for f in D.glob('*.py'):ast.parse(f.read_text())
    fresh();c=sf=None;restore=lambda:None;value=dict(epoch=time.time(),run_id=run,files=[])
    try:
        c,restore,_=connect('86');sf=c.open_sftp();sf.get_channel().settimeout(45)
        sf.mkdir(job)
        refs=['SOURCE_PATHS.json','integration.py','guard.py','asset_compat.py','ASSET_MIGRATION.json','relocation86.py','backend86.py','v2package']
        for name in refs:sf.symlink(OLD+'/'+name,job+'/'+name)
        oldmanifest=json.loads((PREV/'INSTALL86_MANIFEST03.json').read_bytes())
        rows=list(oldmanifest['files'])
        for name in ['recipe.py','reward_model.py','full_resume.py','entry.py','worker86.py','evaluate.py','agent86_20000.py','PLAN.json']:
            raw=(D/name).read_bytes()
            with sf.open(job+'/'+name,'wx') as f:f.write(raw)
            row=dict(path=job+'/'+name,bytes=len(raw),SHA=hashlib.sha256(raw).hexdigest(),source=str(D/name))
            rows.append(row);value['files'].append(row)
        raw=(D/'PLAN.json').read_bytes()
        with sf.open(job+'/TASK.json','wx') as f:f.write(raw)
        rows.append(dict(path=job+'/TASK.json',bytes=len(raw),SHA=hashlib.sha256(raw).hexdigest()))
        manifest=dict(files=rows,unchanged_references=OLD,no_SDK_clone=True,no_canonical_operation=True)
        with sf.open(job+'/INSTALL86_MANIFEST.json','wx') as f:f.write(json.dumps(manifest,indent=2))
        (D/'INSTALL86_MANIFEST.json').write_text(json.dumps(manifest,indent=2))
        code='''import sys,pathlib,json,hashlib,ast,numpy as np
