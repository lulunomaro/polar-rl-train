"""One measured continuation on host86, referencing the completed V38 task."""
from pathlib import Path
import ast,hashlib,importlib.util,json,sys,time,traceback
D=Path(__file__).resolve().parent;R=D.parent;PREV=R/'scut_native_v38_yaw'
spec=importlib.util.spec_from_file_location('v39_existing_direct_control',PREV/'control.py')
old=importlib.util.module_from_spec(spec);spec.loader.exec_module(old)
fresh=old.fresh;connect=old.connect;query=old.query;RUNTIME=old.RUNTIME

def put(name,value):
    with (R/'reports'/('SCUT39_'+name+'.json')).open('x',encoding='utf-8') as f:
        json.dump(value,f,ensure_ascii=False,indent=2)

def plan():return json.loads((D/'PLAN.json').read_bytes())

def prepare():
    assert not (D/'PLAN.json').exists()
    review=json.loads((R/'reports/SCUT38_FINAL2070_NATIVE_REVIEW_V39_DECISION.json').read_bytes())
    assert review['native_review_completed'] and review['AGENT_PRODUCTION_EXIT']['GPU_lease_released'] and review['collector_closed']['local_collector_closed']
    p=json.loads((PREV/'PLAN.json').read_bytes());previous=p['host86_root']
    run='MOD4_STANDING200_SUPPORTED_V39_ENV20000_CONTINUE_'+str(time.time_ns())
    job=previous.rsplit('/',1)[0]+'/'+run
    p.update(run_id=run,remote_root=job,host86_root=job,assets=job+'/v2package/assets',guard=job+'/guard.py',
        source_checkpoint=review['final'],resume_checkpoint=review['final'],
        resume_helper_source=dict(path=previous+'/full_resume.py',SHA=hashlib.sha256((PREV/'full_resume.py').read_bytes()).hexdigest()),
        full_restore_expected=dict(Adam_states=17,Adam_steps_each=41400,source_iteration=2070,source_envs=20000,new_envs=20000,learning_rate=1e-5),
        source_review=str(R/'reports/SCUT38_FINAL2070_NATIVE_REVIEW_V39_DECISION.json'),
        changes=['No rewardphysicsPPOdelta; evidence-led singlewindow continuation after verified yaw/termination improvement.',
                 'Same20000 alllearning/componentsqueues/globalnamedRNG restored then onefreshphysicalreset.'],
        native_probe='V36native02 reused; V38actual29PPO and independent80 consumed. No new native or CPU mechanical probe.')
    with (D/'PLAN.json').open('x') as f:json.dump(p,f,indent=2)
    for name in ['recipe.py','entry.py','worker86.py','evaluate.py','agent86_20000.py']:
        digest=hashlib.sha256((PREV/name).read_bytes()).hexdigest()
        wrapper='"""Unchanged V38 module, with this regular entry\'s own task directory."""\nfrom pathlib import Path\nimport hashlib\nP=Path('+repr(previous+'/'+name)+')\nraw=P.read_bytes()\nassert hashlib.sha256(raw).hexdigest()=='+repr(digest)+'\nexec(compile(raw,str(P),"exec"),globals())\n'
        with (D/name).open('x') as f:f.write(wrapper)
    for f in D.glob('*.py'):ast.parse(f.read_text())
    fresh();c=sf=None;restore=lambda:None;value=dict(epoch=time.time(),run_id=run,files=[])
    try:
        c,restore,_=connect('86');sf=c.open_sftp();sf.get_channel().settimeout(45);sf.mkdir(job)
        for name in ['SOURCE_PATHS.json','integration.py','guard.py','asset_compat.py','ASSET_MIGRATION.json','relocation86.py','backend86.py','v2package']:
            sf.symlink(previous+'/'+name,job+'/'+name)
        rows=list(json.loads((PREV/'INSTALL86_MANIFEST.json').read_bytes())['files'])
        for name in ['recipe.py','entry.py','worker86.py','evaluate.py','agent86_20000.py','full_resume.py','PLAN.json']:
            raw=(D/name).read_bytes()
            with sf.open(job+'/'+name,'wx') as f:f.write(raw)
            row=dict(path=job+'/'+name,bytes=len(raw),SHA=hashlib.sha256(raw).hexdigest(),source=str(D/name));rows.append(row);value['files'].append(row)
        # reward_model's geometry has no task-local state and may be referenced.
        sf.symlink(previous+'/reward_model.py',job+'/reward_model.py')
        raw=(D/'PLAN.json').read_bytes()
        with sf.open(job+'/TASK.json','wx') as f:f.write(raw)
        rows.append(dict(path=job+'/TASK.json',bytes=len(raw),SHA=hashlib.sha256(raw).hexdigest()))
        manifest=dict(files=rows,reference_task=previous,no_SDK_clone=True,no_canonical_operation=True)
        with sf.open(job+'/INSTALL86_MANIFEST.json','wx') as f:f.write(json.dumps(manifest,indent=2))
        (D/'INSTALL86_MANIFEST.json').write_text(json.dumps(manifest,indent=2))
        code='''import pathlib,sys,json,ast
J=pathlib.Path(__JOB__)
sys.path.insert(0,str(J))
import relocation86
relocation86.JOB=J
relocation86.install()
import integration,backend86,recipe,evaluate,full_resume
for m in (integration,backend86,recipe,evaluate):
 if hasattr(m,'HERE'):m.HERE=J
 if hasattr(m,'J'):m.J=J
backend86.install()
assert recipe.HERE==J and pathlib.Path(evaluate.__file__).resolve().parent==J
assert full_resume.FORMAT=='MOD4V2_SCUT_STANDING200_V38_UNCAPPED_YAW'
assert pathlib.Path(__SOURCE__).stat().st_size==38975975
for n in ('entry.py','worker86.py','recipe.py','full_resume.py'):ast.parse((J/n).read_text())
print(json.dumps(dict(passed=True,regular_output_binding=True,same20000_full_restore=True,reward_physics_PPO_delta=False,PT_reads=0,new_physics=0)))
'''.replace('__JOB__',repr(job)).replace('__SOURCE__',repr(p['resume_checkpoint']['path']))
        value['CPU']=query(c,RUNTIME,code);value['passed']=True
    except BaseException:
        value['error']=traceback.format_exc();raise
    finally:
        if sf:sf.close()
        if c:c.close()
        restore();value.update(SSHclosed=True,SESSION_restored=True);put('PREPARE_ACTUAL',value)
    frozen=dict(epoch=time.time(),run_id=run,files=[dict(path=str(f),bytes=f.stat().st_size,SHA=hashlib.sha256(f.read_bytes()).hexdigest()) for f in sorted(D.glob('*.py'))],
        PLAN_SHA=hashlib.sha256((D/'PLAN.json').read_bytes()).hexdigest())
    with (D/'FROZEN.json').open('x') as f:json.dump(frozen,f,indent=2)
    print(json.dumps(dict(prepared=True,run_id=run,job=job,CPU=value['CPU'])))

def launch():
    # Reuse exact GPU-only admission/launch. Rebind this run's globals and
    # once prefix; no old phase operation or accounting path is invoked.
    source=(PREV/'control.py').read_text()
    node=next(n for n in ast.parse(source).body if isinstance(n,ast.FunctionDef) and n.name=='launch')
    text=ast.get_source_segment(source,node).replace('SCUT38_','SCUT39_')
    scope=dict(vars(old),D=D,R=R,plan=plan,put=put)
    exec(compile(text,'v39_existing_direct_launch','exec'),scope);scope['launch']()

if __name__=='__main__':{'prepare':prepare,'launch':launch}[sys.argv[1]]()
