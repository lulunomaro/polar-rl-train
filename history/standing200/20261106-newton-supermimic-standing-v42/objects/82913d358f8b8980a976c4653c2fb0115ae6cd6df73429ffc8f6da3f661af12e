def raycast(self,points):
    from .terrain import sample
    hits=points.clone();hits[...,2]=sample(self.terrain_grid,points)
    starts=points.clone();starts[...,2]+=5.
    return starts,hits
NewtonEnv.raycast=raycast

def nominal_receipt(self):
    pd=self._explicit_pd.component.coefficients()
    r=self.reward
    lengths,theta=r.virtual_legs()
    return dict(task='standing_forward',num_envs=self.num_envs,
        command=self.command.command[0].tolist(),height_target=.334,
        theta_coefficient=r.cfg.rewards['pen_theta_no0'],raw_actions_no_clip=True,
        full_DR=False,mass_factor_minmax=[float(self.mass_factor.min()),float(self.mass_factor.max())],
        motor_gain_minmax=[float(self.motor_gain.min()),float(self.motor_gain.max())],
        friction_minmax=[float(self.friction.min()),float(self.friction.max())],
        sensor_profile=self._sensor_mild.profile,
        nominal_all=bool(self.nominal.all()),
        components_enabled={k:bool(getattr(self,k).component.enabled)for k in
            ('_spring_pressure','_gas_damping','_chassis_com','_explicit_pd')},
        pd={k:[float(v.min()),float(v.max())]for k,v in pd.items()},
        terrain_lane_counts=[int((self.terrain_lane==i).sum())for i in range(5)],
        actual_L0_minmax=[float(lengths.min()),float(lengths.max())],
        actual_theta_minmax=[float(theta.min()),float(theta.max())])
NewtonEnv.nominal_receipt=nominal_receipt
