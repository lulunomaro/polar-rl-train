"""Read immutable shared implementations by their recorded path and SHA."""
from pathlib import Path
import hashlib,json
ROOT=Path(__file__).resolve().parent

def source(name):
    row=json.loads((ROOT/'REFERENCES.json').read_bytes())['modules'][name]
    raw=Path(row['path']).read_bytes()
    assert hashlib.sha256(raw).hexdigest()==row['SHA'],name
    return raw.decode()

def replace(text,before,after):
    assert text.count(before)==1,before
    return text.replace(before,after)

def module(name):
    import importlib.util,sys
    row=json.loads((ROOT/'REFERENCES.json').read_bytes())['modules'][name]
    source(name)
    key=__package__+'._standing_pinned_'+name
    if key not in sys.modules:
        spec=importlib.util.spec_from_file_location(key,row['path'])
        value=importlib.util.module_from_spec(spec);sys.modules[key]=value;spec.loader.exec_module(value)
    return sys.modules[key]
