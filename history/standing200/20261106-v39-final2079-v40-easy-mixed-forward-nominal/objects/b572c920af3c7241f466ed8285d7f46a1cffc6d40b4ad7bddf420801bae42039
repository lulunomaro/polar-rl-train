 for pid,creation in ((696875,1793891361.83),(696886,1793891362.08)):
  p=psutil.Process(pid);assert abs(p.create_time()-creation)<.02
  assert any(str(J) in x for x in p.cmdline()),p.cmdline()
 with (J/'STOP_AFTER_SAVE.json').open('x') as f:json.dump(dict(epoch=time.time(),reason='Human requested nominal lowdifficulty mixedterrain standing curriculum; finish currentPPO and fullsave safely.',fullsave_required=True),f,indent=2)
