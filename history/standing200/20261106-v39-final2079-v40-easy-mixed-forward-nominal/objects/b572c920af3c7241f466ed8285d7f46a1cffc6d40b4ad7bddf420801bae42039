out={}
for n in ('AGENT_PRODUCTION_STARTED.json','AGENT_PRODUCTION_EXIT.json','WORKER_IDENTITY.json','production/LATEST_PROGRESS.json','production/FINAL.json','production/ERROR.json'):
 if (J/n).exists():out[n]=json.loads((J/n).read_bytes())
