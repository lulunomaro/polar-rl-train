    assert native['AGENT_NATIVE05_EXIT.json']['all_own_waited'] and native['AGENT_NATIVE05_EXIT.json']['GPU_lease_released']
    fresh();c=sf=None;restore=lambda:None;v=dict(epoch=time.time(),native_proof=str(D/'NATIVE05_RESULT.json'))
    try:
        c,restore,_=connect('86');sf=c.open_sftp();sf.get_channel().settimeout(40)
        try:sf.stat(job+'/GO_PRODUCTION.json');raise RuntimeError('GO already exists')
        except FileNotFoundError:pass
        manifest=json.loads((D/'INSTALL86_MANIFEST05.json').read_bytes());rows={r['path']:r for r in manifest['files']}
        name='evaluate.py';raw=(D/name).read_bytes();remote=job+'/'+name
