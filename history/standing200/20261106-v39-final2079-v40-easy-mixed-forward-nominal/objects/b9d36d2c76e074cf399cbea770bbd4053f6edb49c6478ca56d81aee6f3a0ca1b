"""Finalize only pre-GO evaluated source and launch the authorized 20000env run."""
from control import *

def main():
    p=plan();job=p['host86_root']
    assert not (R/'reports/SCUT40_LAUNCH_ONCE.json').exists()
    native=json.loads((D/'NATIVE05_RESULT.json').read_bytes())
