"""Independent80 first episodes: forward speed, standing legs and stability."""
from pathlib import Path
import argparse,hashlib,io,json,random,time,traceback

def evaluate(task,common):
    from mod4v1_scut.train import boot,load_guard,put,ScutVecEnv
    out=Path(__file__).resolve().parent/'evaluation';out.mkdir(exist_ok=False)
    q=argparse.ArgumentParser()
    for key in ('assets','runtime','runtime-manifest','guard','profile'):q.add_argument('--'+key)
    q.add_argument('--support',action='append',default=[]);a=q.parse_args(common)
    a.num_envs=80;a.seed=9137;a.device='cuda:0'
    ns=boot(a,out);env=bridge=None;error=None
    try:
        import numpy as np,torch
        from rsl_rl.models import MLPModel
        from chassis_pd_training_env import ChassisPDMod4Env
        from pose_cache_runtime_adapter_v4 import install_pose_cache_runtime_adapter_v4
        from mild_dr import tensor
        import mod4_task as taskmod
        from mod4v1_scut.sdk import configure,ScutBridge
        from mod4v1_scut.config import model_contract,runner_config
        from mod4v1_scut.checkpoint import FORMAT,INTERFACE
        from mod4v1_scut.course import metadata
        from mod4v1_scut.math_ops import euler_xyz_from_quat,wrap_to_pi
        from reward_model import virtual_legs,wheel_geometry
        from nominal import readback
        random.seed(9137);np.random.seed(9137);torch.manual_seed(9137);torch.cuda.manual_seed_all(9137)
        gm=load_guard(a.guard);identity=ns['E0_IDENTITY'];gm.verify_task_module(taskmod,identity)
        cfg=taskmod.Mod4EnvCfg();cfg.seed=9137;cfg.sim.device=a.device;configure(cfg,80);gm.configure_new_task(cfg,identity)
        env=ChassisPDMod4Env(cfg=cfg);guard=gm.FreshDRNominalGuard(env,identity,torch_module=torch,tensor_converter=tensor)
        install_pose_cache_runtime_adapter_v4(env.scene['robot'],receipt_callback=lambda v:put(out/'POSE_CACHE_EVENTS.json',dict(latest=v)))
        bridge=ScutBridge(env,taskmod,model_contract(a.assets),tensor);vec=ScutVecEnv(env,bridge,env.observation_manager.compute())
        rc=runner_config();ac=rc['actor'].copy();ac.pop('class_name')
        actor=MLPModel(vec.get_observations(),rc['obs_groups'],'actor',6,**ac).to(a.device)
        final=json.loads((out.parent/'production/FINAL.json').read_bytes())['checkpoint']
        raw=Path(final['path']).read_bytes();assert len(raw)==final['bytes'] and hashlib.sha256(raw).hexdigest()==final['SHA']
        data=torch.load(io.BytesIO(raw),map_location=a.device,weights_only=False)
        assert data['format']==FORMAT and data['interface']==INTERFACE
        actor.load_state_dict(data['actor_state_dict'],strict=True);actor.eval().requires_grad_(False);del data,raw
        with guard.around_original_fullstate_restore():reset=env.reset()
        vec.current=reset[0] if isinstance(reset,tuple) else reset;bridge.ready=True
        nominal=readback(env);put(out/'NATIVE_STARTUP.json',dict(epoch=time.time(),source=final,one_model_decode=True,optimizer_operations=0,nominal=nominal,course=metadata()))
        # Save the actual generated collision mesh once for matching pose replay.
        from isaaclab.sim import get_current_stage
        from pxr import UsdGeom
        mesh=UsdGeom.Mesh(get_current_stage().GetPrimAtPath('/World/ground/terrain'))
        verts=np.asarray(mesh.GetPointsAttr().Get(),dtype=np.float32)
        faces=np.asarray(mesh.GetFaceVertexIndicesAttr().Get(),dtype=np.int32).reshape(-1,3)
        np.savez_compressed(out/'terrain_mesh.npz',vertices=verts,faces=faces)
        active=torch.ones(80,dtype=torch.bool,device=a.device);selected=[0,20,40,60]
        ticks=[];poses=[];curves=[];episodes=[None]*80
        def observe(b):
            d=b.reward.robot.data;l,t=virtual_legs(b.reward);roll,pitch,yaw=euler_xyz_from_quat(d.root_quat_w)
            span,_=wheel_geometry(torch,d.body_pos_w[:,b.reward._wheel_link_idx],yaw)
            row=dict(tick=np.int32(b.physics_ticks),active=active.cpu().numpy().copy())
            for k,v in dict(root_pos=d.root_pos_w,root_quat=d.root_quat_w,velocity=d.root_lin_vel_b,
                L0=l,theta0=t,roll=roll,pitch=pitch,yaw=wrap_to_pi(yaw),wheel_span=span).items():row[k]=v.detach().cpu().numpy().copy()
            ticks.append(row)
            if b.physics_ticks%8==0:
                poses.append(dict(tick=np.int32(b.physics_ticks),active=active[selected].cpu().numpy().copy(),
                    body_pos=d.body_pos_w[selected].cpu().numpy().copy(),body_quat=d.body_quat_w[selected].cpu().numpy().copy()))
        bridge.physics_observer=observe
        origin=env.scene.env_origins.detach().cpu().numpy().copy()
        for control in range(500):
            with torch.inference_mode():action=actor(vec.get_observations());obs,reward,dones,info=vec.step(action)
            snap=bridge.terminal_snapshot;done=(snap['terminated']|snap['time_out']|((control+1)==500))&active
            for i in done.nonzero().flatten().tolist():
                episodes[i]=dict(env=i,controls=control+1,seconds=(control+1)*.02,
                    terminated=bool(snap['terminated'][i]),timeout=bool(snap['time_out'][i]),
                    root_pos=snap['root_pos'][i].cpu().tolist(),closure=bool(env.termination_manager.get_term('closure')[i]),
                    mimic=bool(env.termination_manager.get_term('mimic')[i]))
            curves.append(dict(control=control+1,active=active.cpu().tolist(),reward=reward.cpu().tolist(),action=action.cpu().tolist(),
                reward_terms={k:v.cpu().tolist() for k,v in bridge.reward._last_reward_terms.items()}))
            active &= ~done
            if not active.any():break
        def rowfile(name,rows):
            np.savez_compressed(out/name,**{k:np.stack([r[k] for r in rows]) for k in rows[0]})
            p=out/name
            with p.open('rb') as f:sha=hashlib.file_digest(f,'sha256').hexdigest()
            return dict(path=str(p),bytes=p.stat().st_size,SHA=sha)
        all400=rowfile('actual400hz.npz',ticks);actualposes=rowfile('selected_actual_poses.npz',poses)
        with (out/'terrain_mesh.npz').open('rb') as f:terrainsha=hashlib.file_digest(f,'sha256').hexdigest()
        terrainrow=dict(path=str(out/'terrain_mesh.npz'),bytes=(out/'terrain_mesh.npz').stat().st_size,SHA=terrainsha)
        put(out/'CONTROL_CURVES.json',dict(curves=curves));put(out/'ALL80.json',dict(first_episodes=episodes))
        summaries=[]
        for i in range(80):
            rows=[r for r in ticks if r['active'][i] and r['tick']*.0025>=1.]
            if not rows:summaries.append(dict(env=i,samples_after1s=0,passed=False));continue
            l=np.stack([r['L0'][i] for r in rows]);theta=np.stack([r['theta0'][i] for r in rows]);v=np.stack([r['velocity'][i] for r in rows])
            rp=np.asarray([[r['roll'][i],r['pitch'][i]] for r in rows]);yaw=np.asarray([r['yaw'][i] for r in rows])
            progress=episodes[i]['root_pos'][0]-origin[i,0]
            condition=(l.min(-1)>=.28)&(np.abs(rp).max(-1)<np.deg2rad(10))&(np.abs(yaw)<.2)&(np.abs(v[:,0]-.35)<.12)
            summaries.append(dict(env=i,samples_after1s=len(rows),L0_median=l.mean(0).tolist(),theta0_abs_mean=np.abs(theta).mean(0).tolist(),
                vx_mean=float(v[:,0].mean()),x_progress=float(progress),standing_forward_fraction=float(condition.mean()),
                passed=bool(not episodes[i]['terminated'] and progress>2. and condition.mean()>=.8)))
        put(out/'RESULT.json',dict(epoch=time.time(),passed_execution=all(e is not None for e in episodes),source=final,
            independent_first_episodes=80,standing_forward_pass=sum(s['passed'] for s in summaries),
            protocol='after1s bothL0>=.28/rp<10deg/yaw<.2/vx=.35+-.12 for80percent;10s survive and xprogress>2m',
            summaries=summaries,all80_manifold=all400,actual_poses=actualposes,terrain_mesh=terrainrow,
            recorded_envs=selected,body_names=list(bridge.robot.body_names),origins=origin.tolist(),
            saved_pose_quaternion_order='wxyz',course=metadata(),optimizer_operations=0,native_review_pending=True))
    except BaseException:
        error=traceback.format_exc();put(out/'ERROR.json',dict(epoch=time.time(),error=error));raise
    finally:
        if bridge:bridge.close()
        if env:env.close();put(out/'ENV_CLOSED.json',dict(returned=True))
        put(out/'APP_CLOSE_INTENT.json',dict(error=error));ns['app'].close()
