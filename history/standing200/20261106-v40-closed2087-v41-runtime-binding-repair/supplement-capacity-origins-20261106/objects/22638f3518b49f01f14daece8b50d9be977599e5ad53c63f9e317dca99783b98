"""Repair measured pair overflow; read the collision mesh and live limits."""
from pathlib import Path
import sys

TOTAL_PAIRS = 2**23
FOUND_LOST_AGGREGATE_PAIRS = 2**28
FOUND_LOST_PAIRS = 2**23


def install_origins():
    from isaaclab.terrains import TerrainImporter
    original_origins = TerrainImporter._compute_env_origins_curriculum
    original_mesh = TerrainImporter.import_mesh

    def retain_mesh(self, name, mesh):
        self._v41_mesh = mesh
        return original_mesh(self, name, mesh)

    def spread_origins(self, num_envs, origins):
        import torch
        from isaaclab.utils.warp import convert_to_warp_mesh, raycast_mesh
        result = original_origins(self, num_envs, origins)
        levels = self.terrain_levels
        types = self.terrain_types
        tile = levels * origins.shape[1] + types
        for value in tile.unique():
            ids = (tile == value).nonzero().flatten()
            k = torch.arange(len(ids), device=self.device)
            # The existing 80 tiles are shared by up to ~300 isolated envs.
            # Spread each tile's roots over its interior instead of coinciding.
            result[ids, 0] += -.95 + (k % 9) * .3
            result[ids, 1] += -3.5 + torch.div(k, 9, rounding_mode='floor') * .21
        starts = result.clone(); starts[:, 2] += 3.
        directions = torch.zeros_like(starts); directions[:, 2] = -1.
        mesh = convert_to_warp_mesh(self._v41_mesh.vertices, self._v41_mesh.faces, self.device)
        hit = raycast_mesh(starts, directions, mesh, max_dist=6.)[0]
        assert torch.isfinite(hit).all()
        result[:, 2] = hit[:, 2]
        self._v41_origin_unique = int(torch.unique(result[:, :2], dim=0).shape[0])
        assert self._v41_origin_unique == num_envs
        return result

    TerrainImporter.import_mesh = retain_mesh
    TerrainImporter._compute_env_origins_curriculum = spread_origins


def install():
    guard = sys.modules['mod4v1_fresh_dr_guard']
    previous = guard.configure_new_task

    def configure(cfg, identity):
        result = previous(cfg, identity)
        install_origins()
        cfg.sim.physics.gpu_total_aggregate_pairs_capacity = TOTAL_PAIRS
        cfg.sim.physics.gpu_found_lost_aggregate_pairs_capacity = FOUND_LOST_AGGREGATE_PAIRS
        cfg.sim.physics.gpu_found_lost_pairs_capacity = FOUND_LOST_PAIRS
        # In this SDK the generator assigns several isolated environments to
        # each tile. Keep the existing environment collision filtering enabled.
        assert cfg.scene.filter_collisions
        assert cfg.sim.dt == .0025 and cfg.decimation == 8
        assert cfg.sim.physics.solver_type == 1
        return result

    guard.configure_new_task = configure
    # The nominal main function captured the earlier loader in its own globals.
    # That loader resolves a symlink before comparing the task path, falls back
    # to re-executing the raw guard, and discards both the finite USD binding
    # and these buffer settings. Bind the already adapted task guard directly.
    import mod4v1_scut.train as train
    train.load_guard = lambda path: guard
    train.main.__globals__['load_guard'] = train.load_guard
    return dict(total_aggregate_pairs=TOTAL_PAIRS,
                found_lost_aggregate_pairs=FOUND_LOST_AGGREGATE_PAIRS,
                found_lost_pairs=FOUND_LOST_PAIRS,
                terrain_origins='spread within existing tile interior, raycast height',
                solver='TGS32/4', dt_s=.0025, reward_changes=False)


def mesh_data(env):
    import numpy as np
    from pxr import Usd, UsdGeom
    from isaaclab.sim import get_current_stage
    stage = get_current_stage()
    roots = env.scene['terrain'].terrain_prim_paths
    meshes = []
    vertices, faces, offset = [], [], 0
    for root in roots:
        prim = stage.GetPrimAtPath(root)
        for child in Usd.PrimRange(prim):
            if not child.IsA(UsdGeom.Mesh):
                continue
            mesh = UsdGeom.Mesh(child)
            points = mesh.GetPointsAttr().Get()
            counts = mesh.GetFaceVertexCountsAttr().Get()
            indices = mesh.GetFaceVertexIndicesAttr().Get()
            if points is None or indices is None:
                continue
            assert np.all(np.asarray(counts) == 3)
            world = UsdGeom.XformCache().GetLocalToWorldTransform(child)
            v = np.asarray([world.Transform(p) for p in points], dtype=np.float32)
            f = np.asarray(indices, dtype=np.int32).reshape(-1, 3)
            vertices.append(v); faces.append(f + offset); offset += len(v)
            meshes.append(str(child.GetPath()))
    assert meshes, roots
    return dict(vertices=np.concatenate(vertices), faces=np.concatenate(faces)), meshes


def readback(env):
    import math
    import torch
    from pxr import UsdPhysics
    from isaaclab.sim import get_current_stage
    stage = get_current_stage()
    rows = []
    for side in ('left', 'right'):
        for name in ('hip', 'crank', 'drive_hip_spin', 'drive_input_spin'):
            joint = UsdPhysics.RevoluteJoint(stage.GetPrimAtPath('/World/envs/env_0/Robot/joints/'+side+'_'+name))
            def number(value):
                return value if value is None or math.isfinite(value) else str(value)
            rows.append(dict(name=side+'_'+name, lower_deg=number(joint.GetLowerLimitAttr().Get()), upper_deg=number(joint.GetUpperLimitAttr().Get())))
    robot = env.scene['robot']
    limits = robot.root_view.get_dof_limits()
    if not isinstance(limits, torch.Tensor):
        import warp as wp
        limits = wp.to_torch(limits)
    named = {name: [number(v) for v in limits[0, i].detach().cpu().tolist()] for i, name in enumerate(robot.joint_names)
             if any(t in name for t in ('drive_hip', 'drive_input', 'crank', 'hip'))}
    return dict(spawn_usd=env.cfg.scene.robot.spawn.usd_path, composed_limits=rows,
                backend_limits_rad=named, collision_filter=env.cfg.scene.filter_collisions,
                global_collision_paths=env.scene._global_prim_paths,
                unique_xy_origins=env.scene['terrain']._v41_origin_unique,
                found_lost_pairs=env.cfg.sim.physics.gpu_found_lost_pairs_capacity,
                total_pairs=env.cfg.sim.physics.gpu_total_aggregate_pairs_capacity,
                found_lost_aggregate_pairs=env.cfg.sim.physics.gpu_found_lost_aggregate_pairs_capacity)
