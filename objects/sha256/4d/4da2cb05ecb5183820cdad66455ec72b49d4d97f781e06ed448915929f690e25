    print('=== ' + tag + ' ===', flush=True)
    p = subprocess.run([PY] + args, cwd=cwd, capture_output=True, text=True,
                       encoding='utf-8', errors='replace', env=ENV)
    out = (p.stdout or ) + (p.stderr or )
    keep = [l for l in out.splitlines() if KEEP.search(l)]
    for l in (keep or out.splitlines())[-tail:]:
        print('   ' + l[:170], flush=True)
    print('   rc=%d' % p.returncode, flush=True)
    return p.returncode


