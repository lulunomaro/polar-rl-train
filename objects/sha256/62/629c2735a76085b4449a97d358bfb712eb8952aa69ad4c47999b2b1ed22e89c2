function build_wbr_linearizer(referenceDirectory, outputDirectory)
% MIT upstream: Particlela/WBR_simulation, commit 83414c0b...
% Never add upstream function/ to the path: its lqr.m shadows MATLAB lqr.
if ~isfolder(outputDirectory), mkdir(outputDirectory); end
referenceEquation = fullfile(referenceDirectory, 'function', 'equation.m');
% Add reflected motor kinetic energy in relative joint coordinates. Simply
% adding armature to an absolute wheel/leg inertia misses cross coupling.
sourceText=fileread(referenceEquation);
insertion=sprintf(['syms J_h_l J_h_r J_w_l J_w_r real;\n' ...
    'eq3 = lhs(eq3)+J_w_l*(ddtheta_w_l-ddtheta_l_l) == rhs(eq3);\n' ...
    'eq4 = lhs(eq4)+J_w_r*(ddtheta_w_r-ddtheta_l_r) == rhs(eq4);\n' ...
    'eq9 = lhs(eq9)+J_h_l*(ddtheta_l_l-ddtheta_b)+J_w_l*(ddtheta_l_l-ddtheta_w_l) == rhs(eq9);\n' ...
    'eq10 = lhs(eq10)+J_h_r*(ddtheta_l_r-ddtheta_b)+J_w_r*(ddtheta_l_r-ddtheta_w_r) == rhs(eq10);\n' ...
    'eq13 = lhs(eq13)+J_h_l*(ddtheta_b-ddtheta_l_l)+J_h_r*(ddtheta_b-ddtheta_l_r) == rhs(eq13);\n\n' ...
    'elim_vars = [']);
assert(contains(sourceText,'elim_vars = ['),'Upstream equation structure changed.');
adaptedText=strrep(sourceText,'elim_vars = [',insertion);
adaptedEquation=fullfile(outputDirectory,'equation_mod4_armature.m');
fid=fopen(adaptedEquation,'w','n','UTF-8');
fprintf(fid,'%% Adapted from Particlela/WBR_simulation, MIT; see UPSTREAM_LICENSE.txt.\n%% Adds rotor-reflected kinetic energy in relative coordinates.\n%s',adaptedText);fclose(fid);
run(adaptedEquation);
sym_vars = [g, R_w, R_l, l_l, l_r, l_w_l, l_w_r, l_b_l, l_b_r, l_c, phi_c, ...
    m_w, m_l_l, m_l_r, m_b, I_w, I_l_l, I_l_r, I_b, I_zz,J_h_l,J_h_r,J_w_l,J_w_r];
T_acc_sym = jacobian([dd_s; ddphi; ddtheta_l_l; ddtheta_l_r; ddtheta_b], ddTheta);
T_acc_eq = subs(T_acc_sym, [theta_l_l, theta_l_r, dtheta_l_l, dtheta_l_r], [0,0,0,0]);
matlabFunction(A_orig, B_u, B_x, B_offset, T_acc_eq, ...
    'Vars', {sym_vars}, 'File', fullfile(outputDirectory, 'wbr_linear_matrices'), 'Optimize', true);
end
