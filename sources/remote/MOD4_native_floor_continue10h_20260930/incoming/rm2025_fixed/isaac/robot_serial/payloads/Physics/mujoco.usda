        def MjcActuator "left_hip_motor"
        {
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:max = 40
            uniform double mjc:ctrlRange:min = -40
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 40
            uniform double mjc:forceRange:min = -40
            custom rel mjc:target
            prepend rel mjc:target = </rm2025_fixed_closed_hifi/Geometry/chassis/left_thigh/left_hip>
        }

        def MjcActuator "left_wheel_spin_motor"
        {
