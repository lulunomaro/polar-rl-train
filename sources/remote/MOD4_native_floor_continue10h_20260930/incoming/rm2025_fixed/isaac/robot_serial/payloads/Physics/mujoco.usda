            uniform double mjc:forceRange:max = 40
            uniform double mjc:forceRange:min = -40
            custom rel mjc:target
            prepend rel mjc:target = </rm2025_fixed_closed_hifi/Geometry/chassis/right_thigh/right_shin/right_knee>
        }
    }

