    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "rm2025_fixed_closed_hifi"
{
    over "Geometry"
    {
        over "chassis"
        {
            over "left_thigh"
            {
                over "left_shin"
                {
                    over "left_wheel" (
                        prepend apiSchemas = ["PhysxRigidBodyAPI", "PhysxContactReportAPI"]
                    )
                    {
                        float physxContactReport:threshold = 0
                        float physxRigidBody:sleepThreshold = 0

                        over "left_wheel_spin" (
                            prepend apiSchemas = ["PhysxJointAPI"]
                        )
                        {
                            float physxJoint:jointFriction = 0.01
                        }
                    }

                    over "left_knee" (
                        prepend apiSchemas = ["PhysxJointAPI"]
                    )
                    {
                        float physxJoint:armature = 0.025
                        float physxJoint:jointFriction = 0.06
                    }
                }

                over "left_hip" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                    float physxJoint:armature = 0.025
                    float physxJoint:jointFriction = 0.06
                }
            }

            over "right_thigh"
            {
                over "right_shin"
                {
                    over "right_wheel" (
                        prepend apiSchemas = ["PhysxRigidBodyAPI", "PhysxContactReportAPI"]
                    )
                    {
                        float physxContactReport:threshold = 0
                        float physxRigidBody:sleepThreshold = 0

                        over "right_wheel_spin" (
                            prepend apiSchemas = ["PhysxJointAPI"]
                        )
                        {
                            float physxJoint:jointFriction = 0.01
                        }
                    }

                    over "right_knee" (
                        prepend apiSchemas = ["PhysxJointAPI"]
                    )
                    {
                        float physxJoint:armature = 0.025
                        float physxJoint:jointFriction = 0.06
                    }
                }

                over "right_hip" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                    float physxJoint:armature = 0.025
                    float physxJoint:jointFriction = 0.06
                }
            }
        }
    }
}
