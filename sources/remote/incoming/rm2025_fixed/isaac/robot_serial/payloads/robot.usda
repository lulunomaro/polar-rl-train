#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "rm2025_fixed_closed_hifi"
    doc = """Generated from Composed Stage of root layer C:\\Users\\LULUNO~1\\AppData\\Local\\Temp\\tmp87sdd8dw\\rm2025_fixed_closed_hifi.usdc


Generated from Composed Stage of root layer C:\\Users\\LULUNO~1\\AppData\\Local\\Temp\\mjcf_import_robot_serial_knopa9fc\\usdex_robot_serial\\rm2025_fixed_closed_hifi.usdc


