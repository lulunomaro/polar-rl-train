"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "rm2025_fixed_closed_hifi" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Geometry"
    {
        over "chassis" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "left_thigh" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "left_hip" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }

                over "left_shin" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "left_knee" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }

                    over "left_wheel" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "left_wheel_spin" (
                            prepend apiSchemas = ["IsaacJointAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "right_thigh" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "right_hip" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }

                over "right_shin" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "right_knee" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }

                    over "right_wheel" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "right_wheel_spin" (
                            prepend apiSchemas = ["IsaacJointAPI"]
                        )
                        {
                        }
                    }
                }
            }
        }
    }
}

