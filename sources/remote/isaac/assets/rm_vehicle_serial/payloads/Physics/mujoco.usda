        over "PhysicsMaterial" (
            prepend apiSchemas = ["MjcMaterialAPI"]
        )
        {
            uniform double mjc:rollingfriction = 0.001
            uniform double mjc:torsionalfriction = 0.01
        }

        def MjcActuator "left_rear1_ctrl"
        {
            uniform double mjc:ctrlRange:max = 40
            uniform double mjc:ctrlRange:min = -40
            uniform double mjc:forceRange:max = 40
            uniform double mjc:forceRange:min = -40
            custom rel mjc:target
            prepend rel mjc:target = </rm_vehicle_cc/Geometry/base_link/left_rear1/left_rear1_joint>
        }

        def MjcActuator "left_wheel_ctrl"
