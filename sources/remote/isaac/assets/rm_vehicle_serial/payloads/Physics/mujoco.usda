                        uniform int mjc:group = 3
                    }

                    over "left_wheel"
                    {
                        over "left_wheel_col" (
                            prepend apiSchemas = ["MjcCollisionAPI"]
                        )
                        {
                            uniform int mjc:condim = 6
                            uniform int mjc:group = 3
                            uniform int mjc:priority = 1
                        }

                        over "left_wheel_joint" (
                            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                            prepend apiSchemas = ["MjcJointAPI"]
                        )
                        {
                            uniform double mjc:armature = 0.001
                            uniform double mjc:frictionloss = 0.023
                        }

                        over "wheel_l"
                        {
                        }
                    }

                    over "left_rear2_joint" (
                        delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                        prepend apiSchemas = ["MjcJointAPI"]
                    )
                    {
                        uniform double mjc:armature = 0.0158
                        uniform double mjc:frictionloss = 1.5
                    }

                    over "rear2_l"
                    {
                    }
                }

