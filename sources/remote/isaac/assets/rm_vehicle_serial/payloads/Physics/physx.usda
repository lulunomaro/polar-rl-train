                        }
                    }

                    over "left_rear2_joint" (
                        prepend apiSchemas = ["PhysxJointAPI"]
                    )
                    {
                        float physxJoint:armature = 0.0158
                        float physxJoint:jointFriction = 1.5
                    }
                }

                over "left_rear1_joint" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                    float physxJoint:armature = 0.0158
                }
            }

            over "right_rear1"
            {
                over "right_rear2"
                {
                    over "right_wheel"
                    {
                        over "right_wheel_joint" (
                            prepend apiSchemas = ["PhysxJointAPI"]
                        )
                        {
                            float physxJoint:armature = 0.001
                            float physxJoint:jointFriction = 0.023
                        }
                    }

                    over "right_rear2_joint" (
                        prepend apiSchemas = ["PhysxJointAPI"]
                    )
                    {
                        float physxJoint:armature = 0.0158
                        float physxJoint:jointFriction = 1.5
                    }
                }

                over "right_rear1_joint" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                    float physxJoint:armature = 0.0158
                }
            }
        }
    }
}

