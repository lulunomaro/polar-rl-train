#usda 1.0
(
    defaultPrim = "Robot"
    subLayers = [@source_700N/robot.usd@] 
)
over "Robot"
{
    over "joints"
    {
        over "left_gas_slide"
        {
            float drive:linear:physics:stiffness = 2000
            float physics:upperLimit = 0.020639440248416612
        }
        over "right_gas_slide"
        {
            float drive:linear:physics:stiffness = 2000
            float physics:upperLimit = 0.020639440248416612
        }
    }
}
